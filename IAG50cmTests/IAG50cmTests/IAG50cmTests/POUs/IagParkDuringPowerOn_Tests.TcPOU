<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="IagParkDuringPowerOn_Tests" Id="{a4314ecb-706f-4940-94b1-4f69975d0378}" SpecialFunc="None">
    <Declaration><![CDATA[// Characterization of FB_TelescopeControl (IAG50cm) for a park or a stop that arrives during the power-on, on mock axes (plan step 2,
// IAG50cmTests README). These tests pin what the code does today, with the line of the behaviour in a comment; they are not a
// specification. Every test owns a rig and runs over many PLC cycles (VAR_INST of the method, one Scan() per cycle). Failed checks
// are also noted in GVL_Diag.sFailures (printed by Run-Tests.ps1).
FUNCTION_BLOCK IagParkDuringPowerOn_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Park_During_PowerOn_Aborts_The_Startup_And_Parks();
Stop_During_PowerOn_Aborts_The_Startup();
AxesOff_Park_After_Stopped_Startup_Reports_Parked();
AxesOff_Park_With_Slow_Covers_Reports_Parking_Then_Parked();
AxesOff_Park_Gives_Up_When_The_Covers_Do_Not_Close();
]]></ST>
    </Implementation>
    <Method Name="Park_During_PowerOn_Aborts_The_Startup_And_Parks" Id="{fee3a10b-b0ce-4b59-b6ed-58da01277209}">
      <Declaration><![CDATA[// I:529-541 (IAG50cm#109): a park that arrives while the power-on runs outranks it, like a stop: the startup is aborted, the
// covers the power-on opened are closed again and the telescope ends parked, never ready (READY_STATE does not reach 1.0).
// In the covers phase the axes are still off, so the park takes the axes-off path (#54, #110): covers closed, dome parked,
// the mount is not moved, READY_STATE 0.0 and bIsParked is TRUE with bParkedInPlace (#187). Decision 3 of the plan: as MONET (MONETcommon#87).
METHOD PRIVATE Park_During_PowerOn_Aborts_The_Startup_And_Parks
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Park_During_PowerOn_Aborts_The_Startup_And_Parks');
sTest := 'Park_During_PowerOn_Aborts_The_Startup_And_Parks: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// the power-on has commanded the covers: park now
	IF rig.fbCovers.nOpenCalls >= 1 THEN
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the power-on never commanded the covers');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the power-on never commanded the covers'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the power-on is aborted at once, the covers are commanded closed
	IF nCycles = 3 THEN
		AssertTrue(Condition := NOT rig.fbTel.bPower, Message := 'the power-on is aborted');
		F_Note(bFailed := (rig.fbTel.bPower), sText := CONCAT(sTest, 'the power-on is aborted'));
		nStep := 30;
		nCycles := 0;
	END_IF
30:	// the park finishes (READY_STATE 0.0, the axes were off: bIsParked TRUE with bParkedInPlace, #187), the startup never does
	AssertFalse(Condition := rig.Online, Message := 'the startup went on to the end');
	F_Note(bFailed := (rig.Online), sText := CONCAT(sTest, 'the startup went on to the end'));
	IF rig.fbTel.ReadyState = 0.0 THEN
		AssertTrue(Condition := rig.fbCovers.nCloseCalls >= 1, Message := 'the covers were closed');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls >= 1), sText := CONCAT(sTest, 'the covers were closed'));
		AssertTrue(Condition := rig.fbTel.bIsParked, Message := 'bIsParked is TRUE (#187)');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked), sText := CONCAT(sTest, 'bIsParked is TRUE (#187)'));
		AssertTrue(Condition := rig.fbTel.bParkedInPlace, Message := 'bParkedInPlace is TRUE, the mount was not moved');
		F_Note(bFailed := NOT (rig.fbTel.bParkedInPlace), sText := CONCAT(sTest, 'bParkedInPlace is TRUE, the mount was not moved'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the telescope did not park');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the telescope did not park'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_During_PowerOn_Aborts_The_Startup" Id="{0dd3dce0-cbdf-4285-b7f6-82b17aaa459f}">
      <Declaration><![CDATA[// I:501-526 (#27): an explicit stop outranks the power-on: the startup is aborted (READY_STATE -2.0), nothing is parked and the
// covers the power-on opened stay open.
METHOD PRIVATE Stop_During_PowerOn_Aborts_The_Startup
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_During_PowerOn_Aborts_The_Startup');
sTest := 'Stop_During_PowerOn_Aborts_The_Startup: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// the power-on has commanded the covers: stop now
	IF rig.fbCovers.nOpenCalls >= 1 THEN
		rig.fbTel.Stop();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the power-on never commanded the covers');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the power-on never commanded the covers'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// wait until the stop has settled
	IF NOT rig.fbTel.bStop AND rig.fbTel.bStopped AND nCycles > 5 THEN
		AssertFalse(Condition := rig.fbTel.bPower, Message := 'the power-on request is dropped');
		F_Note(bFailed := (rig.fbTel.bPower), sText := CONCAT(sTest, 'the power-on request is dropped'));
		AssertFalse(Condition := rig.fbTel.bPark OR rig.fbTel.bIsParked, Message := 'the stop does not park');
		F_Note(bFailed := (rig.fbTel.bPark OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'the stop does not park'));
		AssertTrue(Condition := rig.fbTel.ReadyState = -2.0, Message := 'READY_STATE is -2.0 (startup aborted)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -2.0), sText := CONCAT(sTest, 'READY_STATE is -2.0 (startup aborted)'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0 AND rig.fbCovers.bOpened, Message := 'the covers stay open');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0 AND rig.fbCovers.bOpened), sText := CONCAT(sTest, 'the covers stay open'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="AxesOff_Park_After_Stopped_Startup_Reports_Parked" Id="{5b0e2d41-7c3a-4f58-9e16-2a8d4c7b1f03}">
      <Declaration><![CDATA[// IAG50cm#110: after a stopped startup (-2) a park with the axes off closes the covers and parks the dome, the mount is not moved.
// READY_STATE leaves -2 for 0.0 and bIsParked becomes TRUE with bParkedInPlace (#187); a new power-on clears both.
METHOD PRIVATE AxesOff_Park_After_Stopped_Startup_Reports_Parked
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('AxesOff_Park_After_Stopped_Startup_Reports_Parked');
sTest := 'AxesOff_Park_After_Stopped_Startup_Reports_Parked: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// the power-on has commanded the covers: stop now
	IF rig.fbCovers.nOpenCalls >= 1 THEN
		rig.fbTel.Stop();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the power-on never commanded the covers');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the power-on never commanded the covers'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the stop has settled: -2, then park with the axes off
	IF NOT rig.fbTel.bStop AND rig.fbTel.bStopped AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = -2.0, Message := 'READY_STATE is -2.0 after the stop');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = -2.0), sText := CONCAT(sTest, 'READY_STATE is -2.0 after the stop'));
		rig.fbTel.Park();
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the covers close, READY_STATE becomes 0.0, bIsParked is TRUE (#187)
	IF rig.fbTel.ReadyState = 0.0 THEN
		AssertTrue(Condition := rig.fbCovers.nCloseCalls >= 1, Message := 'the covers were closed');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls >= 1), sText := CONCAT(sTest, 'the covers were closed'));
		AssertTrue(Condition := rig.fbTel.bIsParked, Message := 'bIsParked is TRUE (#187)');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked), sText := CONCAT(sTest, 'bIsParked is TRUE (#187)'));
		AssertTrue(Condition := rig.fbTel.bParkedInPlace, Message := 'bParkedInPlace is TRUE, the mount was not moved');
		F_Note(bFailed := NOT (rig.fbTel.bParkedInPlace), sText := CONCAT(sTest, 'bParkedInPlace is TRUE, the mount was not moved'));
		rig.fbTel.Init();
		nStep := 40;
		nCycles := 0;
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'READY_STATE did not reach 0.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'READY_STATE did not reach 0.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
40:	// a new power-on ends the covered state
	IF rig.fbTel.ReadyState > 0.0 THEN
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the new power-on did not leave READY_STATE 0.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the new power-on did not leave READY_STATE 0.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="AxesOff_Park_With_Slow_Covers_Reports_Parking_Then_Parked" Id="{b1d35baf-a958-419b-b709-58e8e2008f12}">
      <Declaration><![CDATA[// IAG50cm#187: an axes-off park whose covers close slowly reports READY_STATE 0.3 and bIsParked FALSE while they are open, and
// parked in place (READY_STATE 0.0, bIsParked and bParkedInPlace TRUE) once they are closed. The covers mock holds the close.
METHOD PRIVATE AxesOff_Park_With_Slow_Covers_Reports_Parking_Then_Parked
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('AxesOff_Park_With_Slow_Covers_Reports_Parking_Then_Parked');
sTest := 'AxesOff_Park_With_Slow_Covers_Reports_Parking_Then_Parked: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// the power-on has commanded the covers: stop now
	IF rig.fbCovers.nOpenCalls >= 1 THEN
		rig.fbTel.Stop();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the power-on never commanded the covers');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the power-on never commanded the covers'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the stop has settled: the covers now close slowly, park with the axes off
	IF NOT rig.fbTel.bStop AND rig.fbTel.bStopped AND nCycles > 5 THEN
		rig.fbCovers.HoldClose(bHold := TRUE);
		rig.fbTel.Park();
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the covers were commanded but are not closed: 0.3 (parking), not parked, not 0 and not -2
	IF rig.fbCovers.nCloseCalls >= 1 AND nCycles > 20 THEN
		AssertTrue(Condition := rig.fbTel.ReadyState = 0.3, Message := 'READY_STATE is 0.3 while the covers close (#187)');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = 0.3), sText := CONCAT(sTest, 'READY_STATE is 0.3 while the covers close (#187)'));
		AssertTrue(Condition := NOT rig.fbTel.bIsParked, Message := 'bIsParked stays FALSE until the covers are closed');
		F_Note(bFailed := NOT (NOT rig.fbTel.bIsParked), sText := CONCAT(sTest, 'bIsParked stays FALSE until the covers are closed'));
		AssertTrue(Condition := rig.fbTel.bSafeParked, Message := 'the axes-off park is pending');
		F_Note(bFailed := NOT (rig.fbTel.bSafeParked), sText := CONCAT(sTest, 'the axes-off park is pending'));
		rig.fbCovers.FinishClose();
		nStep := 40;
		nCycles := 0;
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the covers were never commanded to close');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the covers were never commanded to close'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
40:	// the covers closed: parked in place
	IF rig.fbTel.ReadyState = 0.0 THEN
		AssertTrue(Condition := rig.fbTel.bIsParked, Message := 'bIsParked is TRUE once the covers are closed (#187)');
		F_Note(bFailed := NOT (rig.fbTel.bIsParked), sText := CONCAT(sTest, 'bIsParked is TRUE once the covers are closed (#187)'));
		AssertTrue(Condition := rig.fbTel.bParkedInPlace, Message := 'bParkedInPlace is TRUE, the mount was not moved');
		F_Note(bFailed := NOT (rig.fbTel.bParkedInPlace), sText := CONCAT(sTest, 'bParkedInPlace is TRUE, the mount was not moved'));
		AssertTrue(Condition := NOT rig.fbTel.bSafeParked, Message := 'the axes-off park is finished');
		F_Note(bFailed := NOT (NOT rig.fbTel.bSafeParked), sText := CONCAT(sTest, 'the axes-off park is finished'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'READY_STATE did not reach 0.0 after the covers closed');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'READY_STATE did not reach 0.0 after the covers closed'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="AxesOff_Park_Gives_Up_When_The_Covers_Do_Not_Close" Id="{cb5f365d-663e-4823-811b-5c063f8334e9}">
      <Declaration><![CDATA[// IAG50cm#187: an axes-off park whose covers never close gives up after 120 s (the time seam divides by 1000): bSafeParked is dropped,
// READY_STATE is not 0.3 for ever and the telescope is never reported parked.
METHOD PRIVATE AxesOff_Park_Gives_Up_When_The_Covers_Do_Not_Close
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('AxesOff_Park_Gives_Up_When_The_Covers_Do_Not_Close');
sTest := 'AxesOff_Park_Gives_Up_When_The_Covers_Do_Not_Close: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// the power-on has commanded the covers: stop now
	IF rig.fbCovers.nOpenCalls >= 1 THEN
		rig.fbTel.Stop();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the power-on never commanded the covers');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the power-on never commanded the covers'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the stop has settled: the covers never close, park with the axes off; 120 s are 0.12 s
	IF NOT rig.fbTel.bStop AND rig.fbTel.bStopped AND nCycles > 5 THEN
		rig.fbCovers.HoldClose(bHold := TRUE);
		rig.SetTimeDivisor(nValue := 1000);
		rig.fbTel.Park();
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// after the give-up the park is no longer pending: not 0.3 for ever, and never reported parked
	IF NOT rig.fbTel.bSafeParked AND nCycles > 5 THEN
		rig.SetTimeDivisor(nValue := 1);
		AssertTrue(Condition := NOT rig.fbTel.bIsParked, Message := 'bIsParked stays FALSE, the covers did not close (#187)');
		F_Note(bFailed := NOT (NOT rig.fbTel.bIsParked), sText := CONCAT(sTest, 'bIsParked stays FALSE, the covers did not close (#187)'));
		AssertTrue(Condition := NOT rig.fbTel.bParkedInPlace, Message := 'bParkedInPlace stays FALSE');
		F_Note(bFailed := NOT (NOT rig.fbTel.bParkedInPlace), sText := CONCAT(sTest, 'bParkedInPlace stays FALSE'));
		AssertTrue(Condition := rig.fbTel.ReadyState <> 0.3, Message := 'READY_STATE leaves 0.3 after the give-up');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState <> 0.3), sText := CONCAT(sTest, 'READY_STATE leaves 0.3 after the give-up'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the axes-off park never gave up');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the axes-off park never gave up'));
		rig.SetTimeDivisor(nValue := 1);
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
