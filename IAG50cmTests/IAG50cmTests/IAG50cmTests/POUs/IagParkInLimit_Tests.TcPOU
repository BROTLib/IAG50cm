<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="IagParkInLimit_Tests" Id="{1dc6254a-1b32-41f8-b1f3-e0cead99ccb6}" SpecialFunc="None">
    <Declaration><![CDATA[// IAG50cm#84: a park requested while the mount stands inside the horizon limit homes out of the limit first and then parks
// (it used to starve against the safety block's automatic home). The mount is put in the limit by raising fHorizon above its
// elevation; the mock rig does not interpolate, so this tests the arbitration, not the real path altitude.
// Failed checks are also noted in GVL_Diag.sFailures (printed by Run-Tests.ps1).
FUNCTION_BLOCK IagParkInLimit_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Park_Stopped_In_Limit_Homes_Then_Parks();
User_Stop_Cancels_The_Park_Waiting_For_The_Home();
]]></ST>
    </Implementation>
    <Method Name="Park_Stopped_In_Limit_Homes_Then_Parks" Id="{ad805155-10b7-409a-8018-d3a51d5bc719}">
      <Declaration><![CDATA[// I:FB_TelescopeControl safety blocks, park branch (#84): home, then park; no stop, the covers close at the park.
METHOD PRIVATE Park_Stopped_In_Limit_Homes_Then_Parks
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	nStopsHa	: UINT;
	nStopsDec	: UINT;
	bHomeSeen	: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Park_Stopped_In_Limit_Homes_Then_Parks');
sTest := 'Park_Stopped_In_Limit_Homes_Then_Parks: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished, then slew to 45 deg elevation
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:	// wait until the slew is done and the mount stands still
	IF NOT rig.fbTel.bSlew AND rig.fbTel.bStopped AND nCycles > 5 THEN
		nStopsHa := rig.fbHa.nStopEdges;
		nStopsDec := rig.fbDec.nStopEdges;
		// the mount now stands at 45 deg: raise the horizon limit above it and park (#84)
		rig.SetHorizon(fValue := 60.0);
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the home out of the limit runs first, the park follows
	bHomeSeen := bHomeSeen OR (rig.fbTel.bGoHome AND rig.fbTel.bPark);
	IF rig.fbTel.bIsParked AND NOT rig.fbTel.bPark THEN
		AssertTrue(Condition := bHomeSeen, Message := 'the home ran while the park was pending');
		F_Note(bFailed := NOT (bHomeSeen), sText := CONCAT(sTest, 'the home ran while the park was pending'));
		AssertTrue(Condition := rig.fbHa.nStopEdges = nStopsHa AND rig.fbDec.nStopEdges = nStopsDec, Message := 'no stop was sent to the axes');
		F_Note(bFailed := NOT (rig.fbHa.nStopEdges = nStopsHa AND rig.fbDec.nStopEdges = nStopsDec), sText := CONCAT(sTest, 'no stop was sent to the axes'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls >= 1, Message := 'the covers were closed');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls >= 1), sText := CONCAT(sTest, 'the covers were closed'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 2500 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not complete');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not complete'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="User_Stop_Cancels_The_Park_Waiting_For_The_Home" Id="{b1a2ded9-b904-4854-8770-76784227de87}">
      <Declaration><![CDATA[// #84: a user stop drops the pending park and its home; the park is not replayed.
METHOD PRIVATE User_Stop_Cancels_The_Park_Waiting_For_The_Home
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	nStopsHa	: UINT;
	nStopsDec	: UINT;
	bHomeSeen	: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('User_Stop_Cancels_The_Park_Waiting_For_The_Home');
sTest := 'User_Stop_Cancels_The_Park_Waiting_For_The_Home: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished, then slew to 45 deg elevation
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:	// wait until the slew is done and the mount stands still
	IF NOT rig.fbTel.bSlew AND rig.fbTel.bStopped AND nCycles > 5 THEN
		nStopsHa := rig.fbHa.nStopEdges;
		nStopsDec := rig.fbDec.nStopEdges;
		// the mount now stands at 45 deg: raise the horizon limit above it and park (#84)
		rig.SetHorizon(fValue := 60.0);
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the park waits for the home: stop
	IF rig.fbTel.bPark AND rig.fbTel.bGoHome AND nCycles >= 3 THEN
		rig.fbTel.Stop();
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the park never waited for the home');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park never waited for the home'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// the stop drops the park and the home; the park does not come back
	IF nCycles = 5 THEN
		AssertTrue(Condition := NOT rig.fbTel.bPark, Message := 'the stop cancelled the park');
		F_Note(bFailed := NOT (NOT rig.fbTel.bPark), sText := CONCAT(sTest, 'the stop cancelled the park'));
	END_IF
	IF nCycles > 400 THEN
		AssertTrue(Condition := NOT rig.fbTel.bPark AND NOT rig.fbTel.bIsParked, Message := 'the park did not replay after the stop');
		F_Note(bFailed := NOT (NOT rig.fbTel.bPark AND NOT rig.fbTel.bIsParked), sText := CONCAT(sTest, 'the park did not replay after the stop'));
		AssertTrue(Condition := rig.fbCovers.nCloseCalls = 0, Message := 'the covers stay open');
		F_Note(bFailed := NOT (rig.fbCovers.nCloseCalls = 0), sText := CONCAT(sTest, 'the covers stay open'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
