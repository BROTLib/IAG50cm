<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="IagResetUnderMotion_Tests" Id="{1fc60289-53e4-42b0-945d-081a37849ba4}" SpecialFunc="None">
    <Declaration><![CDATA[// Characterization of FB_TelescopeControl (IAG50cm) for a reset without and with an axis error, on mock axes (plan step 2,
// IAG50cmTests README). These tests pin what the code does today, with the line of the behaviour in a comment; they are not a
// specification. Every test owns a rig and runs over many PLC cycles (VAR_INST of the method, one Scan() per cycle). Failed checks
// are also noted in GVL_Diag.sFailures (printed by Run-Tests.ps1).
FUNCTION_BLOCK IagResetUnderMotion_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Reset_Without_An_Error_Is_Ignored();
Reset_With_An_Error_Resets_The_Errored_Axis_And_Later_All_Axes();
]]></ST>
    </Implementation>
    <Method Name="Reset_Without_An_Error_Is_Ignored" Id="{bde6f57d-4f0e-4e28-9ef8-a287257843bd}">
      <Declaration><![CDATA[// I:205: the reset trigger needs an error or a pending safety acknowledge: a reset during a slew without one does nothing, the slew
// goes on, no axis is reset or stopped and no safety acknowledge is requested. (MONET resets the startup and stops the axes.)
METHOD PRIVATE Reset_Without_An_Error_Is_Ignored
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Reset_Without_An_Error_Is_Ignored');
sTest := 'Reset_Without_An_Error_Is_Ignored: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: slew
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// one axis is moving (the slew moves HA and Dec one after the other)
	IF rig.fbHa.MoveAxis OR rig.fbDec.MoveAxis THEN
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start an axis move');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start an axis move'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// let the move run for a few scans, then reset
	IF nCycles >= 5 THEN
		rig.fbTel.Reset();
		nStep := 40;
		nCycles := 0;
	END_IF
40:
	IF nCycles >= 10 THEN
		AssertTrue(Condition := rig.fbTel.bSlew, Message := 'the slew goes on');
		F_Note(bFailed := NOT (rig.fbTel.bSlew), sText := CONCAT(sTest, 'the slew goes on'));
		AssertTrue(Condition := rig.fbHa.nResetEdges = 0 AND rig.fbDec.nResetEdges = 0, Message := 'no axis was reset');
		F_Note(bFailed := NOT (rig.fbHa.nResetEdges = 0 AND rig.fbDec.nResetEdges = 0), sText := CONCAT(sTest, 'no axis was reset'));
		AssertTrue(Condition := rig.fbHa.nStopEdges = 0 AND rig.fbDec.nStopEdges = 0, Message := 'no axis was stopped');
		F_Note(bFailed := NOT (rig.fbHa.nStopEdges = 0 AND rig.fbDec.nStopEdges = 0), sText := CONCAT(sTest, 'no axis was stopped'));
		AssertFalse(Condition := rig.fbTel.bSafetyAckRequest, Message := 'no safety acknowledge is requested');
		F_Note(bFailed := (rig.fbTel.bSafetyAckRequest), sText := CONCAT(sTest, 'no safety acknowledge is requested'));
		AssertTrue(Condition := rig.fbTel.ReadyState = 1.0, Message := 'the telescope stays online');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState = 1.0), sText := CONCAT(sTest, 'the telescope stays online'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset_With_An_Error_Resets_The_Errored_Axis_And_Later_All_Axes" Id="{8c8515b5-6a2c-4f0e-9d59-592e62e8c555}">
      <Declaration><![CDATA[// I:266-275, 1407 (#11, #55, #103): a reset with an error resets the axis that has the error and requests the safety acknowledge;
// 2.5 s later (bAxisResetAfterAck) a second pass resets every axis that is errored or not enabled. The error disabled both axes, so
// the second pass resets the errored one again and the other one for the first time.
METHOD PRIVATE Reset_With_An_Error_Resets_The_Errored_Axis_And_Later_All_Axes
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Reset_With_An_Error_Resets_The_Errored_Axis_And_Later_All_Axes');
sTest := 'Reset_With_An_Error_Resets_The_Errored_Axis_And_Later_All_Axes: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// online: the hour angle reports an error
	IF rig.Online THEN
		rig.InjectHaError(16#4550);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the error is there
	IF rig.fbTel.bError THEN
		rig.fbTel.Reset();
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 60 THEN
		AssertTrue(Condition := FALSE, Message := 'the error was not reported');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the error was not reported'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// first pass
	IF nCycles = 5 THEN
		AssertFalse(Condition := rig.fbTel.bError, Message := 'the reset cleared the error');
		F_Note(bFailed := (rig.fbTel.bError), sText := CONCAT(sTest, 'the reset cleared the error'));
		AssertTrue(Condition := rig.fbHa.nResetEdges = 1 AND rig.fbDec.nResetEdges = 0, Message := 'the first pass resets only the errored axis');
		F_Note(bFailed := NOT (rig.fbHa.nResetEdges = 1 AND rig.fbDec.nResetEdges = 0), sText := CONCAT(sTest, 'the first pass resets only the errored axis'));
		AssertTrue(Condition := rig.fbTel.bSafetyAckRequest, Message := 'the reset requests the safety acknowledge');
		F_Note(bFailed := NOT (rig.fbTel.bSafetyAckRequest), sText := CONCAT(sTest, 'the reset requests the safety acknowledge'));
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// second pass, 2.5 s later
	IF rig.fbHa.nResetEdges >= 2 AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbHa.nResetEdges = 2 AND rig.fbDec.nResetEdges = 1, Message := 'the second pass resets both axes, they are not enabled');
		F_Note(bFailed := NOT (rig.fbHa.nResetEdges = 2 AND rig.fbDec.nResetEdges = 1), sText := CONCAT(sTest, 'the second pass resets both axes, they are not enabled'));
		AssertFalse(Condition := rig.fbTel.bAxisResetAfterAck, Message := 'the second pass is over');
		F_Note(bFailed := (rig.fbTel.bAxisResetAfterAck), sText := CONCAT(sTest, 'the second pass is over'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 800 THEN
		AssertTrue(Condition := FALSE, Message := 'the second reset pass never came');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the second reset pass never came'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
