      <Get Name="Get" Id="{202c93bd-bfa5-4566-9582-4063ab8d4e4a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ErrorID := 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Parked" Id="{1d6f7c32-a789-4e79-9546-3a29a10b5397}">
      <Declaration><![CDATA[PROPERTY Parked : BOOL]]></Declaration>
      <Get Name="Get" Id="{18b6ee3c-221c-4155-97ff-83a4f1618aa8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Parked := bIsParked;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Position" Id="{224850c9-b26e-42a4-9a47-7d0c92bee7ff}">
      <Declaration><![CDATA[PROPERTY Position : LREAL]]></Declaration>
      <Get Name="Get" Id="{b641347a-8ff8-445e-a2b6-dcee8fb3761a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Position := fPos;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{b7b0b915-5512-4dca-bf2e-a75edf053aed}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[fPos := Position;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="RotState" Id="{1c9ce2fb-354e-47d0-8b14-4858c85f7387}">
      <Declaration><![CDATA[PROPERTY RotState : BROTLib.E_DomeRotationState]]></Declaration>
      <Get Name="Get" Id="{164b626b-44f4-4a14-8d2a-602ac13d2afa}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RotState := BROTLib.E_DomeRotationState.idle;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ShutterState" Id="{fe66c2d3-1a0b-4cb6-a946-327c65b64388}">
      <Declaration><![CDATA[PROPERTY ShutterState : BROTLib.E_RoofState]]></Declaration>
      <Get Name="Get" Id="{2b0a14fe-3f82-4bce-8df3-40c70fb2665e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ShutterState := eShutter;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{277f1e06-73aa-4701-8b4d-5b60b2264ac8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eShutter := ShutterState;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Tracking" Id="{e46826cf-7133-4a7a-9ba5-ef975eb49554}">
      <Declaration><![CDATA[PROPERTY Tracking : BOOL]]></Declaration>
      <Get Name="Get" Id="{4e56767f-2f6e-4f66-8b83-c7a9c0367dfe}">
