<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_HourAngleMock" Id="{1d19be2c-352c-40b3-9403-98fc48d716a1}" SpecialFunc="None">
    <Declaration><![CDATA[// Mock of FB_HourAngleControl for the telescope state machine tests (BROTLib plan 2026-10-21-telescope-state-machine-unification D1).
FUNCTION_BLOCK FB_HourAngleMock EXTENDS FB_HourAngleControl
VAR_INPUT
	nMockMoveScans	: UINT := 60;	// scans a move takes (the telescope sees Busy meanwhile)
	nMockStopScans	: UINT := 3;	// scans an MC_Stop takes until Done
END_VAR
VAR_OUTPUT
	nStopEdges		: UINT;			// stop requests the telescope made (rising edges of StopAxis)
	nResetEdges		: UINT;			// resets the telescope sent to the axis (Reset())
END_VAR
VAR
	fbCore	: FB_AxisMockCore;
	pBool	: POINTER TO BOOL;
	pLreal	: POINTER TO LREAL;
	bInjected	: BOOL;
	nInjectedId	: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// No SUPER^(): the real body (MC_* blocks, FB_LatchHome, AXIS_REF) does not run. The real property setters (MoveAxis ->
// fbAxis.MoveTo(), StopAxis -> fbAxis.Stop(), HomeAxis) stay, so the telescope sees the real command interface. The real body
// homes an enabled, uncalibrated axis by itself; the model does the same (bHome := bEnable). The model writes what the
// telescope reads: the base outputs and, through pointers (FB_Axis outputs are not writable from outside), the nested fbAxis outputs.
fbCore(bEnable := bEnable, bHome := bEnable, bMove := bMoveAxis, bStop := bStopAxis, fTarget := fPosition,
	nMoveScans := nMockMoveScans, nStopScans := nMockStopScans);

pBool := ADR(fbAxis.Ready);			pBool^ := fbCore.bReady;
pBool := ADR(fbAxis.Calibrated);	pBool^ := fbCore.bCalibrated;
pBool := ADR(fbAxis.HomeDone);		pBool^ := fbCore.bCalibrated;
pBool := ADR(fbAxis.HomeActive);	pBool^ := fbCore.bHoming;
pBool := ADR(fbAxis.Homing);		pBool^ := fbCore.bHoming;
pBool := ADR(fbAxis.InMotion);		pBool^ := fbCore.bInMotion;
pBool := ADR(fbAxis.StandStill);	pBool^ := fbCore.bStandStill;
pBool := ADR(fbAxis.MoveDone);		pBool^ := fbCore.bMoveDone;
pBool := ADR(fbAxis.Stopping);		pBool^ := fbCore.bStopping;
pBool := ADR(fbAxis.StopDone);		pBool^ := fbCore.bStopDone;
pBool := ADR(fbAxis.Busy);			pBool^ := fbCore.bInMotion OR fbCore.bHoming;
pLreal := ADR(fbAxis.ActualPosition);	pLreal^ := fbCore.fPosition;

bReady := fbCore.bReady AND fbCore.bStandStill;
nStopEdges := fbCore.nStopEdges;
bCalibrated := fbCore.bCalibrated;
fActualPosition := fbCore.fPosition;

// the real control body clears the level on MoveDone, and bStopAxis on StopDone
IF fbCore.bMoveDone THEN
	bMoveAxis := FALSE;
END_IF
IF fbCore.bStopDone THEN
	bStopAxis := FALSE;
END_IF
// a reset clears the injected error at once (ResetDone) and is counted
IF bReset THEN
	nResetEdges := nResetEdges + 1;
	bReset := FALSE;
	bInjected := FALSE;
	nInjectedId := 0;
END_IF
bError := bInjected;
nErrorID := nInjectedId;
]]></ST>
    </Implementation>
    <Method Name="InjectError" Id="{1b237f51-fe81-41ee-ad6f-7afcd0f42772}">
      <Declaration><![CDATA[// the axis reports an error with this id until the telescope resets it (bError/nErrorID are what the telescope reads)
METHOD InjectError
VAR_INPUT
	nId	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bInjected := TRUE;
nInjectedId := nId;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
