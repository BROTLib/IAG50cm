<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="IagParkPowerReset_Tests" Id="{36c28a88-3fd2-484e-b531-e55bb433513c}" SpecialFunc="None">
    <Declaration><![CDATA[// Park, power-on and reset precedence of FB_TelescopeControl (IAG50cm), command model step 3B (BROTLib
// specs/plans/2026-11-09-iag50cm-command-model-unification.md). One rig per test, one Scan() per PLC cycle.
FUNCTION_BLOCK IagParkPowerReset_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Park_During_Stop_Runs_After_Settle();
Stop_Drops_A_Park_Queued_Behind_A_Stop();
Init_During_Stop_Is_Refused();
Init_During_Park_Is_Refused();
Park_Right_After_Init_Aborts_The_PowerOn();
Init_Drops_A_Stale_Home();
Reset_At_Rest_Drops_A_Pending_Move();
Reset_During_Park_Keeps_The_Park();
Reset_Recovers_A_Stuck_Stop();
]]></ST>
    </Implementation>
    <Method Name="Park_During_Stop_Runs_After_Settle" Id="{6b0f034f-eecc-426f-8e38-cf376fe6fb5c}">
      <Declaration><![CDATA[// A park sent during a stop runs when the stop has settled (D13).
METHOD PRIVATE Park_During_Stop_Runs_After_Settle
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Park_During_Stop_Runs_After_Settle');
sTest := 'Park_During_Stop_Runs_After_Settle: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// an axis is moving
	IF rig.fbHa.MoveAxis OR rig.fbDec.MoveAxis THEN
		nCycles := 0;
		nStep := 30;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start an axis move');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start an axis move'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 5 THEN
		rig.fbTel.Stop();
		nStep := 35;
		nCycles := 0;
	END_IF
35:	// the stop runs: the park is queued behind it
	IF rig.fbTel.bStopActive THEN
		rig.fbTel.Park();
		nStep := 40;
		nCycles := 0;
	ELSIF nCycles > 10 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not start');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not start'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
40:
		AssertTrue(Condition := rig.fbTel.bParkAfterStop, Message := 'the park is queued');
		F_Note(bFailed := NOT (rig.fbTel.bParkAfterStop), sText := CONCAT(sTest, 'the park is queued'));
		AssertTrue(Condition := NOT rig.fbTel.bParkActive, Message := 'the park does not run during the stop');
		F_Note(bFailed := NOT (NOT rig.fbTel.bParkActive), sText := CONCAT(sTest, 'the park does not run during the stop'));
	nStep := 50;
	nCycles := 0;
50:
	IF rig.fbTel.bIsParked THEN
		AssertTrue(Condition := NOT rig.fbTel.bParkAfterStop, Message := 'the queue is empty');
		F_Note(bFailed := NOT (NOT rig.fbTel.bParkAfterStop), sText := CONCAT(sTest, 'the queue is empty'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the queued park did not run');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the queued park did not run'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Drops_A_Park_Queued_Behind_A_Stop" Id="{bc8e2461-efc9-4d6e-8535-9c7c6c9f128b}">
      <Declaration><![CDATA[// A stop clears a park that is queued behind a running stop (MONETcommon#213).
METHOD PRIVATE Stop_Drops_A_Park_Queued_Behind_A_Stop
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Drops_A_Park_Queued_Behind_A_Stop');
sTest := 'Stop_Drops_A_Park_Queued_Behind_A_Stop: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// an axis is moving
	IF rig.fbHa.MoveAxis OR rig.fbDec.MoveAxis THEN
		nCycles := 0;
		nStep := 30;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start an axis move');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start an axis move'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 5 THEN
		rig.fbTel.Stop();
		nStep := 35;
		nCycles := 0;
	END_IF
35:
	IF rig.fbTel.bStopActive THEN
		rig.fbTel.Park();
		rig.fbTel.Stop();
		nStep := 40;
		nCycles := 0;
	ELSIF nCycles > 10 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not start');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not start'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
40:
		AssertTrue(Condition := NOT rig.fbTel.bParkAfterStop, Message := 'the second stop dropped the queued park');
		F_Note(bFailed := NOT (NOT rig.fbTel.bParkAfterStop), sText := CONCAT(sTest, 'the second stop dropped the queued park'));
	nStep := 50;
	nCycles := 0;
50:	// the stop settles; no park follows
	IF nCycles >= 150 THEN
		AssertTrue(Condition := NOT rig.fbTel.bStopActive, Message := 'the stop is over');
		F_Note(bFailed := NOT (NOT rig.fbTel.bStopActive), sText := CONCAT(sTest, 'the stop is over'));
		AssertTrue(Condition := NOT rig.fbTel.bParkActive AND NOT rig.fbTel.bIsParked, Message := 'no park followed');
		F_Note(bFailed := NOT (NOT rig.fbTel.bParkActive AND NOT rig.fbTel.bIsParked), sText := CONCAT(sTest, 'no park followed'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init_During_Stop_Is_Refused" Id="{02c37d51-2260-49ad-a718-51cf2f9ccea2}">
      <Declaration><![CDATA[// A power-on during a stop is refused: a stop is not overridden by a power-on.
METHOD PRIVATE Init_During_Stop_Is_Refused
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Init_During_Stop_Is_Refused');
sTest := 'Init_During_Stop_Is_Refused: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// an axis is moving
	IF rig.fbHa.MoveAxis OR rig.fbDec.MoveAxis THEN
		nCycles := 0;
		nStep := 30;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start an axis move');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start an axis move'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 5 THEN
		rig.fbTel.Stop();
		nStep := 35;
		nCycles := 0;
	END_IF
35:
	IF rig.fbTel.bStopActive THEN
		rig.fbTel.Init();
		nStep := 40;
		nCycles := 0;
	ELSIF nCycles > 10 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not start');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not start'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
40:
		AssertTrue(Condition := rig.fbTel.nInitRefusedCount = 1, Message := 'the power-on was refused and counted');
		F_Note(bFailed := NOT (rig.fbTel.nInitRefusedCount = 1), sText := CONCAT(sTest, 'the power-on was refused and counted'));
		AssertTrue(Condition := NOT rig.fbTel.bPowerActive, Message := 'no power-on request');
		F_Note(bFailed := NOT (NOT rig.fbTel.bPowerActive), sText := CONCAT(sTest, 'no power-on request'));
		nStep := 99;
		TEST_FINISHED();
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init_During_Park_Is_Refused" Id="{5508f8a6-70a9-4938-b5b2-1f8318bd79ae}">
      <Declaration><![CDATA[// A power-on during a park is refused (the park is not cancelled by it any more).
METHOD PRIVATE Init_During_Park_Is_Refused
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Init_During_Park_Is_Refused');
sTest := 'Init_During_Park_Is_Refused: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbTel.bParkActive THEN
		rig.fbTel.Init();
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 10 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not start');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not start'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
		AssertTrue(Condition := rig.fbTel.nInitRefusedCount = 1, Message := 'the power-on was refused and counted');
		F_Note(bFailed := NOT (rig.fbTel.nInitRefusedCount = 1), sText := CONCAT(sTest, 'the power-on was refused and counted'));
		AssertTrue(Condition := NOT rig.fbTel.bPowerActive, Message := 'no power-on request');
		F_Note(bFailed := NOT (NOT rig.fbTel.bPowerActive), sText := CONCAT(sTest, 'no power-on request'));
		nStep := 99;
		TEST_FINISHED();
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Park_Right_After_Init_Aborts_The_PowerOn" Id="{15a0e430-e71f-4a61-ad5f-e29e6696b2fb}">
      <Declaration><![CDATA[// A park wins over a power-on that was requested in the same scan and not dispatched yet (D14).
METHOD PRIVATE Park_Right_After_Init_Aborts_The_PowerOn
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Park_Right_After_Init_Aborts_The_PowerOn');
sTest := 'Park_Right_After_Init_Aborts_The_PowerOn: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// Init() and Park() in one scan: the power-on is not dispatched yet, the park wins
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		rig.fbTel.Park();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:
		AssertTrue(Condition := NOT rig.fbTel.bPowerActive, Message := 'the power-on was aborted by the park');
		F_Note(bFailed := NOT (NOT rig.fbTel.bPowerActive), sText := CONCAT(sTest, 'the power-on was aborted by the park'));
	nStep := 20;
	nCycles := 0;
20:
	IF rig.fbTel.bIsParked THEN
		AssertTrue(Condition := rig.fbTel.ReadyState <> 1.0, Message := 'the telescope did not come online');
		F_Note(bFailed := NOT (rig.fbTel.ReadyState <> 1.0), sText := CONCAT(sTest, 'the telescope did not come online'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init_Drops_A_Stale_Home" Id="{e313321c-66b3-4673-9fb6-d838bd74ce7c}">
      <Declaration><![CDATA[// A new power-on drops a stale home (the power-on homes itself at stage 100).
METHOD PRIVATE Init_Drops_A_Stale_Home
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Init_Drops_A_Stale_Home');
sTest := 'Init_Drops_A_Stale_Home: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:
	IF rig.ClockValid THEN
		rig.fbTel.bGoHomeActive := TRUE;	// a home left over from before
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:
		AssertTrue(Condition := rig.fbTel.bPowerActive, Message := 'the power-on runs');
		F_Note(bFailed := NOT (rig.fbTel.bPowerActive), sText := CONCAT(sTest, 'the power-on runs'));
		AssertTrue(Condition := NOT rig.fbTel.bGoHomeActive, Message := 'the stale home is gone');
		F_Note(bFailed := NOT (NOT rig.fbTel.bGoHomeActive), sText := CONCAT(sTest, 'the stale home is gone'));
		nStep := 99;
		TEST_FINISHED();
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset_At_Rest_Drops_A_Pending_Move" Id="{d3ea8b91-cd64-408f-8a50-4cf5ec44ec42}">
      <Declaration><![CDATA[// A reset without an error drops a pending move; the hardware part stays gated (Q1c).
METHOD PRIVATE Reset_At_Rest_Drops_A_Pending_Move
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Reset_At_Rest_Drops_A_Pending_Move');
sTest := 'Reset_At_Rest_Drops_A_Pending_Move: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:
	IF rig.ClockValid THEN
		rig.fbTel.bSlewActive := TRUE;	// a request that cannot run (the telescope is not on)
		rig.fbTel.Reset();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:
		AssertTrue(Condition := NOT rig.fbTel.bSlewActive, Message := 'the pending slew is dropped');
		F_Note(bFailed := NOT (NOT rig.fbTel.bSlewActive), sText := CONCAT(sTest, 'the pending slew is dropped'));
		AssertTrue(Condition := NOT rig.fbTel.bSafetyAckRequest, Message := 'no safety acknowledge without an error');
		F_Note(bFailed := NOT (NOT rig.fbTel.bSafetyAckRequest), sText := CONCAT(sTest, 'no safety acknowledge without an error'));
		AssertTrue(Condition := rig.fbHa.nResetEdges = 0 AND rig.fbDec.nResetEdges = 0, Message := 'no axis was reset');
		F_Note(bFailed := NOT (rig.fbHa.nResetEdges = 0 AND rig.fbDec.nResetEdges = 0), sText := CONCAT(sTest, 'no axis was reset'));
		nStep := 99;
		TEST_FINISHED();
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset_During_Park_Keeps_The_Park" Id="{8939aae1-d5ee-4276-948c-db6630a755ce}">
      <Declaration><![CDATA[// A reset during a park does not stop it (its motion is wanted).
METHOD PRIVATE Reset_During_Park_Keeps_The_Park
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Reset_During_Park_Keeps_The_Park');
sTest := 'Reset_During_Park_Keeps_The_Park: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	IF rig.fbTel.bParkActive AND rig.fbTel.TCS_command = E_TCSCommand.park THEN
		rig.fbTel.Reset();
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not start');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not start'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 3 THEN
		AssertTrue(Condition := rig.fbTel.bParkActive OR rig.fbTel.bIsParked, Message := 'the park goes on');
		F_Note(bFailed := NOT (rig.fbTel.bParkActive OR rig.fbTel.bIsParked), sText := CONCAT(sTest, 'the park goes on'));
		nStep := 40;
		nCycles := 0;
	END_IF
40:
	IF rig.fbTel.bIsParked THEN
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset_Recovers_A_Stuck_Stop" Id="{7a8a62e7-eebe-4440-8c3a-101d43aaa757}">
      <Declaration><![CDATA[// A reset recovers a stop that never gets its Done, without waiting for the 30 s timeout (D18).
METHOD PRIVATE Reset_Recovers_A_Stuck_Stop
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Reset_Recovers_A_Stuck_Stop');
sTest := 'Reset_Recovers_A_Stuck_Stop: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.SetStopWithoutDone(bHa := TRUE, bDec := TRUE);
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// an axis is moving
	IF rig.fbHa.MoveAxis OR rig.fbDec.MoveAxis THEN
		nCycles := 0;
		nStep := 30;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start an axis move');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start an axis move'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 5 THEN
		rig.fbTel.Stop();
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// the axes are at rest, the Done never comes: the stop is held
	IF rig.fbTel.bStopped AND nCycles > 6 THEN
		AssertTrue(Condition := rig.fbTel.bStopActive, Message := 'the stop is stuck');
		F_Note(bFailed := NOT (rig.fbTel.bStopActive), sText := CONCAT(sTest, 'the stop is stuck'));
		rig.fbTel.Reset();
		nStep := 50;
		nCycles := 0;
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the axes did not come to rest');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the axes did not come to rest'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
50:	// the reset ends the stop at once, long before the 30 s timeout
	IF NOT rig.fbTel.bStopActive THEN
		AssertTrue(Condition := nCycles < 30, Message := 'released within a few scans');
		F_Note(bFailed := NOT (nCycles < 30), sText := CONCAT(sTest, 'released within a few scans'));
		AssertTrue(Condition := NOT rig.fbTel.bError, Message := 'no error');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError), sText := CONCAT(sTest, 'no error'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 100 THEN
		AssertTrue(Condition := FALSE, Message := 'the reset did not recover the stuck stop');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the reset did not recover the stuck stop'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>