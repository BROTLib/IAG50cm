<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="IagAbortStop_Tests" Id="{41488c4b-4b5a-40bf-aa1d-0c7071941a45}" SpecialFunc="None">
    <Declaration><![CDATA[// Abort stop and stop semantics of FB_TelescopeControl (IAG50cm), command model step 3A (BROTLib
// specs/plans/2026-11-09-iag50cm-command-model-unification.md). One rig per test, one Scan() per PLC cycle.
FUNCTION_BLOCK IagAbortStop_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Error_During_Abort_Stop_Clears_It();
Stop_Is_Held_Until_The_Transaction_Settles();
Stop_Clears_Every_Pending_Move();
Repeated_Stop_Restarts_Only_Moving_Axes();
Park_Over_A_Waiting_Goto_Runs_A_Short_Abort_Stop();
]]></ST>
    </Implementation>
    <Method Name="Error_During_Abort_Stop_Clears_It" Id="{e744fbaf-1d3f-407c-9c9e-e68aab66cba8}">
      <Declaration><![CDATA[// An error clears the abort stop: the drives are disabled, there is nothing to wait for (3A.1).
METHOD PRIVATE Error_During_Abort_Stop_Clears_It
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	nEdges		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Error_During_Abort_Stop_Clears_It');
sTest := 'Error_During_Abort_Stop_Clears_It: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 100.0, fDeclination := 30.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the goto runs: a second track replaces it through the abort stop
	IF rig.fbHa.MoveAxis OR rig.fbDec.MoveAxis THEN
		rig.fbTel.Track(fRightAscension := 110.0, fDeclination := 31.0);
		nStep := 25;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the goto did not start an axis move');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the goto did not start an axis move'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
25:
	IF rig.fbTel.bMoveAbortPending THEN
		rig.InjectHaError(16#4550);
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 10 THEN
		AssertTrue(Condition := FALSE, Message := 'the replaced goto did not run an abort stop');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the replaced goto did not run an abort stop'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 5 THEN
		AssertTrue(Condition := rig.fbTel.bError, Message := 'the axis error is seen');
		F_Note(bFailed := NOT (rig.fbTel.bError), sText := CONCAT(sTest, 'the axis error is seen'));
		AssertTrue(Condition := NOT rig.fbTel.bMoveAbortPending, Message := 'the error cleared the abort stop');
		F_Note(bFailed := NOT (NOT rig.fbTel.bMoveAbortPending), sText := CONCAT(sTest, 'the error cleared the abort stop'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Is_Held_Until_The_Transaction_Settles" Id="{dfeea4fe-984f-47d8-9f5b-9731eb677a12}">
      <Declaration><![CDATA[// The stop is held until the stop transaction has settled (3A.2).
METHOD PRIVATE Stop_Is_Held_Until_The_Transaction_Settles
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	nEdges		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Is_Held_Until_The_Transaction_Settles');
sTest := 'Stop_Is_Held_Until_The_Transaction_Settles: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// an axis is moving
	IF rig.fbHa.MoveAxis OR rig.fbDec.MoveAxis THEN
		nCycles := 0;
		nStep := 30;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start an axis move');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start an axis move'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 5 THEN
		rig.fbTel.Stop();
		nStep := 40;
		nCycles := 0;
	END_IF
40:	// the stop is held while the axis is stopping, and released only when the transaction has settled
	IF nCycles = 2 THEN
		AssertTrue(Condition := rig.fbTel.bStopActive, Message := 'the stop is still held two scans after the command');
		F_Note(bFailed := NOT (rig.fbTel.bStopActive), sText := CONCAT(sTest, 'the stop is still held two scans after the command'));
	END_IF
	IF NOT rig.fbTel.bStopActive THEN
		AssertTrue(Condition := rig.fbTel.bSettled, Message := 'released only when settled');
		F_Note(bFailed := NOT (rig.fbTel.bSettled), sText := CONCAT(sTest, 'released only when settled'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Clears_Every_Pending_Move" Id="{d7499b9c-860f-4eaa-abdf-6e4fe1fcb0bb}">
      <Declaration><![CDATA[// A goto and a home that are both pending when the stop comes are both cleared (3A.3).
METHOD PRIVATE Stop_Clears_Every_Pending_Move
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	nEdges		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Clears_Every_Pending_Move');
sTest := 'Stop_Clears_Every_Pending_Move: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 100.0, fDeclination := 30.0);
		rig.fbTel.Home();
		rig.fbTel.Stop();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// one scan after the three commands
		AssertTrue(Condition := NOT rig.fbTel.bGotoActive, Message := 'the goto is gone');
		F_Note(bFailed := NOT (NOT rig.fbTel.bGotoActive), sText := CONCAT(sTest, 'the goto is gone'));
		AssertTrue(Condition := NOT rig.fbTel.bGoHomeActive, Message := 'the home is gone');
		F_Note(bFailed := NOT (NOT rig.fbTel.bGoHomeActive), sText := CONCAT(sTest, 'the home is gone'));
		nStep := 99;
		TEST_FINISHED();
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Repeated_Stop_Restarts_Only_Moving_Axes" Id="{600a7877-595e-4843-afb8-c0b8ed45eec0}">
      <Declaration><![CDATA[// A repeated stop does not send a second stop to an axis that is already stopping (3A.4).
METHOD PRIVATE Repeated_Stop_Restarts_Only_Moving_Axes
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	nEdges		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Repeated_Stop_Restarts_Only_Moving_Axes');
sTest := 'Repeated_Stop_Restarts_Only_Moving_Axes: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// an axis is moving
	IF rig.fbHa.MoveAxis OR rig.fbDec.MoveAxis THEN
		nCycles := 0;
		nStep := 30;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not start an axis move');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not start an axis move'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:
	IF nCycles >= 5 THEN
		rig.fbTel.Stop();
		nStep := 35;
		nCycles := 0;
	END_IF
35:	// a second stop while the axis is already stopping (the stop reaches the axis in the third scan, the axis then reports Stopping)
	IF nCycles >= 3 THEN
		rig.fbTel.Stop();
		nStep := 40;
		nCycles := 0;
	END_IF
40:
	IF NOT rig.fbTel.bStopActive AND rig.fbTel.bStopped AND nCycles > 5 THEN
		AssertTrue(Condition := rig.fbHa.nStopEdges + rig.fbDec.nStopEdges = 1, Message := 'no second stop for an axis that was stopping');
		F_Note(bFailed := NOT (rig.fbHa.nStopEdges + rig.fbDec.nStopEdges = 1), sText := CONCAT(sTest, 'no second stop for an axis that was stopping'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 400 THEN
		AssertTrue(Condition := FALSE, Message := 'the stop did not settle');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the stop did not settle'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Park_Over_A_Waiting_Goto_Runs_A_Short_Abort_Stop" Id="{2de3959f-a3a4-4b2c-ad59-fdc1a4c548db}">
      <Declaration><![CDATA[// A park over a goto that is not dispatched yet runs a short abort stop, then the park (3A.5).
METHOD PRIVATE Park_Over_A_Waiting_Goto_Runs_A_Short_Abort_Stop
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	nEdges		: UINT;
	bSeen		: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Park_Over_A_Waiting_Goto_Runs_A_Short_Abort_Stop');
sTest := 'Park_Over_A_Waiting_Goto_Runs_A_Short_Abort_Stop: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		rig.fbTel.Track(fRightAscension := 100.0, fDeclination := 30.0);
		rig.fbTel.Park();
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the park preempted a goto that was not dispatched: the abort stop runs, then the park
	IF rig.fbTel.bMoveAbortPending THEN
		bSeen := TRUE;
	END_IF
	IF rig.fbTel.bIsParked THEN
		AssertTrue(Condition := bSeen, Message := 'the preemption ran the abort stop');
		F_Note(bFailed := NOT (bSeen), sText := CONCAT(sTest, 'the preemption ran the abort stop'));
		AssertTrue(Condition := NOT rig.fbTel.bGotoActive, Message := 'the goto is gone');
		F_Note(bFailed := NOT (NOT rig.fbTel.bGotoActive), sText := CONCAT(sTest, 'the goto is gone'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 3000 THEN
		AssertTrue(Condition := FALSE, Message := 'the park did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the park did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>