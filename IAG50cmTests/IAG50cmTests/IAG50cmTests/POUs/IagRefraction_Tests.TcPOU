<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="IagRefraction_Tests" Id="{8275b9de-fbfd-4e09-a4dd-dbfbd58f5ae1}" SpecialFunc="None">
    <Declaration><![CDATA[// IAG50cm#7: the refraction switch, on BROTLib's blocks since #17 with IAG50cm's coefficients (GVL_Pointing). OLD is
// bit-identical to the pointing model before #7 (frozen copy
// FB_PointingModelForwardLegacy); FB_RefractionShift against values from the Python port of AstroBROT; the NEW chain of
// FB_TelescopeControl._ComputeTargets inverts. The telescope block itself (flags, publish) is checked on
// the telescope (IAG plan 2026-11-24-iag50cm-refraction-switch, step 6).
FUNCTION_BLOCK IagRefraction_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Old_Model_Is_Bit_Identical();
New_Model_Has_No_Refraction_Terms();
Refraction_Shift_Values();
Refraction_Round_Trip();
Refraction_Zero_At_The_Zenith();
Refraction_Uses_The_Weather();
New_Chain_Round_Trip();
Refraction_Rate_Sign();
]]></ST>
    </Implementation>
    <Method Name="Old_Model_Is_Bit_Identical" Id="{ce9e1ed9-301c-4ced-ba01-82760ea10673}">
      <Declaration><![CDATA[METHOD PRIVATE Old_Model_Is_Bit_Identical
VAR
	fbNew	: BROTLib.FB_EqPointingModelForward;
	fbOld	: FB_PointingModelForwardLegacy;
	i, j	: INT;
	fHa, fDec	: LREAL;
	nDiff	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Old_Model_Is_Bit_Identical');
// BROTLib.FB_EqPointingModelForward with GVL_Pointing.stCoeffOld against the frozen copy of the model before #7: the same numbers, not just close.
// Grid: HA -170..180 in 10 deg, Dec -30..85 in 5 deg (below the 1 deg altitude gate both give 0 / sidereal).
FOR i := -17 TO 18 DO
	FOR j := -6 TO 17 DO
		fHa := INT_TO_LREAL(i) * 10.0;
		fDec := INT_TO_LREAL(j) * 5.0;
		fbNew(HourAngle := fHa, Declination := fDec, Latitude := 51.5592378, stCoefficients := GVL_Pointing.stCoeffOld);
		fbOld(HourAngle := fHa, Declination := fDec, Latitude := 51.5592378);
		IF fbNew.HourAngle_correction <> fbOld.HourAngle_correction OR fbNew.Declination_correction <> fbOld.Declination_correction
			OR fbNew.HourAngle_velocity <> fbOld.HourAngle_velocity OR fbNew.Declination_velocity <> fbOld.Declination_velocity
			OR fbNew.bValid <> fbOld.bValid THEN
			nDiff := nDiff + 1;
		END_IF
	END_FOR
END_FOR
AssertEquals_INT(Expected := 0, Actual := nDiff, Message := 'grid points where OLD differs from the model before #7');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="New_Model_Has_No_Refraction_Terms" Id="{c36ee8e5-6053-405c-aa8d-7ee3cbf49e24}">
      <Declaration><![CDATA[METHOD PRIVATE New_Model_Has_No_Refraction_Terms
VAR
	fbNew	: BROTLib.FB_EqPointingModelForward;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('New_Model_Has_No_Refraction_Terms');
// NEW uses GVL_Pointing.stCoeffNew, whose C_Refr_* are 0, and differs from OLD
AssertEquals_LREAL(Expected := 0.0, Actual := GVL_Pointing.stCoeffNew.C_Refr_tau, Delta := 0.0, Message := 'C_Refr_tau');
AssertEquals_LREAL(Expected := 0.0, Actual := GVL_Pointing.stCoeffNew.C_Refr_dec, Delta := 0.0, Message := 'C_Refr_dec');
fbNew(HourAngle := 0.0, Declination := 51.5592378, Latitude := 51.5592378, stCoefficients := GVL_Pointing.stCoeffNew);
// at the zenith only the constant and the Dec-dependent terms are left: Coll_tau + Enc_tau/cos - NP_tau*tan, ...
AssertEquals_LREAL(Expected := 0.29834839 + 0.00103115 / COS(51.5592378 * PI / 180.0) - 0.02123962 * TAN(51.5592378 * PI / 180.0)
	- 0.01690121 * TAN(51.5592378 * PI / 180.0),
	Actual := fbNew.HourAngle_correction, Delta := 1.0E-9, Message := 'HA correction at the zenith from stCoeffNew');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Refraction_Shift_Values" Id="{6498f461-c921-4092-b85a-3493fea72d31}">
      <Declaration><![CDATA[METHOD PRIVATE Refraction_Shift_Values
VAR
	fbShift	: BROTLib.FB_RefractionShift;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Refraction_Shift_Values');
// expected values from the Python port of the same AstroBROT functions (IAG repo tools/pointing/refit_refraction.py),
// site estimate for 100 m (998.08 hPa, 9.35 C), as the PLC uses without live weather
fbShift(HourAngle := 30.0, Declination := 20.0, Latitude := 51.5592378, SiteAltitude := 100.0, ToObserved := TRUE);
AssertEquals_LREAL(Expected := 50.6990733217, Actual := fbShift.AltitudeIn, Delta := 1.0E-8, Message := 'altitude in 30.0/20.0');
AssertEquals_LREAL(Expected := 50.7121349241, Actual := fbShift.AltitudeOut, Delta := 0.01 / 3600.0, Message := 'altitude out 30.0/20.0');
AssertEquals_LREAL(Expected := -24.5598, Actual := fbShift.HourAngleShift * 3600.0, Delta := 0.02, Message := 'HA shift 30.0/20.0');
AssertEquals_LREAL(Expected := 40.969, Actual := fbShift.DeclinationShift * 3600.0, Delta := 0.02, Message := 'Dec shift 30.0/20.0');
fbShift(HourAngle := -60.0, Declination := 10.0, Latitude := 51.5592378, SiteAltitude := 100.0, ToObserved := TRUE);
AssertEquals_LREAL(Expected := 26.2405146085, Actual := fbShift.AltitudeIn, Delta := 1.0E-8, Message := 'altitude in -60.0/10.0');
AssertEquals_LREAL(Expected := 26.272731893, Actual := fbShift.AltitudeOut, Delta := 0.01 / 3600.0, Message := 'altitude out -60.0/10.0');
AssertEquals_LREAL(Expected := 70.7006, Actual := fbShift.HourAngleShift * 3600.0, Delta := 0.02, Message := 'HA shift -60.0/10.0');
AssertEquals_LREAL(Expected := 92.7599, Actual := fbShift.DeclinationShift * 3600.0, Delta := 0.02, Message := 'Dec shift -60.0/10.0');
fbShift(HourAngle := 150.0, Declination := 80.0, Latitude := 51.5592378, SiteAltitude := 100.0, ToObserved := TRUE);
AssertEquals_LREAL(Expected := 42.676459068, Actual := fbShift.AltitudeIn, Delta := 1.0E-8, Message := 'altitude in 150.0/80.0');
AssertEquals_LREAL(Expected := 42.6937542296, Actual := fbShift.AltitudeOut, Delta := 0.01 / 3600.0, Message := 'altitude out 150.0/80.0');
AssertEquals_LREAL(Expected := -151.8393, Actual := fbShift.HourAngleShift * 3600.0, Delta := 0.02, Message := 'HA shift 150.0/80.0');
AssertEquals_LREAL(Expected := 56.4137, Actual := fbShift.DeclinationShift * 3600.0, Delta := 0.02, Message := 'Dec shift 150.0/80.0');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Refraction_Round_Trip" Id="{7e9f7658-3308-45ff-b06e-2a6e955e3387}">
      <Declaration><![CDATA[METHOD PRIVATE Refraction_Round_Trip
VAR
	fbTo	: BROTLib.FB_RefractionShift;
	fbFrom	: BROTLib.FB_RefractionShift;
	i, j	: INT;
	fHa, fDec	: LREAL;
	fErr, fMax	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Refraction_Round_Trip');
// geometric -> observed -> geometric gives the start again, above 5 deg altitude to better than 0.05"
FOR i := -11 TO 12 DO
	FOR j := -6 TO 17 DO
		fHa := INT_TO_LREAL(i) * 15.0;
		fDec := INT_TO_LREAL(j) * 5.0;
		fbTo(HourAngle := fHa, Declination := fDec, Latitude := 51.5592378, SiteAltitude := 100.0, ToObserved := TRUE);
		IF fbTo.AltitudeIn > 5.0 THEN
			fbFrom(HourAngle := fHa + fbTo.HourAngleShift, Declination := fDec + fbTo.DeclinationShift, Latitude := 51.5592378,
				SiteAltitude := 100.0, ToObserved := FALSE);
			fErr := ABS(fbFrom.AltitudeOut - fbTo.AltitudeIn) * 3600.0
				+ ABS(fbTo.DeclinationShift + fbFrom.DeclinationShift) * 3600.0
				+ ABS(fbTo.HourAngleShift + fbFrom.HourAngleShift) * 3600.0 * COS(fDec * PI / 180.0);
			fMax := MAX(fMax, fErr);
		END_IF
	END_FOR
END_FOR
AssertTrue(Condition := fMax < 0.05, Message := CONCAT('round trip error above 0.05 arcsec: ', LREAL_TO_STRING(fMax)));
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Refraction_Zero_At_The_Zenith" Id="{016fa20c-9519-4ba7-a155-a757c213d71a}">
      <Declaration><![CDATA[METHOD PRIVATE Refraction_Zero_At_The_Zenith
VAR
	fbShift	: BROTLib.FB_RefractionShift;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Refraction_Zero_At_The_Zenith');
fbShift(HourAngle := 0.0, Declination := 51.5592378, Latitude := 51.5592378, SiteAltitude := 100.0, ToObserved := TRUE);
AssertEquals_LREAL(Expected := 0.0, Actual := fbShift.HourAngleShift * 3600.0, Delta := 0.001, Message := 'HA shift');
AssertEquals_LREAL(Expected := 0.0, Actual := fbShift.DeclinationShift * 3600.0, Delta := 0.001, Message := 'Dec shift');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Refraction_Uses_The_Weather" Id="{08a46e20-d538-45ac-a86c-31ac52e0b87b}">
      <Declaration><![CDATA[METHOD PRIVATE Refraction_Uses_The_Weather
VAR
	fbEstimate	: BROTLib.FB_RefractionShift;
	fbHigh		: BROTLib.FB_RefractionShift;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Refraction_Uses_The_Weather');
// a higher pressure gives a larger refraction; the estimate (pressure 0) equals passing the estimated values
fbEstimate(HourAngle := 30.0, Declination := 20.0, Latitude := 51.5592378, SiteAltitude := 100.0, ToObserved := TRUE);
fbHigh(HourAngle := 30.0, Declination := 20.0, Latitude := 51.5592378, SiteAltitude := 100.0, Pressure := 1030.0,
	Temperature := 9.35, TemperatureSet := TRUE, ToObserved := TRUE);
AssertTrue(Condition := fbHigh.AltitudeOut - fbHigh.AltitudeIn > fbEstimate.AltitudeOut - fbEstimate.AltitudeIn,
	Message := 'higher pressure, more refraction');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="New_Chain_Round_Trip" Id="{5381c1df-8716-485f-bef3-c39322682146}">
      <Declaration><![CDATA[METHOD PRIVATE New_Chain_Round_Trip
VAR
	fbTo		: BROTLib.FB_RefractionShift;
	fbModel		: BROTLib.FB_EqPointingModelForward;
	fbInv		: BROTLib.FB_EqPointingModelInversion;
	fbFrom		: BROTLib.FB_RefractionShift;
	fHa, fDec	: LREAL;
	fAxisHa, fAxisDec	: LREAL;
	fGeoHa, fGeoDec		: LREAL;
	i			: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('New_Chain_Round_Trip');
// the NEW path of FB_TelescopeControl._ComputeTargets, step by step: geometric target -> observed -> axis = observed +
// model(observed); then axis -> inversion -> observed -> geometric. Must give the target again (< 0.5", the inversion
// stops at 0.25"). Three targets at 20, 45 and 70 deg altitude or so.
FOR i := 0 TO 2 DO
	CASE i OF
		0: fHa := -60.0; fDec := 10.0;
		1: fHa := 30.0; fDec := 20.0;
		2: fHa := 10.0; fDec := 60.0;
	END_CASE
	fbTo(HourAngle := fHa, Declination := fDec, Latitude := 51.5592378, SiteAltitude := 100.0, ToObserved := TRUE);
	fbModel(HourAngle := fHa + fbTo.HourAngleShift, Declination := fDec + fbTo.DeclinationShift, Latitude := 51.5592378,
		stCoefficients := GVL_Pointing.stCoeffNew);
	fAxisHa := fHa + fbTo.HourAngleShift + fbModel.HourAngle_correction;
	fAxisDec := fDec + fbTo.DeclinationShift + fbModel.Declination_correction;
	fbInv(HourAngle := fAxisHa, Declination := fAxisDec, Latitude := 51.5592378, stCoefficients := GVL_Pointing.stCoeffNew);
	fbFrom(HourAngle := fAxisHa - fbInv.HourAngle_correction, Declination := fAxisDec - fbInv.Declination_correction,
		Latitude := 51.5592378, SiteAltitude := 100.0, ToObserved := FALSE);
	fGeoHa := fAxisHa - (fbInv.HourAngle_correction - fbFrom.HourAngleShift);
	fGeoDec := fAxisDec - (fbInv.Declination_correction - fbFrom.DeclinationShift);
	AssertTrue(Condition := fbInv.bValid, Message := 'inversion converged');
	AssertEquals_LREAL(Expected := fHa, Actual := fGeoHa, Delta := 0.5 / 3600.0, Message := 'hour angle back');
	AssertEquals_LREAL(Expected := fDec, Actual := fGeoDec, Delta := 0.5 / 3600.0, Message := 'declination back');
END_FOR
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Refraction_Rate_Sign" Id="{71aaaafa-25a6-4460-8510-5503dea42c06}">
      <Declaration><![CDATA[METHOD PRIVATE Refraction_Rate_Sign
VAR
	fbNow	: BROTLib.FB_RefractionShift;
	fbLater	: BROTLib.FB_RefractionShift;
	fRate	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Refraction_Rate_Sign');
// a star that sets in the west (HA 60) sinks, so its refraction grows: the Dec shift of a star south of the zenith
// moves it north (positive) more and more, the rate is positive. 10 s step as in FB_TelescopeControl.
fbNow(HourAngle := 60.0, Declination := 0.0, Latitude := 51.5592378, SiteAltitude := 100.0, ToObserved := TRUE);
fbLater(HourAngle := 60.0 + 10.0 * 360.0 / 86164.0905, Declination := 0.0, Latitude := 51.5592378, SiteAltitude := 100.0,
	ToObserved := TRUE);
fRate := (fbLater.DeclinationShift - fbNow.DeclinationShift) / 10.0;
AssertTrue(Condition := fRate > 0.0, Message := 'Dec refraction grows while the star sets');
AssertTrue(Condition := fRate < 1.0 / 3600.0, Message := 'and by less than 1 arcsec/s');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>