<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FocusMock" Id="{fe681464-23a7-42f5-b1e7-c694d5ac3e1d}" SpecialFunc="None">
    <Declaration><![CDATA[// Mock of the focus axis (I_Focus) for the telescope state machine tests: enabled = ready, homing calibrates at once, the
// position follows the target at once. Status only, no motion model.
FUNCTION_BLOCK FB_FocusMock IMPLEMENTS BROTLib.I_Focus
VAR
	bEn		: BOOL;
	bCal	: BOOL;
	bHome	: BOOL;
	bNeg	: BOOL;
	bPos	: BOOL;
	fPos	: LREAL;
	fTarget	: LREAL;
	fVel	: LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bEn THEN
	bCal := TRUE;
END_IF
fPos := fTarget;
]]></ST>
    </Implementation>
    <Method Name="Reset" Id="{d4b3fbb6-ebaa-41a4-8f3b-4f8208ed3993}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Reset := TRUE;
]]></ST>
      </Implementation>
    </Method>
