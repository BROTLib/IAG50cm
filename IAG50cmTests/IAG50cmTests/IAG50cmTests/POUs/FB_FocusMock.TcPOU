<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FocusMock" Id="{5fdf5a9a-cc47-484b-b66c-dbdc86e8cac2}" SpecialFunc="None">
    <Declaration><![CDATA[// Mock of the focus axis (I_Focus) for the telescope state machine tests: enabled = ready and calibrated at once (the telescope never sets HomeAxis), the
// position follows the target at once. Status only, no motion model.
FUNCTION_BLOCK FB_FocusMock IMPLEMENTS BROTLib.I_Focus
VAR
	bEn		: BOOL;
	bCal	: BOOL;
	bHome	: BOOL;
	bNeg	: BOOL;
	bPos	: BOOL;
	fPos	: LREAL;
	fTarget	: LREAL;
	fVel	: LREAL;
	nStop	: INT;		// number of Stop() calls
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bEn THEN
	bCal := TRUE;
END_IF
fPos := fTarget;
]]></ST>
    </Implementation>
    <Method Name="Stop" Id="{23bdd15b-5914-43f8-a4ab-1ddba78da4a7}">
      <Declaration><![CDATA[METHOD Stop : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nStop := nStop + 1;
Stop := TRUE;
]]></ST>
      </Implementation>
    </Method>
