<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PointingModelForward744" Id="{a967089f-b25e-4bfb-9ef3-9a9eabebe515}" SpecialFunc="None">
    <Declaration><![CDATA[// Frozen copy of IAG50cm develop 744020b (before IAG50cm#17), the oracle of IagLibraryMatchesLegacy_Tests. Only the names
// and the two types that moved to BROTLib are changed. Do not change it.
FUNCTION_BLOCK FB_PointingModelForward744
VAR_INPUT
	HourAngle		: LREAL;
	Declination		: LREAL;
	Latitude		: LREAL;
	eRefractionMode	: BROTLib.E_RefractionMode := BROTLib.E_RefractionMode.OLD;	// coefficient set (IAG50cm#7): OLD = GVL_Pointing.stCoeffOld, the model as before
END_VAR
VAR_OUTPUT
	HourAngle_correction	: LREAL;
	Declination_correction	: LREAL;
	HourAngle_velocity		: LREAL;
	Declination_velocity 	: LREAL;
	bValid					: BOOL;	// FALSE if the target is below fMinSinAlt (altitude < 1 deg): the refraction terms divide by sin_alt and are not physical there (#134; kept in NEW too, where they are 0). Corrections and Dec velocity are 0.0, HA velocity is sidereal when FALSE.
END_VAR
VAR
	stC		: BROTLib.ST_EqPointingCoefficients;	// the set of this call, copied from GVL_Pointing
	// inputs in rad
	tau		: LREAL;
	dec		: LREAL;
	alt		: LREAL;
	lat		: LREAL;
	// offsets
	off_tau_esti : LREAL :=0.0;
	off_dec_esti : LREAL :=0.0;
	// trackingspeeds
	track_tau_esti : LREAL := 0.0;
	track_dec_esti : LREAL := 0.0;
	// Altitude
	alt_diff : LREAL;
	// pre calculated sin/cos
	sin_tau	: LREAL;
	cos_tau	: LREAL;
	sin_dec	: LREAL;
	cos_dec : LREAL;
	sin_lat	: LREAL;
	cos_lat : LREAL;
	sin_alt : LREAL;
	sin_alt_rate : LREAL;
	cos_alt : LREAL;
END_VAR
VAR CONSTANT
	d2r		: LREAL := PI/180.0;
	omega 	: LREAL := 360.0 / 86164.099 * (PI/180.0); //sidereal velocity
	fMinSinAlt : LREAL := 0.017452406437283512;	// SIN(1 deg), below this the refraction terms are not evaluated (#134)
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// the coefficient set (IAG50cm#7); OLD is the set that was in GVL_Pointing as C_* before, so OLD is unchanged
IF eRefractionMode = BROTLib.E_RefractionMode.NEW THEN
	stC := GVL_Pointing.stCoeffNew;
ELSE
	stC := GVL_Pointing.stCoeffOld;
END_IF

// degrees to rad
tau := HourAngle * d2r;
dec	:= Declination * d2r;
lat := Latitude * d2r;


// pre-calculate repeating sine and cosine functions
sin_TAU := SIN(tau);
cos_TAU := COS(tau);
sin_DEC := SIN(dec);
cos_DEC := COS(dec);
sin_lat := SIN(lat);
cos_lat := COS(lat);

// alt difference estimation (WITHOUT Nutation, Aberation, Presession)
sin_alt := sin_DEC * sin_lat + cos_DEC * cos_lat * cos_TAU;
sin_alt := LIMIT(-1.0, sin_alt, 1.0);	// rounding can give 1 + 2.2E-16 at the zenith, ASIN of that is NaN (#4)
alt := ASIN(sin_alt);					// diagnostics only, not used below
cos_alt := SQRT(1.0 - sin_alt * sin_alt);	// = COS(alt) >= 0
// d(sin alt)/dt = cos(alt) * d(alt)/dt. Finite everywhere; d(alt)/dt itself is 0/0 at the zenith (#4)
sin_alt_rate := -omega * cos_DEC * cos_lat * sin_TAU;
IF cos_alt > 1.0E-9 THEN
	alt_diff := sin_alt_rate / cos_alt;	// diagnostics only, not used below
ELSE
	alt_diff := 0.0;
END_IF

// below 1 deg altitude (also below the horizon) the refraction terms divide by sin_alt (Inf at the horizon) and refraction
// is not physical there: no correction, sidereal HA velocity, and the caller can refuse the target (#134)
IF sin_alt < fMinSinAlt THEN
	bValid := FALSE;
	HourAngle_correction	:= 0.0;
	Declination_correction	:= 0.0;
	HourAngle_velocity		:= omega / d2r;
	Declination_velocity	:= 0.0;
	RETURN;
END_IF
bValid := TRUE;

// ### TAU offset ###
off_tau_esti := - stC.C_mAl_tau * ((cos_TAU * sin_DEC) / cos_DEC);
off_tau_esti := off_tau_esti + stC.C_mEl_tau * ((sin_TAU * sin_DEC) / cos_DEC);
off_tau_esti := off_tau_esti + stC.C_Coll_tau;
off_tau_esti := off_tau_esti + stC.C_Refr_tau * ((sin_TAU * cos_lat) / (sin_alt * cos_DEC)); 
off_tau_esti := off_tau_esti + stC.C_Flex_tau * ((sin_TAU * cos_lat) / cos_DEC);
off_tau_esti := off_tau_esti + stC.C_Enc_tau / cos_DEC;
off_tau_esti := off_tau_esti - stC.C_NP_tau * (sin_DEC / cos_DEC);


track_tau_esti := stC.c_mal_tau * omega * ((sin_TAU * sin_DEC) / cos_DEC);
track_tau_esti := track_tau_esti + stC.c_mel_tau * omega * ((cos_TAU * sin_DEC) / cos_DEC);
track_tau_esti := track_tau_esti + stC.c_refr_tau * omega * ((cos_TAU * cos_lat) / (sin_alt * cos_DEC)); // 1ST derivative term
track_tau_esti := track_tau_esti - stC.c_refr_tau * sin_alt_rate * ((sin_TAU * cos_lat) / (sin_alt*sin_alt * cos_DEC)); // 2nd term
track_tau_esti := track_tau_esti + stC.c_flex_tau * omega * ((cos_TAU * cos_lat) / cos_DEC);


// ### DEC offset ###
off_dec_esti := stC.C_mAl_dec * sin_TAU;
off_dec_esti := off_dec_esti + stC.C_mEl_dec * cos_TAU;
off_dec_esti := off_dec_esti + stC.C_Coll_dec;
off_dec_esti := off_dec_esti + stC.C_Refr_dec * ((sin_lat - sin_alt * sin_DEC) / (cos_DEC * sin_alt));
off_dec_esti := off_dec_esti - stC.C_Flex_dec * ((sin_lat - sin_alt * sin_DEC) / cos_DEC);


track_dec_esti := stC.c_mal_dec * omega * cos_TAU;
track_dec_esti := track_dec_esti - stC.c_mel_dec * omega * sin_TAU;
track_dec_esti := track_dec_esti - stC.c_refr_dec * sin_alt_rate * (sin_DEC / (cos_DEC * sin_alt));//# 1ST term
track_dec_esti := track_dec_esti - stC.c_refr_dec * sin_alt_rate * ((sin_lat - sin_alt * sin_DEC) / (cos_DEC * sin_alt*sin_alt)); //# 2nd derivative term
track_dec_esti := track_dec_esti + stC.c_flex_dec * sin_alt_rate * (sin_DEC / cos_DEC);

HourAngle_correction	:= off_tau_esti;
Declination_correction	:= off_dec_esti;
HourAngle_velocity		:= (track_tau_esti + omega)/d2r;
Declination_velocity 	:= track_dec_esti/d2r; 

            ]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>