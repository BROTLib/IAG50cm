      </Implementation>
    </Method>
    <Method Name="Axis_Without_Stop_Needs_No_Done" Id="{6f222041-3542-457e-bedf-050f4891261d}">
      <Declaration><![CDATA[METHOD PRIVATE Axis_Without_Stop_Needs_No_Done
VAR
	fbTx	: FB_StopTransaction;
	i		: INT;
	nHa		: INT;
	nDec	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Axis_Without_Stop_Needs_No_Done');
fbTx.Begin();
FOR i := 1 TO 2 DO
fbTx(bHaStandStill := TRUE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
END_FOR
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bActive, Message := 'two scans');
fbTx(bHaStandStill := TRUE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bActive, Message := 'settled after three clear scans');
AssertEquals_INT(Expected := 0, Actual := nHa, Message := 'HA stops sent');
AssertEquals_INT(Expected := 0, Actual := nDec, Message := 'Dec stops sent');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Not_At_Rest_Never_Settles" Id="{bdea2b78-3312-41b6-b471-c78bf207214b}">
