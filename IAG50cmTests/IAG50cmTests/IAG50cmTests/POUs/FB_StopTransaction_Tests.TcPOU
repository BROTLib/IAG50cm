]]></ST>
      </Implementation>
    </Method>
    <Method Name="Axis_Without_Stop_Needs_No_Done" Id="{6f222041-3542-457e-bedf-050f4891261d}">
      <Declaration><![CDATA[METHOD PRIVATE Axis_Without_Stop_Needs_No_Done
VAR
	fbTx	: FB_StopTransaction;
	i		: INT;
	nHa		: INT;
	nDec	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Axis_Without_Stop_Needs_No_Done');
fbTx.Begin();
FOR i := 1 TO 2 DO
fbTx(bHaStandStill := TRUE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
END_FOR
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bActive, Message := 'two scans');
fbTx(bHaStandStill := TRUE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bActive, Message := 'settled after three clear scans');
AssertEquals_INT(Expected := 0, Actual := nHa, Message := 'HA stops sent');
AssertEquals_INT(Expected := 0, Actual := nDec, Message := 'Dec stops sent');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Not_At_Rest_Never_Settles" Id="{bdea2b78-3312-41b6-b471-c78bf207214b}">
      <Declaration><![CDATA[METHOD PRIVATE Not_At_Rest_Never_Settles
VAR
	fbTx	: FB_StopTransaction;
	i		: INT;
	nHa		: INT;
	nDec	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Not_At_Rest_Never_Settles');
fbTx.Begin();
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
FOR i := 1 TO 50 DO
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := TRUE, bDecStopDone := TRUE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
END_FOR
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bActive, Message := 'not at rest');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Done_Before_The_Transaction_Is_Ignored" Id="{29954a4f-0795-432f-b588-99b0201cd29a}">
      <Declaration><![CDATA[METHOD PRIVATE Done_Before_The_Transaction_Is_Ignored
VAR
	fbTx	: FB_StopTransaction;
	i		: INT;
	nHa		: INT;
	nDec	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Done_Before_The_Transaction_Is_Ignored');
fbTx.Begin();
fbTx(bHaStandStill := TRUE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := TRUE, bDecStopDone := TRUE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
fbTx.Begin();
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
FOR i := 1 TO 20 DO
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
END_FOR
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bActive, Message := 'a new transaction needs its own Done');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="New_Transaction_Sends_Stop_Again" Id="{5199921b-ad4b-464a-9f70-46ce24682232}">
      <Declaration><![CDATA[METHOD PRIVATE New_Transaction_Sends_Stop_Again
VAR
	fbTx	: FB_StopTransaction;
	i		: INT;
	nHa		: INT;
	nDec	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('New_Transaction_Sends_Stop_Again');
fbTx.Begin();
FOR i := 1 TO 50 DO
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
END_FOR
fbTx.Begin();
FOR i := 1 TO 50 DO
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
END_FOR
AssertEquals_INT(Expected := 2, Actual := nHa, Message := 'HA stops sent');
AssertEquals_INT(Expected := 2, Actual := nDec, Message := 'Dec stops sent');
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bActive, Message := 'active again');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cancel_Releases_The_Wait" Id="{a530c6ab-32f3-4658-a413-0103ac1baaed}">
      <Declaration><![CDATA[METHOD PRIVATE Cancel_Releases_The_Wait
VAR
	fbTx	: FB_StopTransaction;
	i		: INT;
	nHa		: INT;
	nDec	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Cancel_Releases_The_Wait');
fbTx.Begin();
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bActive, Message := 'active');
fbTx.Cancel();
AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bActive, Message := 'cancelled');
fbTx(bHaStandStill := TRUE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
fbTx(bHaStandStill := TRUE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bFinished, Message := 'finished at rest');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Without_Begin_Finishes_When_At_Rest" Id="{5eadadcf-aef8-4cf4-80a6-d5b2277b4355}">
      <Declaration><![CDATA[METHOD PRIVATE Without_Begin_Finishes_When_At_Rest
VAR
	fbTx	: FB_StopTransaction;
	i		: INT;
	nHa		: INT;
	nDec	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Without_Begin_Finishes_When_At_Rest');
// no transaction (as before #98): one stop per axis, finished as soon as the telescope is at rest
FOR i := 1 TO 50 DO
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
END_FOR
AssertEquals_INT(Expected := 1, Actual := nHa, Message := 'HA stops sent');
AssertEquals_INT(Expected := 1, Actual := nDec, Message := 'Dec stops sent');
AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bFinished, Message := 'moving');
fbTx(bHaStandStill := TRUE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
fbTx(bHaStandStill := TRUE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bFinished, Message := 'at rest');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Not_Settled_While_Homing_Runs" Id="{80e3f06f-66c9-4b67-b947-b459afe274ff}">
      <Declaration><![CDATA[METHOD PRIVATE Not_Settled_While_Homing_Runs
VAR
	fbTx	: FB_StopTransaction;
	i		: INT;
	nHa		: INT;
	nDec	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Not_Settled_While_Homing_Runs');
// #113: a calibration sweep that is still being aborted keeps the transaction open
fbTx.Begin();
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := TRUE, bDecStopDone := TRUE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
FOR i := 1 TO 20 DO
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := TRUE, bDecHoming := FALSE);
END_FOR
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bActive, Message := 'HA homing still busy');
FOR i := 1 TO 20 DO
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := TRUE);
END_FOR
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bActive, Message := 'Dec homing still busy');
FOR i := 1 TO 3 DO
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
END_FOR
AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bActive, Message := 'settled when the homing is idle');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Homing_Abort_After_Lock_Settles" Id="{a56077e7-1c6c-4b24-ab98-cfe74ea651a5}">
      <Declaration><![CDATA[METHOD PRIVATE Homing_Abort_After_Lock_Settles
VAR
	fbTx	: FB_StopTransaction;
	i		: INT;
	nHa		: INT;
	nDec	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Homing_Abort_After_Lock_Settles');
// #113: stop in the sweep, the homing is aborted after the lock has cleared, only then the transaction ends
fbTx.Begin();
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := TRUE, bDecStopDone := TRUE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := TRUE, bDecHoming := TRUE);
FOR i := 1 TO 5 DO
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := TRUE, bDecHoming := TRUE);
END_FOR
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bActive, Message := 'abort running');
FOR i := 1 TO 3 DO
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
END_FOR
AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bActive, Message := 'abort done, settled');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Outputs_Are_One_Scan_Pulses" Id="{120a66d6-8bd3-427e-aa6b-7c253aee6c69}">
      <Declaration><![CDATA[METHOD PRIVATE Outputs_Are_One_Scan_Pulses
VAR
	fbTx	: FB_StopTransaction;
	i		: INT;
	nHa		: INT;
	nDec	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Outputs_Are_One_Scan_Pulses');
fbTx.Begin();
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
IF fbTx.bStopHa THEN nHa := nHa + 1; END_IF
IF fbTx.bStopDec THEN nDec := nDec + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bStopHa, Message := 'first scan: bStopHa');
fbTx(bHaStandStill := FALSE, bDecStandStill := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bStopHa, Message := 'second scan: bStopHa');
AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bStopDec, Message := 'second scan: bStopDec');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Timeout_Releases_A_Stop_Without_Done_When_At_Rest" Id="{8c2fd188-0171-4f6d-b18a-d66f1ff66556}">
      <Declaration><![CDATA[// #120: HA is sent its stop and never reports Done, the telescope is at rest: after the timeout the transaction settles once, with no second stop.
METHOD PRIVATE Timeout_Releases_A_Stop_Without_Done_When_At_Rest
VAR_INST
	fbTx			: FB_StopTransaction;
	nCycles			: UINT;
	nStops			: INT;
	nTimedOut		: INT;
	nReleased		: INT;
	nTimeoutCycle	: UINT;
	nReleaseCycle	: UINT;
	nAfter			: UINT;
	bActiveBefore	: BOOL;
	bActiveHeld		: BOOL;
	bStarted		: BOOL;
	bFinished		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Timeout_Releases_A_Stop_Without_Done_When_At_Rest');
IF bFinished THEN
	RETURN;
END_IF
IF NOT bStarted THEN
	fbTx.nTimeDivisor := 1000;	// 30 s are 30 ms: a few PLC cycles
	fbTx.Begin();
	bStarted := TRUE;
END_IF
nCycles := nCycles + 1;
fbTx(bHaStandStill := FALSE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nStops := nStops + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
IF fbTx.bTimedOut THEN nTimedOut := nTimedOut + 1; nTimeoutCycle := nCycles; END_IF
IF fbTx.bReleasedByTimeout THEN nReleased := nReleased + 1; nReleaseCycle := nCycles; END_IF
IF nCycles = 1 THEN
	bActiveBefore := fbTx.bActive;
END_IF
IF nReleased > 0 THEN
	nAfter := nAfter + 1;
END_IF
IF nAfter >= 20 THEN
	AssertEquals_BOOL(Expected := TRUE, Actual := bActiveBefore, Message := 'active before the timeout');
	AssertEquals_INT(Expected := 1, Actual := nStops, Message := 'HA stops sent');
	AssertEquals_INT(Expected := 1, Actual := nTimedOut, Message := 'bTimedOut pulses');
	AssertEquals_INT(Expected := 1, Actual := nReleased, Message := 'bReleasedByTimeout pulses');
	AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bActive, Message := 'settled by the timeout');
	AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bHaNoDone, Message := 'HA had no Done');
	AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bDecNoDone, Message := 'Dec was not stopped');
	bFinished := TRUE;
	TEST_FINISHED();
END_IF
IF nCycles > 3000 THEN
	AssertTrue(Condition := FALSE, Message := 'the transaction never timed out');
	bFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Timeout_Does_Not_Release_While_The_Axes_Move" Id="{da747fc0-3328-4fda-8eaf-1c85717f5945}">
      <Declaration><![CDATA[// #120: at the timeout the axes still move: nothing is released; the transaction settles without Done once they are at rest.
METHOD PRIVATE Timeout_Does_Not_Release_While_The_Axes_Move
VAR_INST
	fbTx			: FB_StopTransaction;
	nCycles			: UINT;
	nStops			: INT;
	nTimedOut		: INT;
	nReleased		: INT;
	nTimeoutCycle	: UINT;
	nReleaseCycle	: UINT;
	nAfter			: UINT;
	bActiveBefore	: BOOL;
	bActiveHeld		: BOOL;
	bStarted		: BOOL;
	bFinished		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Timeout_Does_Not_Release_While_The_Axes_Move');
IF bFinished THEN
	RETURN;
END_IF
IF NOT bStarted THEN
	fbTx.nTimeDivisor := 1000;	// 30 s are 30 ms: a few PLC cycles
	fbTx.Begin();
	bStarted := TRUE;
END_IF
nCycles := nCycles + 1;
fbTx(bHaStandStill := FALSE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nStops := nStops + 1; END_IF
fbTx.Monitor(bStopped := (nTimeoutCycle > 0 AND nCycles >= nTimeoutCycle + 20), bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
IF fbTx.bTimedOut THEN nTimedOut := nTimedOut + 1; nTimeoutCycle := nCycles; END_IF
IF fbTx.bReleasedByTimeout THEN nReleased := nReleased + 1; nReleaseCycle := nCycles; END_IF
IF nTimeoutCycle > 0 AND nCycles = nTimeoutCycle + 10 THEN
	bActiveHeld := fbTx.bActive AND nReleased = 0;
END_IF
IF nReleased > 0 THEN
	AssertEquals_BOOL(Expected := TRUE, Actual := bActiveHeld, Message := 'held while moving');
	AssertTrue(Condition := nReleaseCycle >= nTimeoutCycle + 20 + 0, Message := 'released only after the condition ended');
	AssertEquals_INT(Expected := 1, Actual := nStops, Message := 'HA stops sent');
	bFinished := TRUE;
	TEST_FINISHED();
END_IF
IF nCycles > 3000 THEN
	AssertTrue(Condition := FALSE, Message := 'the transaction never timed out');
	bFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Timeout_Does_Not_Release_While_Locked" Id="{0931f10a-5d7a-4acf-81f7-2953b9fdf96c}">
      <Declaration><![CDATA[// #120: an axis is locked (MC_Stop active, StateDWord bit 29) at the timeout: held until the lock has been clear for 3 scans.
METHOD PRIVATE Timeout_Does_Not_Release_While_Locked
VAR_INST
	fbTx			: FB_StopTransaction;
	nCycles			: UINT;
	nStops			: INT;
	nTimedOut		: INT;
	nReleased		: INT;
	nTimeoutCycle	: UINT;
	nReleaseCycle	: UINT;
	nAfter			: UINT;
	bActiveBefore	: BOOL;
	bActiveHeld		: BOOL;
	bStarted		: BOOL;
	bFinished		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Timeout_Does_Not_Release_While_Locked');
IF bFinished THEN
	RETURN;
END_IF
IF NOT bStarted THEN
	fbTx.nTimeDivisor := 1000;	// 30 s are 30 ms: a few PLC cycles
	fbTx.Begin();
	bStarted := TRUE;
END_IF
nCycles := nCycles + 1;
fbTx(bHaStandStill := FALSE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nStops := nStops + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := NOT (nTimeoutCycle > 0 AND nCycles >= nTimeoutCycle + 20), bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
IF fbTx.bTimedOut THEN nTimedOut := nTimedOut + 1; nTimeoutCycle := nCycles; END_IF
IF fbTx.bReleasedByTimeout THEN nReleased := nReleased + 1; nReleaseCycle := nCycles; END_IF
IF nTimeoutCycle > 0 AND nCycles = nTimeoutCycle + 10 THEN
	bActiveHeld := fbTx.bActive AND nReleased = 0;
END_IF
IF nReleased > 0 THEN
	AssertEquals_BOOL(Expected := TRUE, Actual := bActiveHeld, Message := 'held while locked');
	AssertTrue(Condition := nReleaseCycle >= nTimeoutCycle + 20 + 2, Message := 'released only after the condition ended');
	AssertEquals_INT(Expected := 1, Actual := nStops, Message := 'HA stops sent');
	bFinished := TRUE;
	TEST_FINISHED();
END_IF
IF nCycles > 3000 THEN
	AssertTrue(Condition := FALSE, Message := 'the transaction never timed out');
	bFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Timeout_Does_Not_Release_While_Homing" Id="{43429099-2f83-4175-8a1f-35147aa45521}">
      <Declaration><![CDATA[// #113/#120: the calibration sweep is still aborting at the timeout: held until it ends.
METHOD PRIVATE Timeout_Does_Not_Release_While_Homing
VAR_INST
	fbTx			: FB_StopTransaction;
	nCycles			: UINT;
	nStops			: INT;
	nTimedOut		: INT;
	nReleased		: INT;
	nTimeoutCycle	: UINT;
	nReleaseCycle	: UINT;
	nAfter			: UINT;
	bActiveBefore	: BOOL;
	bActiveHeld		: BOOL;
	bStarted		: BOOL;
	bFinished		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Timeout_Does_Not_Release_While_Homing');
IF bFinished THEN
	RETURN;
END_IF
IF NOT bStarted THEN
	fbTx.nTimeDivisor := 1000;	// 30 s are 30 ms: a few PLC cycles
	fbTx.Begin();
	bStarted := TRUE;
END_IF
nCycles := nCycles + 1;
fbTx(bHaStandStill := FALSE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nStops := nStops + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := NOT (nTimeoutCycle > 0 AND nCycles >= nTimeoutCycle + 20), bDecHoming := FALSE);
IF fbTx.bTimedOut THEN nTimedOut := nTimedOut + 1; nTimeoutCycle := nCycles; END_IF
IF fbTx.bReleasedByTimeout THEN nReleased := nReleased + 1; nReleaseCycle := nCycles; END_IF
IF nTimeoutCycle > 0 AND nCycles = nTimeoutCycle + 10 THEN
	bActiveHeld := fbTx.bActive AND nReleased = 0;
END_IF
IF nReleased > 0 THEN
	AssertEquals_BOOL(Expected := TRUE, Actual := bActiveHeld, Message := 'held while homing');
	AssertTrue(Condition := nReleaseCycle >= nTimeoutCycle + 20 + 0, Message := 'released only after the condition ended');
	AssertEquals_INT(Expected := 1, Actual := nStops, Message := 'HA stops sent');
	bFinished := TRUE;
	TEST_FINISHED();
END_IF
IF nCycles > 3000 THEN
	AssertTrue(Condition := FALSE, Message := 'the transaction never timed out');
	bFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cancel_Stops_The_Timeout_And_Begin_Restarts_It" Id="{cddb105c-948e-4b77-a0f4-dea33f1ead58}">
      <Declaration><![CDATA[// #120: a cancelled transaction never times out; a new Begin() starts the 30 s again.
METHOD PRIVATE Cancel_Stops_The_Timeout_And_Begin_Restarts_It
VAR_INST
	fbTx			: FB_StopTransaction;
	nCycles			: UINT;
	nStops			: INT;
	nTimedOut		: INT;
	nReleased		: INT;
	nTimeoutCycle	: UINT;
	nReleaseCycle	: UINT;
	nAfter			: UINT;
	bActiveBefore	: BOOL;
	bActiveHeld		: BOOL;
	bStarted		: BOOL;
	bFinished		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Cancel_Stops_The_Timeout_And_Begin_Restarts_It');
IF bFinished THEN
	RETURN;
END_IF
IF NOT bStarted THEN
	fbTx.nTimeDivisor := 1000;	// 30 s are 30 ms: a few PLC cycles
	fbTx.Begin();
	bStarted := TRUE;
END_IF
nCycles := nCycles + 1;
IF nCycles <= 5 THEN
fbTx(bHaStandStill := FALSE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nStops := nStops + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
IF fbTx.bTimedOut THEN nTimedOut := nTimedOut + 1; nTimeoutCycle := nCycles; END_IF
IF fbTx.bReleasedByTimeout THEN nReleased := nReleased + 1; nReleaseCycle := nCycles; END_IF
ELSIF nCycles = 6 THEN
	fbTx.Cancel();
	AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bActive, Message := 'cancelled');
ELSIF nCycles <= 300 THEN
fbTx(bHaStandStill := FALSE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nStops := nStops + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
IF fbTx.bTimedOut THEN nTimedOut := nTimedOut + 1; nTimeoutCycle := nCycles; END_IF
IF fbTx.bReleasedByTimeout THEN nReleased := nReleased + 1; nReleaseCycle := nCycles; END_IF
	AssertEquals_INT(Expected := 0, Actual := nTimedOut, Message := 'no timeout after Cancel');
ELSIF nCycles = 301 THEN
	fbTx.Begin();
ELSE
fbTx(bHaStandStill := FALSE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nStops := nStops + 1; END_IF
fbTx.Monitor(bStopped := FALSE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := FALSE, bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
IF fbTx.bTimedOut THEN nTimedOut := nTimedOut + 1; nTimeoutCycle := nCycles; END_IF
IF fbTx.bReleasedByTimeout THEN nReleased := nReleased + 1; nReleaseCycle := nCycles; END_IF
	IF nTimedOut > 0 THEN
		AssertEquals_INT(Expected := 1, Actual := nTimedOut, Message := 'timeout after the new Begin');
		AssertEquals_BOOL(Expected := TRUE, Actual := fbTx.bHaNoDone, Message := 'HA had no Done');
		bFinished := TRUE;
		TEST_FINISHED();
	END_IF
END_IF
IF nCycles > 6000 THEN
	AssertTrue(Condition := FALSE, Message := 'the transaction never timed out');
	bFinished := TRUE;
	TEST_FINISHED();
	RETURN;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Settled_Transaction_Does_Not_Time_Out" Id="{eb475260-55d0-4a67-96bc-b6dfdfdf25f1}">
      <Declaration><![CDATA[// #120: a stop that reports Done in time settles normally and never raises the timeout.
METHOD PRIVATE Settled_Transaction_Does_Not_Time_Out
VAR_INST
	fbTx			: FB_StopTransaction;
	nCycles			: UINT;
	nStops			: INT;
	nTimedOut		: INT;
	nReleased		: INT;
	nTimeoutCycle	: UINT;
	nReleaseCycle	: UINT;
	nAfter			: UINT;
	bActiveBefore	: BOOL;
	bActiveHeld		: BOOL;
	bStarted		: BOOL;
	bFinished		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Settled_Transaction_Does_Not_Time_Out');
IF bFinished THEN
	RETURN;
END_IF
IF NOT bStarted THEN
	fbTx.nTimeDivisor := 1000;	// 30 s are 30 ms: a few PLC cycles
	fbTx.Begin();
	bStarted := TRUE;
END_IF
nCycles := nCycles + 1;
fbTx(bHaStandStill := FALSE, bDecStandStill := TRUE);
IF fbTx.bStopHa THEN nStops := nStops + 1; END_IF
fbTx.Monitor(bStopped := TRUE, bHaEnabled := TRUE, bDecEnabled := TRUE,
		bHaStopDone := (nCycles = 2), bDecStopDone := FALSE, bHaLocked := FALSE, bDecLocked := FALSE,
		bHaHoming := FALSE, bDecHoming := FALSE);
IF fbTx.bTimedOut THEN nTimedOut := nTimedOut + 1; nTimeoutCycle := nCycles; END_IF
IF fbTx.bReleasedByTimeout THEN nReleased := nReleased + 1; nReleaseCycle := nCycles; END_IF
IF nCycles > 300 THEN
	AssertEquals_BOOL(Expected := FALSE, Actual := fbTx.bActive, Message := 'settled with the Done');
	AssertEquals_INT(Expected := 0, Actual := nTimedOut, Message := 'no timeout');
	AssertEquals_INT(Expected := 0, Actual := nReleased, Message := 'not released by the timeout');
	bFinished := TRUE;
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
