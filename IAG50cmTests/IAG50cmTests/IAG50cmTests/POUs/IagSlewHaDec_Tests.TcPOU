<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="IagSlewHaDec_Tests" Id="{3c8e5a17-92b4-4d06-8f1a-6e07d4b2c951}" SpecialFunc="None">
    <Declaration><![CDATA[// SlewHaDec (I_RaDecTelescope, BROTLib 0.26.0 X5) of FB_TelescopeControl on the mock rig (FB_IagRig). Same shape as IagStopDuringSlew_Tests:
// every test owns a rig and runs over many PLC cycles, the first ones wait for the astronomical clock; a step that does not
// happen within its cycle budget fails the test with a message instead of hanging the run.
// Not covered here: the NC motion itself and the pointing model applied to the HA/Dec target (the mock axes jump to the
// commanded position, and the rig has no pointing model data): the real move is an on-site check (IAG50cm).
FUNCTION_BLOCK IagSlewHaDec_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SlewHaDec_Moves_Both_Axes_Without_Tracking();
SlewHaDec_Out_Of_Range_Is_Refused();
SlewHaDec_While_Parked_Is_Rejected();
Slew_After_SlewHaDec_Uses_Az_Alt();
Slew_Az_Alt_Target_Is_In_One_Frame();
]]></ST>
    </Implementation>
    <Method Name="SlewHaDec_Moves_Both_Axes_Without_Tracking" Id="{a7d14e92-5b3c-4f68-9c20-d8e316b75a04}">
      <Declaration><![CDATA[// SlewHaDec(15, 30): the command is accepted, the slew targets are the commanded hour angle and declination (not derived from
// Az/Alt), both axes move there and the telescope is not tracking afterwards. HA 15 / Dec 30 is 66 deg above the horizon at the site.
METHOD PRIVATE SlewHaDec_Moves_Both_Axes_Without_Tracking
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bAccepted	: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('SlewHaDec_Moves_Both_Axes_Without_Tracking');
sTest := 'SlewHaDec_Moves_Both_Axes_Without_Tracking: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0), then slew
	IF rig.Online THEN
		bAccepted := rig.fbTel.SlewHaDec(fHourAngle := 15.0, fDeclination := 30.0);
		AssertTrue(Condition := bAccepted, Message := 'SlewHaDec is accepted when the telescope is online');
		F_Note(bFailed := NOT bAccepted, sText := CONCAT(sTest, 'SlewHaDec is accepted when the telescope is online'));
		AssertTrue(Condition := rig.fbTel.bSlewActive, Message := 'the slew is latched');
		F_Note(bFailed := NOT rig.fbTel.bSlewActive, sText := CONCAT(sTest, 'the slew is latched'));
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// the slew moves one axis at a time (stages 30..33 / 40..43): the targets are the commanded ones
	IF nCycles >= 3 THEN
		AssertFalse(Condition := F_NoteNear(CONCAT(sTest, 'target hour angle'), 15.0, rig.fbTel.fHourAngleCalc, 0.001), Message := 'target hour angle is the commanded one');
		AssertFalse(Condition := F_NoteNear(CONCAT(sTest, 'target declination'), 30.0, rig.fbTel.fDeclinationCalc, 0.001), Message := 'target declination is the commanded one');
		AssertTrue(Condition := rig.fbTel.fElevation > 60.0 AND rig.fbTel.fElevation < 72.0, Message := 'the horizontal coordinates follow the HA/Dec target (alt about 66 deg)');
		F_Note(bFailed := NOT (rig.fbTel.fElevation > 60.0 AND rig.fbTel.fElevation < 72.0), sText := CONCAT(sTest, 'the horizontal coordinates follow the HA/Dec target (alt about 66 deg)'));
		nStep := 30;
		nCycles := 0;
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew target was not set');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew target was not set'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
30:	// wait until the slew is done and the telescope is at rest
	IF nCycles > 5 AND NOT rig.fbTel.bSlewActive AND rig.fbTel.bStopped THEN
		AssertFalse(Condition := F_NoteNear(CONCAT(sTest, 'hour angle axis'), 15.0, rig.fbHa.ActualPosition, 3.0), Message := 'the hour angle axis is at the target');
		AssertFalse(Condition := F_NoteNear(CONCAT(sTest, 'declination axis'), 30.0, rig.fbDec.ActualPosition, 3.0), Message := 'the declination axis is at the target');
		AssertTrue(Condition := NOT rig.fbTel.bTrackActive, Message := 'no tracking afterwards');
		F_Note(bFailed := NOT (NOT rig.fbTel.bTrackActive), sText := CONCAT(sTest, 'no tracking afterwards'));
		AssertTrue(Condition := NOT rig.fbHa.Tracking AND NOT rig.fbDec.Tracking, Message := 'the axes do not track');
		F_Note(bFailed := NOT (NOT rig.fbHa.Tracking AND NOT rig.fbDec.Tracking), sText := CONCAT(sTest, 'the axes do not track'));
		AssertTrue(Condition := NOT rig.fbTel.bError AND NOT rig.fbTel.bSoftwareError, Message := 'no error');
		F_Note(bFailed := NOT (NOT rig.fbTel.bError AND NOT rig.fbTel.bSoftwareError), sText := CONCAT(sTest, 'no error'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1200 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew did not finish');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew did not finish'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="SlewHaDec_Out_Of_Range_Is_Refused" Id="{0e5b82d3-6f17-4a49-b3c8-47a9d12e6f80}">
      <Declaration><![CDATA[// A declination above 90 deg is no coordinate: refused, nothing latched, nothing written, and not counted as a rejected command
// (it is not a state conflict). A valid target right after it is accepted again.
METHOD PRIVATE SlewHaDec_Out_Of_Range_Is_Refused
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bAccepted	: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('SlewHaDec_Out_Of_Range_Is_Refused');
sTest := 'SlewHaDec_Out_Of_Range_Is_Refused: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished (READY_STATE 1.0)
	IF rig.Online THEN
		bAccepted := rig.fbTel.SlewHaDec(fHourAngle := 10.0, fDeclination := 95.0);
		AssertFalse(Condition := bAccepted, Message := 'declination 95 is refused');
		F_Note(bFailed := bAccepted, sText := CONCAT(sTest, 'declination 95 is refused'));
		bAccepted := rig.fbTel.SlewHaDec(fHourAngle := 400.0, fDeclination := 30.0);
		AssertFalse(Condition := bAccepted, Message := 'hour angle 400 is refused');
		F_Note(bFailed := bAccepted, sText := CONCAT(sTest, 'hour angle 400 is refused'));
		AssertTrue(Condition := NOT rig.fbTel.bSlewActive, Message := 'nothing is latched');
		F_Note(bFailed := NOT (NOT rig.fbTel.bSlewActive), sText := CONCAT(sTest, 'nothing is latched'));
		AssertEquals_UDINT(Expected := 0, Actual := rig.fbTel.nCommandRejectCount, Message := 'an invalid target is not a rejected command');
		F_Note(bFailed := rig.fbTel.nCommandRejectCount <> 0, sText := CONCAT(sTest, 'an invalid target is not a rejected command'));
		bAccepted := rig.fbTel.SlewHaDec(fHourAngle := 10.0, fDeclination := 30.0);
		AssertTrue(Condition := bAccepted, Message := 'a valid target is accepted afterwards');
		F_Note(bFailed := NOT bAccepted, sText := CONCAT(sTest, 'a valid target is accepted afterwards'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="SlewHaDec_While_Parked_Is_Rejected" Id="{5f90c3a6-d2e8-4b17-8a54-93c1e07b6d28}">
      <Declaration><![CDATA[// Like Slew(): a SlewHaDec while the telescope has not been powered on (not ready) is rejected by the acceptance table, counted,
// and writes nothing.
METHOD PRIVATE SlewHaDec_While_Parked_Is_Rejected
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bAccepted	: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('SlewHaDec_While_Parked_Is_Rejected');
sTest := 'SlewHaDec_While_Parked_Is_Rejected: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock; no power-on
	IF rig.ClockValid THEN
		bAccepted := rig.fbTel.SlewHaDec(fHourAngle := 15.0, fDeclination := 30.0);
		AssertFalse(Condition := bAccepted, Message := 'SlewHaDec is refused while the telescope is not powered on');
		F_Note(bFailed := bAccepted, sText := CONCAT(sTest, 'SlewHaDec is refused while the telescope is not powered on'));
		AssertEquals_UDINT(Expected := 1, Actual := rig.fbTel.nCommandRejectCount, Message := 'the command was rejected and counted');
		F_Note(bFailed := rig.fbTel.nCommandRejectCount <> 1, sText := CONCAT(sTest, 'the command was rejected and counted'));
		AssertTrue(Condition := NOT rig.fbTel.bSlewActive, Message := 'no slew was latched');
		F_Note(bFailed := NOT (NOT rig.fbTel.bSlewActive), sText := CONCAT(sTest, 'no slew was latched'));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slew_After_SlewHaDec_Uses_Az_Alt" Id="{b46d8e1f-37a0-4c52-9e6b-0d58f2a1c973}">
      <Declaration><![CDATA[// A Slew(az, alt) that replaces a running SlewHaDec goes back to the Az/Alt target: the coordinates of the HA/Dec slew do not stick.
// The slew target az 180 / alt 45 is on the meridian: hour angle about 0, declination about latitude - 45 = 6.56 deg.
METHOD PRIVATE Slew_After_SlewHaDec_Uses_Az_Alt
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_After_SlewHaDec_Uses_Az_Alt');
sTest := 'Slew_After_SlewHaDec_Uses_Az_Alt: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished, then an HA/Dec slew followed by an Az/Alt slew in the next scan
	IF rig.Online THEN
		rig.fbTel.SlewHaDec(fHourAngle := 15.0, fDeclination := 30.0);
		nStep := 15;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
15:
	IF nCycles >= 2 THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 45.0);
		AssertFalse(Condition := rig.fbTel.bSlewHaDec, Message := 'an Az/Alt slew clears the HA/Dec slew');
		F_Note(bFailed := rig.fbTel.bSlewHaDec, sText := CONCAT(sTest, 'an Az/Alt slew clears the HA/Dec slew'));
		nStep := 20;
		nCycles := 0;
	END_IF
20:	// the targets are those of az 180 / alt 45
	IF nCycles >= 3 THEN
		AssertFalse(Condition := F_NoteNear(CONCAT(sTest, 'target declination'), 51.5592378 - 45.0, rig.fbTel.fDeclinationCalc, 0.5), Message := 'slew target declination');
		AssertTrue(Condition := COS(rig.fbTel.fHourAngleCalc * 0.017453292519943295) > 0.9999, Message := 'slew target hour angle about 0');
		F_Note(bFailed := NOT (COS(rig.fbTel.fHourAngleCalc * 0.017453292519943295) > 0.9999), sText := CONCAT(sTest, 'slew target hour angle about 0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slew_Az_Alt_Target_Is_In_One_Frame" Id="{c4a9e2b7-5d31-4f86-a1c0-7e2b9d6f3a58}">
      <Declaration><![CDATA[// IAG50cm#239: the Az/Alt slew target. FB_HOR2EQ returns the apparent hour angle but the J2000 declination; the motors are driven in
// apparent HA/Dec, so the declination used for the axes must be the apparent one: the goto coordinates written by the slew (ICRS)
// converted back to apparent HA/Dec give the target of the axes. Before the fix the two declinations differed by about 0.05 deg
// (precession and nutation), which showed up as +0.054 deg in the published altitude at Az 180.
METHOD PRIVATE Slew_Az_Alt_Target_Is_In_One_Frame
VAR_INST
	rig			: FB_IagRig;
	nStep		: INT;
	nCycles		: UINT;
	bAccepted	: BOOL;
	sTest		: STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_Az_Alt_Target_Is_In_One_Frame');
sTest := 'Slew_Az_Alt_Target_Is_In_One_Frame: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
nCycles := nCycles + 1;
CASE nStep OF
0:	// wait for the clock, then power on
	IF rig.ClockValid THEN
		rig.fbTel.Init();
		nStep := 10;
		nCycles := 0;
	ELSIF nCycles > 2000 THEN
		AssertTrue(Condition := FALSE, Message := 'the astronomical clock never became valid');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the astronomical clock never became valid'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
10:	// wait until the startup has finished, then slew to azimuth 180, elevation 60
	IF rig.Online THEN
		rig.fbTel.Slew(fAzimuth := 180.0, fAltitude := 60.0);
		nStep := 20;
		nCycles := 0;
	ELSIF nCycles > 1500 THEN
		AssertTrue(Condition := FALSE, Message := 'the mock telescope did not reach READY_STATE 1.0');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the mock telescope did not reach READY_STATE 1.0'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:	// an axis is moving: the goto coordinates of the slew are set, so the apparent position derived from them is the axes' target
	IF nCycles >= 3 THEN
		AssertFalse(Condition := F_NoteNear(CONCAT(sTest, 'declination of the axes target is the apparent one'), rig.fbTel.fDeclinationApparent, rig.fbTel.fDeclinationCalc, 0.001), Message := 'the axes declination is the apparent declination of the target');
		AssertFalse(Condition := F_NoteNear(CONCAT(sTest, 'hour angle of the axes target is the apparent one'), rig.fbTel.fHourAngleApparent, rig.fbTel.fHourAngleCalc, 0.001), Message := 'the axes hour angle is the apparent hour angle of the target');
		AssertTrue(Condition := ABS(rig.fbTel.fDeclination - rig.fbTel.fDeclinationCalc) > 0.01, Message := 'the goto declination stays the ICRS one (it differs from the apparent one by precession and nutation)');
		F_Note(bFailed := NOT (ABS(rig.fbTel.fDeclination - rig.fbTel.fDeclinationCalc) > 0.01), sText := CONCAT(sTest, CONCAT('the goto declination stays the ICRS one: goto ', CONCAT(LREAL_TO_STRING(rig.fbTel.fDeclination), CONCAT(', axes ', CONCAT(LREAL_TO_STRING(rig.fbTel.fDeclinationCalc), CONCAT(', apparent from goto ', CONCAT(LREAL_TO_STRING(rig.fbTel.fDeclinationApparent), CONCAT(', slew active ', BOOL_TO_STRING(rig.fbTel.bSlewActive))))))))));
		nStep := 99;
		TEST_FINISHED();
	ELSIF nCycles > 300 THEN
		AssertTrue(Condition := FALSE, Message := 'the slew target was not set');
		F_Note(bFailed := TRUE, sText := CONCAT(sTest, 'the slew target was not set'));
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
