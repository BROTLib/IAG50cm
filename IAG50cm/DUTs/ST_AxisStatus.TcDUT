<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_AxisStatus" Id="{0ba36911-1a20-4e9a-934a-0d8c6630bedc}">
    <Declaration><![CDATA[// Plan step 3.2: the feedback of one axis (FB_Axis outputs) as read once per scan by FB_TelescopeControl._ReadAxes. Same struct as
// MONETcommon's (it moves to BROTLib in step 4). The axes' outputs do not change while the telescope body runs, so reading them into
// one struct is the same as reading fbAxis.* at every use.
TYPE ST_AxisStatus :
STRUCT
	bStandStill		: BOOL;
	bStopDone		: BOOL;
	bInMotion		: BOOL;
	bInRamp			: BOOL;
	bHoming			: BOOL;
	bStopping		: BOOL;
	bBusy			: BOOL;
	bTracking		: BOOL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>