<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_PointingCoefficients" Id="{604902ed-ff6b-4796-9a50-6cd03d5ad8c4}">
    <Declaration><![CDATA[// The coefficients of FB_PointingModelForward in degrees (tau = hour angle, dec = declination). Two sets live in
// GVL_Pointing, one per E_RefractionMode (IAG50cm#7).
TYPE ST_PointingCoefficients :
STRUCT
	C_mAl_tau	: LREAL;
	C_mEl_tau	: LREAL;
	C_Coll_tau	: LREAL;
	C_Refr_tau	: LREAL;
	C_Enc_tau	: LREAL;
	C_Flex_tau	: LREAL;
	C_NP_tau	: LREAL;

	C_mAl_dec	: LREAL;
	C_mEl_dec	: LREAL;
	C_Coll_dec	: LREAL;
	C_Refr_dec	: LREAL;
	C_Flex_dec	: LREAL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>