<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_HourAngleControl" Id="{69217813-d219-4ca2-9cea-b7c641aa5dcd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HourAngleControl EXTENDS FB_AxisControl
VAR_INPUT
	fMinPosition : LREAL := -180.0;
	fMaxPosition : LREAL := 180.0;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	bAxisError	: BOOL;
	bLatchHomeError	: BOOL;
	nAxisErrorID : UDINT;
	nLatchHomeErrorID: UDINT;
	bLatchHomeErrorHeld	: BOOL;		// #69: the homing error, held until the axis reset
	nLatchHomeErrorIDHeld : UDINT;
	fbLatchHome : FB_LatchHome;
	fbHomeHold : FB_HomeHold;		// #113: no homing request after a stop of the axis
	bResetForAbort : BOOL;		// #113: the reset was asked for by FB_LatchHome to end a homing, it must not release the hold
	omega 	: LREAL := 360.0 / 86164.099 * (PI/180.0); //sidereal velocity
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// limit to sane positions
fPosition := LIMIT(fMinPosition, fPosition, fMaxPosition);


// #113: a stop during the calibration sweep must not be followed by a new homing request (bHomeAxis was set again every
// scan while the axis is enabled and uncalibrated, so FB_LatchHome went on commanding the NC while MC_Stop held the lock)
// #113: FB_LatchHome asks for a reset when MC_AbortHoming cannot end a running step. That reset must not release the hold
// (the sweep would start again); the hold ends with the disable that FB_SweepStop does after the stop.
IF fbLatchHome.ResetRequest THEN
	bReset := TRUE;
	bResetForAbort := TRUE;
END_IF
IF NOT bEnable THEN
	bResetForAbort := FALSE;
END_IF
fbHomeHold(bEnable := bEnable, bCalibrated := fbAxis.Calibrated, bHoming := bHomeAxis, bStopAxis := bStopAxis, bReset := bReset AND NOT bResetForAbort);

// #155: not before the NC axis is enabled. After a stop and a reset the NC needs about 140 ms; a start taken in the
// first scan runs the reference step on a disabled axis, it ends in the abort state and nothing starts it again.
IF bEnable AND fbAxis.Ready AND NOT fbAxis.Calibrated AND NOT fbHomeHold.bHold THEN
	bHomeAxis := TRUE;
END_IF

// #155: the request used to survive a disable. After the next enable it was already TRUE, so FB_LatchHome saw no rising
// edge and the sweep never started.
IF fbAxis.Calibrated OR fbHomeHold.bHold OR NOT bEnable THEN
	bHomeAxis := FALSE;
END_IF

IF bHomeAxis THEN
	fPosition := fPosition;
END_IF

fbAxis(
	enable 			:= bEnable,
	Reset 			:= bReset,
	Tracking 		:= bTracking,
	HomingMode 		:= MC_ForceCalibration,
	Position 		:= fPosition, 
	Velocity 		:= fVelocity,
	TrackVelocityRef	:= omega,
	TrackDirectionRef:=0,
	Enable_Positive := NOT axisRef.Status.SoftLimitMaxExceeded,
	Enable_Negative := NOT axisRef.Status.SoftLimitMinExceeded,
	Jog_Forward 	:= bMovePos,
	Jog_Backwards 	:= bMoveNeg,
	ActualPosition 	=> fActualPosition,
	Error 			=> bAxisError,
	ErrorID 		=> nAxisErrorID,
	AxisRef 		:= axisRef);

// #100: follow the NC in both directions. The flag used to be set only while the axis was calibrated, so it stayed
// TRUE after the NC dropped Homed and the power-on and bHomed trusted it.
bCalibrated := fbAxis.Calibrated;

fbLatchHome(
	Axis				:= AxisRef,
	Execute				:= bHomeAxis,
	Reset				:= bReset,	// #155
	StopActive			:= bStopAxis OR ((axisRef.NcToPlc.StateDWord AND 16#20000000) <> 0),	// #113
	Direction 			:= MC_Home_Direction.mcPositiveDirection,
	Velocity 			:= 1.0,
	Acceleration		:= 3.6,
	Deceleration		:= 3.6,
	Jerk				:= 3.6,
	RefPosition			:= 1.56-0.04019852332911753,
	RefDistance			:= 5.21,
	TimeLimit 			:= T#1M,
	DistanceLimit 		:= 6,
	Error 				=> bLatchHomeError,
	ErrorID 			=> nLatchHomeErrorID);
	

// #69: FB_LatchHome clears its error as soon as Execute falls, and Execute falls on bError, so the error lasted
// one scan: the power-on was aborted, bError was FALSE again and no reset could fire. Hold it until the axis reset.
IF bReset THEN
	bLatchHomeErrorHeld := FALSE;
	nLatchHomeErrorIDHeld := 0;
END_IF
IF bLatchHomeError THEN
	bLatchHomeErrorHeld := TRUE;
	nLatchHomeErrorIDHeld := nLatchHomeErrorID;
END_IF

bError := bLatchHomeErrorHeld OR bAxisError;

// nErrorID is the current error: it used to keep stale values, so healthy axes were reset on every reset pass
IF bAxisError THEN
	nErrorID := nAxisErrorID;
ELSIF bLatchHomeErrorHeld THEN
	nErrorID := nLatchHomeErrorIDHeld;
ELSE
	nErrorID := 0;
END_IF
	
IF fbAxis.MoveDone OR bReset OR bError THEN
	bMoveAxis := FALSE;
END_IF

IF (fbAxis.HomeDone AND fbLatchHome.Done) OR bReset OR bError THEN
	bHomeAxis := FALSE;
END_IF
	
IF fbAxis.ResetDone THEN
	bReset := FALSE;
END_IF

IF fbAxis.StopDone THEN
	bStopAxis := FALSE;
END_IF


bReady := fbAxis.Ready;

fbReadParameter(	
	Axis 			:= axisRef, 
	Enable 			:= fbAxis.InMotion, 
	ParameterNumber := MC_AxisParameter.AxisRemainingTimeToGo, 
	ReadMode 		:= E_ReadMode.READMODE_CYCLIC);
				
IF fbReadParameter.Valid THEN
	fSlewtime := fbReadParameter.Value;
END_IF

IF bSoEReset THEN
	fbSoEReset(
		Axis 	:= axisRef,
		Execute := TRUE,
		Timeout := DEFAULT_ADS_TIMEOUT);
 	IF NOT fbSoEReset.Busy THEN
		fbSoEReset(Axis := axisRef, Execute := FALSE);
		bSoEReset := FALSE;
		bReset := TRUE;
	END_IF
END_IF


axisEvent(	
	Trigger 		:= bError, 
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString	:= 'Hour Angle Axis Error: %s',
	OnMessage 		:= NCError_TO_STRING(nErrorID),
	OffMEssage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	Comm			:= fbComm);
	

CalibrationEvent(	
	Trigger 		:= bCalibrated, 
	Level 			:= ADSLOG_MSGTYPE_HINT,
	OnMessage 		:= 'Hour Angle Axis is calibrated.',
	Comm			:= fbComm);
	
]]></ST>
    </Implementation>
    <Method Name="_StartHoming" Id="{49127acb-016f-424c-afa4-027f11cc41a9}">
      <Declaration><![CDATA[// Homing goes through FB_LatchHome and MC_SetPosition on bHomeAxis (the level), not through fbAxis.Home(), so this
// is empty (abstract in BROTLib's FB_BaseAxis, BROTLib #62).
METHOD _StartHoming : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_StartHoming := TRUE;
]]></ST>
      </Implementation>
    </Method>
