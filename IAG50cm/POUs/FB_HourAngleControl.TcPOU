<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_HourAngleControl" Id="{69217813-d219-4ca2-9cea-b7c641aa5dcd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HourAngleControl EXTENDS FB_AxisControl
VAR_INPUT
	fMinPosition : LREAL := -180.0;
	fMaxPosition : LREAL := 180.0;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	bAxisError	: BOOL;
	bLatchHomeError	: BOOL;
	nAxisErrorID : UDINT;
	nLatchHomeErrorID: UDINT;
	fbLatchHome : FB_LatchHome;
	omega 	: LREAL := 360.0 / 86164.099 * (PI/180.0); //sidereal velocity
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// limit to sane positions
fPosition := LIMIT(fMinPosition, fPosition, fMaxPosition);


IF bEnable AND NOT fbAxis.Calibrated THEN
	bHomeAxis := TRUE;
END_IF

IF fbAxis.Calibrated THEN
	bHomeAxis := FALSE;
	bCalibrated := fbAxis.Calibrated;
END_IF

IF bHomeAxis THEN
	fPosition := fPosition;
END_IF

fbAxis(
	enable 			:= bEnable,
	Reset 			:= bReset,
	MoveAxis 		:= bMoveAxis,
	HomeAxis 		:= FALSE,
	StopAxis 		:= bStopAxis,
	Tracking 		:= bTracking,
	HomingMode 		:= MC_ForceCalibration,
	Position 		:= fPosition, 
	Velocity 		:= fVelocity,
	TrackVelocityRef	:= omega,
	TrackDirectionRef:=0,
	Enable_Positive := NOT axisRef.Status.SoftLimitMaxExceeded,
	Enable_Negative := NOT axisRef.Status.SoftLimitMinExceeded,
	Jog_Forward 	:= bMovePos,
	Jog_Backwards 	:= bMoveNeg,
	ActualPosition 	=> fActualPosition,
	Error 			=> bAxisError,
	ErrorID 		=> nAxisErrorID,
	AxisRef 		:= axisRef);

fbLatchHome(
	Axis				:= AxisRef,
	Execute				:= bHomeAxis,
	Direction 			:= MC_Home_Direction.mcPositiveDirection,
	Velocity 			:= 1.0,
	Acceleration		:= 3.6,
	Deceleration		:= 3.6,
	Jerk				:= 3.6,
	RefPosition			:= 1.56-0.04019852332911753,
	RefDistance			:= 5.21,
	TimeLimit 			:= T#1M,
	DistanceLimit 		:= 6,
	Error 				=> bLatchHomeError,
	ErrorID 			=> nLatchHomeErrorID);
	

bError := bLatchHomeError OR bAxisError;

IF bAxisError THEN
	nErrorID := nAxisErrorID;
ELSIF bLatchHomeError THEN
	nErrorID := nLatchHomeErrorID;
END_IF
	
IF fbAxis.MoveDone OR bReset OR bError THEN
	bMoveAxis := FALSE;
END_IF

IF (fbAxis.HomeDone AND fbLatchHome.Done) OR bReset OR bError THEN
	bHomeAxis := FALSE;
END_IF
	
IF fbAxis.ResetDone THEN
	bReset := FALSE;
END_IF

IF fbAxis.StopDone THEN
	bStopAxis := FALSE;
END_IF


bReady := fbAxis.Ready;

fbReadParameter(	
	Axis 			:= axisRef, 
	Enable 			:= fbAxis.InMotion, 
	ParameterNumber := MC_AxisParameter.AxisRemainingTimeToGo, 
	ReadMode 		:= E_ReadMode.READMODE_CYCLIC);
				
IF fbReadParameter.Valid THEN
	fSlewtime := fbReadParameter.Value;
END_IF

IF bSoEReset THEN
	fbSoEReset(
		Axis 	:= axisRef,
		Execute := TRUE,
		Timeout := DEFAULT_ADS_TIMEOUT);
 	IF NOT fbSoEReset.Busy THEN
		fbSoEReset(Axis := axisRef, Execute := FALSE);
		bSoEReset := FALSE;
		bReset := TRUE;
	END_IF
END_IF


axisEvent(	
	Trigger 		:= bError, 
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString	:= 'Hour Angle Axis Error: %s',
	OnMessage 		:= NCError_TO_STRING(nErrorID),
	OffMEssage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	Comm			:= fbComm);
	

CalibrationEvent(	
	Trigger 		:= bCalibrated, 
	Level 			:= ADSLOG_MSGTYPE_HINT,
	OnMessage 		:= 'Hour Angle Axis is calibrated.',
	Comm			:= fbComm);
	
]]></ST>
    </Implementation>
    <LineIds Name="FB_HourAngleControl">
      <LineId Id="10" Count="1" />
