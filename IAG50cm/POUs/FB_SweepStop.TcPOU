<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_SweepStop" Id="{44b685fb-f9fe-49ee-838c-fcf86ea871ec}" SpecialFunc="None">
    <Declaration><![CDATA[// A stop in the calibration sweep (#113): the axes stay enabled and uncalibrated, the sweep is aborted by the stop. Once the
// stop has settled (for 3 scans) and no homing is running any more, the uncalibrated axes are switched off for one scan, so
// the telescope ends like a stop in the covers phase (READY_STATE -2, no error) and the next power-on starts the sweep
// again. Calibrated axes stay enabled. Pure logic, tested offline in IAG50cmTests.
// #197: ArmAll() is the same for a park without a completed power-on (the axes are on, but the telescope can never be
// ready): every axis is switched off once at rest, calibrated or not, and the axes-off park then parks in place.
FUNCTION_BLOCK FB_SweepStop
VAR_INPUT
	bSettled		: BOOL;		// FB_TelescopeControl.bSettled: at rest and no stop transaction running
	bHaCalibrated	: BOOL;
	bDecCalibrated	: BOOL;
	bHaHoming		: BOOL;		// FB_LatchHome.Busy
	bDecHoming		: BOOL;
	bOtherBusy		: BOOL;		// #197: the focus is moving; waited for in the all-axes mode only
END_VAR
VAR_OUTPUT
	bDisableHa		: BOOL;		// one scan
	bDisableDec		: BOOL;
END_VAR
VAR
	bPending		: BOOL;
	bAll			: BOOL;		// #197: switch every axis off, not only the uncalibrated ones
	nSettledScans	: UINT;
END_VAR
VAR CONSTANT
	nConfirmScans	: UINT := 3;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[bDisableHa := FALSE;
bDisableDec := FALSE;
IF bPending THEN
	IF bSettled AND NOT bHaHoming AND NOT bDecHoming AND NOT (bAll AND bOtherBusy) THEN
		IF nSettledScans < nConfirmScans THEN
			nSettledScans := nSettledScans + 1;
		END_IF
	ELSE
		nSettledScans := 0;
	END_IF
	IF nSettledScans >= nConfirmScans THEN
		bDisableHa := bAll OR NOT bHaCalibrated;
		bDisableDec := bAll OR NOT bDecCalibrated;
		bPending := FALSE;
		bAll := FALSE;
	END_IF
END_IF
]]></ST>
    </Implementation>
    <Method Name="Arm" Id="{5fe552c7-8819-4f0f-b9e6-0ac14c6a0840}">
      <Declaration><![CDATA[// A stop arrived in the calibration sweep (power-on stage 40 or later).
METHOD Arm
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT (bPending AND bAll) THEN	// a pending ArmAll() is not narrowed
	bPending := TRUE;
	nSettledScans := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ArmAll" Id="{7c1d4a52-3b6e-4f0a-9d28-5e8a1c3b7f64}">
      <Declaration><![CDATA[// A park without a completed power-on (#197): switch every axis off once at rest. Idempotent: it may be called every scan.
METHOD ArmAll
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT (bPending AND bAll) THEN
	bPending := TRUE;
	bAll := TRUE;
	nSettledScans := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cancel" Id="{0de7f038-45ed-4e19-b4e4-00c691302390}">
      <Declaration><![CDATA[// Error, reset or a new power-on: nothing to switch off any more.
METHOD Cancel
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bPending := FALSE;
bAll := FALSE;
nSettledScans := 0;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
