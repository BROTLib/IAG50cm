<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CabinetControl" Id="{94f0225c-1833-4eaa-8813-82b334d0ee64}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CabinetControl
VAR_INPUT
	bEstop				: BOOL;	// E-stop pressed (telescope bEstopTriggered, previous scan) (#93)
	bSafetyAckPending	: BOOL;	// safety acknowledge after an E-stop not yet run, drives still in STO (#93)
END_VAR
VAR_OUTPUT
END_VAR
VAR
	bCabinetError : BOOL;
	bTelescopeError : BOOL;
	bReset	: BOOL;
	
	rtrigReset : R_TRIG;
	
	bAuxiliaryContact24V AT %I* : BOOL; // Auxilary Contact of the 24V DC: TRUE = operational
	bAuxiliaryContact48V AT %I* : BOOL; // Auxilary Contact of the 48V DC: TRUE = operational
	bAuxiliaryContactHADEC AT %I* : BOOL; // Auxilary Contact of the HA DEC motor: TRUE = operational
	bAuxiliaryContactFOCUS AT %I* : BOOL; // Auxilary Contact of the FOCUS motor: TRUE = operational
	bCollectiveReport24VFuse AT %I*: BOOL; // Collective Report of the 24V Fuse box: TRUE = operational
	bState24VFuse AT %I*: BOOL; 
	
	bOErrorLED	AT %Q* : BOOL;
	bIReset     AT %I* : BOOL;
	bIMode      AT %I* : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// #10: error when ANY of the five is lost (it was NOT(a OR b OR ...), which only fired when all five dropped).
// All five read TRUE parked, powered and at three E-stops (test T14, 2026-10-12/13), so none of them is FALSE in
// normal operation. bState24VFuse is FALSE throughout and stays out of the expression.
bCabinetError := NOT( bAuxiliaryContact24V AND bAuxiliaryContact48V AND bAuxiliaryContactHADEC AND bAuxiliaryContactFOCUS AND bCollectiveReport24VFuse);

// if error -> LED on
// #93: also while the E-stop is pressed and until the safety acknowledge has run (the drives are in STO and a reset
// is needed). Not part of bError, which would change the reset condition, the power-on block and STATUS.GLOBAL.
bOErrorLED := bTelescopeError OR bEstop OR bSafetyAckPending;

// if reset -> trigger reset
rtrigReset(CLK:= bIReset,Q=>bReset);


]]></ST>
    </Implementation>
    <Property Name="Error" Id="{2fd28cb2-1a27-461e-9a1b-c500f525d0b9}">
      <Declaration><![CDATA[PROPERTY Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{135dc6c4-8dcc-48ff-8eb2-581d00ebd979}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := bCabinetError;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{36e391d8-c7f3-4e87-b860-5fb1000ab8f0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bTelescopeError := Error;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="LocalMode" Id="{aa0338ec-4b34-4867-92b3-49794b884548}">
      <Declaration><![CDATA[PROPERTY LocalMode : BOOL]]></Declaration>
      <Get Name="Get" Id="{5ed1a07b-9864-46cc-a5e2-a0f53f03b541}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[LocalMode := bIMode;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Reset" Id="{a6ba6162-19c5-4bfe-9eb1-47708d254cbe}">
      <Declaration><![CDATA[PROPERTY Reset : BOOL]]></Declaration>
      <Get Name="Get" Id="{69fd46f6-74db-4eda-b30d-0c164dc17a6c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Reset := bReset;]]></ST>
        </Implementation>
      </Get>
    </Property>
