<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CoverControl" Id="{d3621f5c-b414-4287-a5b0-c413b9f4d1e9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CoverControl IMPLEMENTS I_MirrorCovers
VAR_INPUT
	Delta		: TIME := T#5S;		// Time difference between both covers opening (and closing)
	TimeToCycle	: TIME := T#15S;	// Time for one motor to fully open/close
END_VAR
VAR_OUTPUT
END_VAR
VAR
	bOpen		: BOOL;
	bClose		: BOOL;
	bStop		: BOOL;
	bEmergency	: BOOL;
	// State
	fbCoverIdleState : FB_CoverIdleState(THIS);
	fbCoverOpeningState : FB_CoverOpeningState(THIS);
	fbCoverStoppingState : FB_CoverStoppingState(THIS);
	fbCoverClosingState : FB_CoverClosingState(THIS);
	
	ipState		: I_CoverState := fbCoverIdleState;
	eCoverState	: E_MirrorCoverState := E_MirrorCoverState.closed;
	// Trigger
	rtrigOpen		: R_TRIG;
	rtrigClose		: R_TRIG;
	rtrigStop		: R_TRIG;
	// Comm
	fbComm			: I_Comm;
	tonComm 		: TON := (PT:=T#5S);
	fbCoverOpenEvent:	FB_EventLog;
	fbCoverClosedEvent: FB_EventLog;
	// Motor relais
	bMotor1RelaisA	AT%Q*	: BOOL := FALSE;
	bMotor1RelaisB	AT%Q*	: BOOL := FALSE;
	
	bMotor2RelaisA	AT%Q*	: BOOL := FALSE;
	bMotor2RelaisB	AT%Q*	: BOOL := FALSE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[rtrigOpen(CLK := bOpen);
rtrigClose(CLK := bClose);
rtrigStop(CLK := bStop);

IF (rtrigStop.Q) OR bEmergency THEN
	bStop := FALSE;
	ipState.StopCommand();
END_IF

IF (rtrigClose.Q) AND NOT bEmergency THEN
	bClose := FALSE;
	ipState.CloseCommand();
END_IF

IF (rtrigOpen.Q) AND NOT bEmergency THEN
	bOpen := FALSE;
	ipState.OpenCommand();
END_IF

ipState.RunState();

// send telemetry
tonComm(IN:=TRUE);
IF tonComm.Q THEN
	tonComm(IN:=FALSE);
	fbComm.Publish('telescope', 'dome', 'MirrorCover', TO_STRING(eCoverState));
END_IF


fbCoverOpenEvent(
	Trigger := eCoverState = E_MirrorCoverState.open,
	Level := ADSLOG_MSGTYPE_HINT,
	OnMessage := 'Mirror cover is open.',
	comm:= fbComm);
fbCoverClosedEvent(
	Trigger := eCoverState = E_MirrorCoverState.closed,
	Level := ADSLOG_MSGTYPE_HINT,
	OnMessage := 'Mirror cover is closed.',
	comm:= fbComm);
]]></ST>
    </Implementation>
