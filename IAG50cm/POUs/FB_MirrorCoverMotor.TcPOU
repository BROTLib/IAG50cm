<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_MirrorCoverMotor" Id="{ad6a0aff-220c-488b-a97b-ed536bb59202}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MirrorCoverMotor
VAR_INPUT
END_VAR
VAR_OUTPUT
	// state of the Motor
	motor_state : E_MirrorCoverState := E_MirrorCoverState.closed;
END_VAR
VAR
	// Both relais for the Motor (both TRUE -> openening, both FALSE -> Closing), initilize them in STOP
	Relais_Out_A	AT%Q*	: BOOL := TRUE;
	Relais_Out_B	AT%Q*	: BOOL := FALSE;
	// stop movement untill reset command
	bStop			: BOOL;
	// reset
	bReset			: BOOL;
	// Move commands
	bClose			: BOOL;
	bOpen			: BOOL;
	// stop the movement but only till next move command follows
	bSoftstop		: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bStop OR bSoftStop OR bReset THEN
	// no movement is happening
	motor_state := E_MirrorCoverState.stopped;
	// stop movement commands and reset soft stop
	bClose := FALSE;
	bOpen := FALSE;
	bSoftStop := FALSE;
	IF bReset THEN
		// RESET
		// remove all tags
		bStop := FALSE;
		bSoftStop := FALSE;
		bReset := FALSE;
	END_IF
	// STOP -> put both Relais on same Voltage so motor stops
	Relais_OUT_A := TRUE;
	Relais_OUT_B := FALSE;

ELSIF bClose THEN
	// set Relais to CLOSED
	Relais_Out_A := FALSE;
	Relais_Out_B := FALSE;
	// Motor is closing or closed
	motor_state := E_MirrorCoverState.closing;
	bClose := FALSE;
	
ELSIF bOpen THEN
	// set Relais to OPEN
	Relais_Out_A := TRUE;
	Relais_Out_B := TRUE;
	// Motor is opening or open
	motor_state := E_MirrorCoverState.opening;
	bOpen := FALSE;
END_IF

]]></ST>
    </Implementation>
    <Method Name="Close" Id="{c386672b-a433-45b1-a524-afe636ecf3df}">
      <Declaration><![CDATA[METHOD Close : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bClose := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Open" Id="{2da6e197-438b-4839-b895-9a11327edb2d}">
      <Declaration><![CDATA[METHOD Open : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bOpen := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{e06d1684-953a-488b-8105-334aac9cb976}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bReset := True;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SoftStop" Id="{c3546edc-0138-443f-8833-427b38310bcd}">
      <Declaration><![CDATA[METHOD SoftStop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bSoftStop := True;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{78fbdab0-4ab6-4aab-8344-5916f672987b}">
      <Declaration><![CDATA[METHOD Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bStop := True;]]></ST>
      </Implementation>
    </Method>
