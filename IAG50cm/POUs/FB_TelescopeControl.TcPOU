<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_TelescopeControl" Id="{10c2c294-efcf-424f-afd3-75ac57a5e8bc}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TelescopeControl IMPLEMENTS I_RaDecTelescope, I_Telescope
VAR_INPUT
(*
TCS interface section
see https://gitlab.aip.de/bmk10k/telescope_firmware/snippets/5
*)
	bPower				: BOOL;		// true: Power on
	bGoHome				: BOOL;		// true: go to home position, unset track/goto if active
	bPark				: BOOL;		// boolean, true: go into park position, ready to stow telescope, unset track/goto
	bTrack				: BOOL;		// boolean, TRUE: MOVE telescope TO last ra/de AND start tracking. Set 'goto' TO FALSE, IF TRUE. FALSE: Stop tracking as soon as possible
	bGoto				: BOOL;		// boolean, TRUE: MOVE telescope TO tau/de AND stop there. Set track TO FALSE, IF TRUE. FALSE: no effect.)	
	bSlew				: BOOL;		// move the telescope to a given az-alt position
	bStop				: BOOL;		// boolean, TRUE: Stop motion OF telescope immediately, set goto AND track TO FALSE. FALSE: Allow motion OF telescope again via track/goto).	
	bReset				: BOOL;		// initiates reset on all axis
	bSafetyAckRequest	: BOOL;		// set by a telescope reset, taken (and cleared) by MAIN which gives the safety acknowledge (#11)
	bAutoTrack			: BOOL := TRUE;	// automatic tracking after goto
	fRightAscension		: LREAL :=  0.0;	//  right ascension, degrees, double	
	fDeclination		: LREAL :=  0.0;	//  declination, degrees, double
	fDeclinationApparent: LREAL :=	0.0;	// apparent declination , degrees, double
	fElevation			: LREAL :=  0.0;	// desired elevation of the telescope pointing
	fAzimuth			: LREAL :=  0.0;	// desired azimut of the telescope pointing
	fHourAngleOffset	: LREAL := 0.0;		// absolute offset for right ascension
	fDeclinationOffset 	: LREAL := 0.0;		// absolute offset for declination
	fTimeOffset			: LREAL := 0.0;		// absolute offset for time
	fHorizon			: LREAL := 1.0;		// ELEVATION below which value the telescope will not go
	fPoleZone			: LREAL := 3.0;		// 90° - fPoleZone = No go zone near the Pole
	fPointingSafeAltitude	: LREAL := 5.0;	// ELEVATION below which the pointing model's fixed-point inversion is not numerically reliable (chaotic, see FB_PointingModelInversion / testing/check_pointing_inversion.py); gates goto/slew targets and tracking in addition to fHorizon
	
	fSlewVelocity		: LREAL := 8.0;		// Motor velocity for moving the telescope in degree/s
	
	// TRUE while the E-stop is triggered (MAIN: safetyHandling.estop): disables both axes, which only the next
	// power-on enables again, and publishes STATUS.GLOBAL = 1
	bEstopTriggered		: BOOL	:= FALSE;
	// MAIN: safetyHandling.ackPending (previous scan). An E-stop was seen and no clean safety acknowledge has run
	// since: the reset fires on it even without an error, and a power-on is refused (#59)
	bSafetyAckPending	: BOOL	:= FALSE;
	bMainReady			: BOOL	:= TRUE;
	bCoverAutoOpen		: BOOL	:= TRUE;
	fbFocus				: I_Focus;
	fbCovers			: I_MirrorCovers;
	fbDome				: I_Dome;

	fbHourAngle			: REFERENCE TO FB_HourAngleControl;
	fbDeclination		: REFERENCE TO FB_DeclinationControl;

	telescopeConfig		: ST_TelescopeConfig;
END_VAR
VAR
	fbComm 				: I_Comm;
	fbCabinet			: FB_CabinetControl;
	
	TCS_command			: E_TCSCommand;	// actual command from the TCS
	fJd					: LREAL;	// current Julian Date calculated from system time
	fLst				: LREAL;	// local siderial time calculated from Julian date in hours
	fElevationCalc		: LREAL;	// elevation calulated when ra and dec are set by TCS 
	fAzimuthCalc		: LREAL;	// azimuth calulated when ra and dec are set by TCS
	fHourAngleApparent	: LREAL;	// hourangle when ra and dec are set by TCS
	
	fRightAscensionCalc	: LREAL;	// right ascension calulated when azimuth and elevation are set by TCS
	fDeclinationCalc	: LREAL;	// declination calulated when azimuth and elevation are set by TCS
	fHourAngleCalc		: LREAL;	// hour angle azimuth and elevation are set by TCS
	
	fHourAnglePointingOffset	: LREAL; // pointing offset to sky
	fDeclinationPointingOffset	: LREAL; // pointing offset to sky
	fHourAngleInversionOffset	: LREAL;
	fDeclinationInversionOffset : LREAL;
	fHourAngleInversionOffsetCalc	: LREAL;	// raw output of fbPointingInversion this cycle, only copied into fHourAngleInversionOffset when bPointingInversionValid
	fDeclinationInversionOffsetCalc : LREAL;
	bPointingInversionValid		: BOOL;		// FALSE near the horizon where the inversion doesn't converge; fHourAngleInversionOffset/fDeclinationInversionOffset then keep their last valid value
	fHourAngleVelocity			: LREAL;	// rotational velocity of the HourAngle
	fDeclinationVelocity		: LREAL;	// rotational velocity of the Declination
	fbTime				: FB_AstroClock;	// precise astronomical	time
	fbEq2Hor			: FB_EQ2HOR;
	fbHor2Eq			: FB_HOR2EQ;
	fbHaDec2RaDec		: FB_HADEC2RADEC;
	fbRaDec2HaDec		: FB_RADEC2HADEC;
	fbPointingForward	: FB_PointingModelForward;
	fbPointingInversion : FB_PointingModelInversion;
	
	rtrigHorizonError	: R_TRIG;		// if the set Coordinate is below the Horizon threshold fHorizon
	rtrigPoleError		: R_TRIG;		// if the set Coordinate is in the pole zone fPoleZone
	
	rtrigReset		: R_TRIG;
	bAxisResetAfterAck	: BOOL;		// reset the errored axes a second time once the acknowledge is done (#11)
	tonAxisResetAfterAck	: TON;
	bResetRequest		: BOOL;		// Reset() was called (one scan); kept apart from bReset, which the trigger below drives (#36)
	bSoftwareError		: BOOL;		// error set by the state machines (timeouts), latched until a reset (#30)
	nSoftwareErrorID	: UDINT;	// 16#10 goto, 16#20 park, 16#30 home, 16#40 slew timeout
	bInterupted			: BOOL;		// If a command is interuped by one with more presedence, the interupted needs to reset its stage
	bStopping			: BOOL;		// a movement was preempted: the axes are stopped before the new command starts (#43, #42, #41)
	bRestartGoto		: BOOL;		// Track() while a goto is running: the new target replaces the old one (#41)
	bRestartSlew		: BOOL;		// Slew() while a slew is running: the new target replaces the old one (#41)
	eLastTimeoutCommand	: E_TCSCommand;	// #40: command the timeout timer is running for
	bUserStop			: BOOL;		// Stop() was called (one scan): aborts a running power-on, automatic stops do not (#27)
	bParkInError		: BOOL;		// a park was requested during an error (one scan): covers closed, dome parked, mount not moved
	sParkEnd			: STRING(40) := 'completed';	// the park log line when bPark falls: completed, or why it ended (#57)
	sHomeEnd			: STRING(40) := 'completed';	// the same for the home (#75)
	bHomeCancelled		: BOOL;		// a pending home that never started was dropped (one scan): logs the reason (#75)
	tonHomePending		: TON;		// #75: bGoHome set but the home is not running (not ready, powered off): cancelled after 2 min
	
	bPowerFailure		: BOOL;		// triggers power-failure event
	bPowerBlocked		: BOOL;		// a power-on request was refused because of an error (one scan): logs the reason, every time
	tpPowerOnWarning		: TP;		// triggers power warning
	tonPowerTimeout		: TON;		// power on timeout
	tonCommandTimeout		: TON;		// command timeout
	// MONETcommon#17: 600 s timeouts of the goto/home/slew state machines. They were TONs in the methods' plain VAR, which is
	// re-created on every call, so they never fired. Fed every scan in the body, reset when the command flag drops.
	tonGotoTimeout			: TON;
	tonHomeTimeout			: TON;
	tonSlewTimeout			: TON;
	tonParkTimeout			: TON;		// park had no state-machine timeout: covers that never close hung it forever
	tonParkFocus			: TON;		// park stage 80 waits for the focus move to end (#56), at most 60 s
	tonTrackingDelay		: TON;		// tracking delay
	
	TCSpowerEvent,
	TCSgohomeEvent,
	TCSparkEvent,
	TCSgotoEvent,
	TCStrackEvent,
	TCSstopEvent,
	TCStargetHorizonEvent,
	TCSaltitudeEvent,
	TCSnearPoleEvent,
	TCSreadyEvent,
	TCSCTOEvent,
	TCSsoftErrorEvent,
	TCSparkErrorEvent,
	TCShomeCancelEvent,
	TCSpowerBlockedEvent	: FB_Eventlog;	// #30, park during an error, a blocked power-on (every request)
	tonMQTTTimer 			: TON := (PT:=T#5S);
	
	
	nStatusWord, nLastStatus:	UDINT;
	bTestError : BOOL; // Test Error, deactivates under reset command
END_VAR
VAR_OUTPUT
	bReady				: BOOL;		// TRUE, IF telescope can be operated 
	fReadyState 		: LREAL := 0.0; // 0: Shut down, 1 powered on, -1 Error
	bIsParked			: BOOL := TRUE;		// telescope is parked
	bIsPowered			: BOOL;		// telescope is powered on
	bError				: BOOL;		// indicates an error on one of the components
	nErrorID			: UDINT;	//error id of axis
	nMotionState		: INT	:= 0;
	bSliding			: BOOL;		//TRUE, IF telescope is in fast-MOVE phase (includes pole-swap)	
	bTracking			: BOOL;		//TRUE, IF telescope is on tracking position AND currently tracking.	
	bStopped			: BOOL;		//TRUE, IF telescope is AT rest.	
	fHourAngleCurrent	: LREAL;	// current position of the hour angle (without pointing and offset correction)
	fDeclinationCurrent	: LREAL;	// current position of the declination (without pointing and offset correction)
	fRightAscensionCurrentICRS	: LREAL;	// true position of the right ascension (without pointing and offset correction) nut, aberr and precess corrected
	fDeclinationCurrentICRS		: LREAL;	// true position of the declination (without pointing and offset correction) nut, aberr and precess corrected
	fRightAscensionCurrentICRScorr	: LREAL;	// true position of the right ascension (with pointing and offset correction) nut, aberr and precess corrected
	fDeclinationCurrentICRScorr		: LREAL;	// true position of the declination (with pointing and offset correction) nut, aberr and precess corrected
	fElevationCurrent	: LREAL;	// current position in elevation (calculated) (without pointing and offset correction)
	fAzimuthCurrent		: LREAL;	// current position in azimuth (calculated) (without pointing and offset correction)
	fElevationCurrentSky	: LREAL;	// current position in elevation (calculated)
	fAzimuthCurrentSky		: LREAL;	// current position in azimuth (calculated)
	fSlewTime			: LREAL;	//	(time in sec. to reach the goto/track position) 
	bHomed				: BOOL;		// True: telescope is calibrated
	bBusy				: BOOL;		// telescope does not accept further commands
	bLocalMode			: BOOL;		// TRUE if switch is flipped to prevent Robotic Mode
END_VAR
VAR CONSTANT
	d2r		: LREAL := PI/180.0;
	fSiderialVelocity: LREAL := 360.0 / 86164.099;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// get the system time; fJd only follows the clock while the clock is valid (synced, see FB_AstroClock)
fbTime();
IF fbTime.bValid THEN
	fJd := DateTime2JD(fbTime.time_RTCEX2);
END_IF
fLst := CT2LST(telescopeConfig.longitude, fJd);

// without a trustworthy time nothing may be pointed or tracked: refuse through the normal stop path
IF NOT fbTime.bValid AND (bGoto OR bSlew OR bTrack) THEN
	bStop := TRUE;
END_IF

// State of the Cabinet
fbCabinet();
bLocalMode := fbCabinet.LocalMode;

// set reset state either by hardware (key pressed) or by software (set by e.g. tcs)
// #36: the request from Reset() must not be overwritten by the key state, so it has its own flag
// #59: also while the safety acknowledge after an E-stop is pending, so a reset sent during the E-stop (which
// clears the axis errors but skips the acknowledge) or after an E-stop without an axis error is not lost
rtrigReset(CLK := (fbCabinet.Reset OR bResetRequest) AND (bError OR bSafetyAckPending), Q=>bReset);
bResetRequest := FALSE;

IF bReset THEN
	bTestError := FALSE;
	bSoftwareError := FALSE;
	nSoftwareErrorID := 0;
	// reset input coords to parking position (always over horizon to stop bHorizonError from occuring)
	fDeclination := telescopeConfig.declinationPark;
	fbHaDec2RaDec(	jd := fJd +fTimeOffset,
					ha := telescopeConfig.houranglePark,
					dec := telescopeConfig.declinationPark,
					lon := telescopeConfig.longitude,
					ra_out => fRightAscension);
	// reset elevation values to abitrarry value over horizon, will get overwritten down the line
	fElevationCalc := 20.0;
	fElevation := 20.0;
	// reset dome position
	fbDome.Position := 180.0;
	// #35: a dome error after an E-stop (serial link lost) stays latched until the dome is reset, and nothing else
	// reaches it. Only the dome's error state reacts to a reset; in every other state it is ignored.
	IF fbDome <> 0 THEN
		fbDome.Reset();
	END_IF
	// reset the stages of all statemachine methods
	bInterupted := TRUE; 
	_HomeTelescope();
	_GotoTelescope();
	_SlewTelescope();
	_ParkTelescope();
	bInterupted := FALSE;
END_IF

// get error ID
IF fbHourAngle.Error THEN
	nErrorID := fbHourAngle.nErrorID;
ELSIF fbDeclination.bError THEN
	nErrorID := fbDeclination.nErrorID;
ELSIF fbFocus <> 0 AND_THEN fbFocus.Error THEN
	nErrorID := fbFocus.ErrorID;
ELSIF bSoftwareError THEN
	nErrorID := nSoftwareErrorID;
END_IF

// reset (#11): every errored axis in one go, not only the first one. The drives stay in STO until the safety
// acknowledge (MAIN, bSafetyAckRequest: ErrAck 1 s, Restart 1 s), so the axes are reset again once it is done.
// The second pass resets every axis that is errored or not enabled (#55): after an E-stop HA and Dec can have lost
// their enable without latching an error, and then failed at the next power-on (18000) until they got a reset.
IF bReset THEN
	bSafetyAckRequest := TRUE;
	bAxisResetAfterAck := TRUE;
	_ResetErroredAxes(bAll := FALSE);
END_IF
tonAxisResetAfterAck(IN := bAxisResetAfterAck, PT := T#2500MS);
IF tonAxisResetAfterAck.Q THEN
	bAxisResetAfterAck := FALSE;
	_ResetErroredAxes(bAll := TRUE);
END_IF

// fSlewTime
fSlewTime := fbHourAngle.fSlewTime + fbDeclination.fSlewTime;

// ERROR (either one of the Axis or below safe Horizon (fHorizon))
bError := fbHourAngle.Error OR fbDeclination.Error OR(fbFocus <> 0 AND_THEN fbFocus.Error) OR fbCabinet.Error OR bTestError OR bSoftwareError;
			
IF bError THEN
	bGoHome := 	FALSE;
	bTrack := 	FALSE;
	bGoto := 	FALSE;
	bSlew := 	FALSE;
	fbHourAngle.Enable := FALSE;
	fbDeclination.Enable := FALSE;
	fbCabinet.Error := TRUE;
ELSE
	fbCabinet.Error := FALSE;
	nErrorID := 0;
END_IF


// calculate fHourAngleApparent, fDeclinationApparent 

fbRaDec2HaDec(
	ra := fRightAscension,
	dec := fDeclination,
	lon := telescopeConfig.longitude,
	JD := fJd + fTimeOffset,
	ha_out => fHourAngleApparent,
	dec_out => fDeclinationApparent);
// (and also horizontal coord. -> used for checking if target is on sky or in ground)
fbEq2Hor(
	ra := fRightAscension,
	dec := fDeclination,
	lon := telescopeConfig.longitude,
	lat := telescopeConfig.latitude,
	altitude := telescopeConfig.altitude,
	JD := fJd + fTimeOffset,
	refract_to_observed := TRUE,
	alt => fElevationCalc,
	az => fAzimuthCalc);
	
// calculate equatorial coordinates (used by Slew command, takes Alt/Az -> moves telescope)
fbHor2Eq(alt := fElevation, 
		az := fAzimuth,
		jd := fJd+fTimeOffset,
		lat := telescopeConfig.latitude,
		lon := telescopeConfig.longitude,
		altitude := telescopeConfig.altitude,
		alt_is_observed := FALSE,
		ra => fRightAscensionCalc,
		dec => fDeclinationCalc,
		ha => fHourAngleCalc);		
// caluclate pointing offsets
fbPointingForward(
	HourAngle	:= fHourAngleApparent,
	Declination	:= fDeclinationApparent,
	Latitude	:= telescopeConfig.latitude,
	HourAngle_correction => fHourAnglePointingOffset,
	Declination_correction => fDeclinationPointingOffset,
	HourAngle_velocity => fHourAngleVelocity,
	Declination_velocity => fDeclinationVelocity,
);
(*--------------------------------------------------------------*)
// get current coordinates (of motors)
fDeclinationCurrent := fbDeclination.ActualPosition ;
fHourAngleCurrent := fbHourAngle.ActualPosition ;
// calculte pointing inversion
fbPointingInversion(
	HourAngle:= fHourAngleCurrent,
	Declination:= fDeclinationCurrent,
	Latitude:=telescopeConfig.latitude,
	HourAngle_correction => fHourAngleInversionOffsetCalc,
	Declination_correction => fDeclinationInversionOffsetCalc,
	bValid => bPointingInversionValid
);
// near the horizon the inversion is chaotic and does not converge (see FB_PointingModelInversion);
// keep reporting the last trustworthy correction rather than whatever garbage it would return
IF bPointingInversionValid THEN
	fHourAngleInversionOffset := fHourAngleInversionOffsetCalc;
	fDeclinationInversionOffset := fDeclinationInversionOffsetCalc;
END_IF
(*--------------------------------------------------------------*)
// transform from apparent to icrs

//current
fbHaDec2RaDec(
	ha := fHourAngleCurrent,
	dec := fDeclinationCurrent,
	jd := fJd+fTimeOffset,
	lon := telescopeConfig.longitude,
	ra_out => fRightAscensionCurrentICRS,
	dec_out => fDeclinationCurrentICRS);
//current corrected
fbHaDec2RaDec(
	ha := fHourAngleCurrent - fHourAngleInversionOffset - F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclinationApparent),
	dec := fDeclinationCurrent - fDeclinationInversionOffset- fDeclinationOffset,
	jd := fJd+fTimeOffset,
	lon := telescopeConfig.longitude,
	ra_out => fRightAscensionCurrentICRScorr,
	dec_out => fDeclinationCurrentICRScorr);
(*--------------------------------------------------------------*)
// to ALT AZ
fbEq2Hor(
	ra := fRightAscensionCurrentICRS,
	dec := fDeclinationCurrentICRS,
	lon := telescopeConfig.longitude,
	lat := telescopeConfig.latitude,
	altitude := telescopeConfig.altitude,
	refract_to_observed := FALSE,
	JD := fJd + fTimeOffset,
	alt => fElevationCurrent,
	az => fAzimuthCurrent);
	
fbEq2Hor(
	ra := fRightAscensionCurrentICRScorr,
	dec := fDeclinationCurrentICRScorr,
	lon := telescopeConfig.longitude,
	lat := telescopeConfig.latitude,
	altitude := telescopeConfig.altitude,
	refract_to_observed := FALSE,
	JD := fJd + fTimeOffset,
	alt => fElevationCurrentSky,
	az => fAzimuthCurrentSky);
//----------------------------------------------------------------------------------------------
// If the Telescope dips under the fHorizon (e.g. while tracking, stop and gohome)
// (also gated on fPointingSafeAltitude so tracking never lingers in the pointing model's chaotic zone)
IF fElevationCurrent < MAX(fHorizon+0.2, fPointingSafeAltitude) THEN
	IF NOT bStopped AND NOT bGoHome THEN
		bStop := TRUE;
	ELSIF bReady AND NOT bError THEN	// #82: only when the home can run; the power-on homes (stage 100)
		bGoHome := TRUE;
	END_IF
END_IF
// If the Telescope goes into the forbidden polezone (e.g. while tracking, stop and gohome)
IF (fDeclinationCurrent > (90.0 - fPoleZone)) OR (bTrack AND (fDeclinationApparent + fDeclinationOffset + fDeclinationPointingOffset > (90.0 - fPoleZone)))THEN
	IF NOT bStopped AND NOT bGoHome THEN
		bStop := TRUE;
	ELSIF bReady AND NOT bError THEN	// #82: only when the home can run; the power-on homes (stage 100)
		bGoHome := TRUE;
	END_IF
END_IF
//----------------------------------------------------------------------------------------------
// if the given coordinates to goto/slew are under the horizon
// (also rejects targets below fPointingSafeAltitude, where the pointing model's inversion is chaotic -- see FB_PointingModelInversion)
IF (bGoTo AND (fElevationCalc < MAX(fHorizon + 1.0, fPointingSafeAltitude))) OR (bSlew AND (fElevation < MAX(fHorizon, fPointingSafeAltitude))) THEN
	// trigger event
	rtrigHorizonError(CLK:=TRUE);
	// reset input coords to parking position (always over horizon to stop bHorizonError from occuring)
	fDeclination := telescopeConfig.declinationPark;
	fbHaDec2RaDec(	jd := fJd +fTimeOffset,
					ha := telescopeConfig.houranglePark,
					dec := telescopeConfig.declinationPark,
					lon := telescopeConfig.longitude,
					ra_out => fRightAscension);
	// reset elevation values to abitrarry value over horizon, will get overwritten down the line
	fElevationCalc := 20.0;
	fElevation := 20.0;
	// stop telescope
	bStop := TRUE;
ELSE
	// reset event trigger
	rtrigHorizonError(CLK:=FALSE);
END_IF

// if the given coordinates to goto/slew are in the PoleZone
IF (bGoTo AND (fDeclinationApparent > (90.0 - fPoleZone))) OR (bSlew AND (fDeclinationCalc  > (90.0 - fPoleZone))) THEN
	// trigger event
	rtrigPoleError(CLK:=TRUE);
	// reset input coords to parking position (always over horizon to stop bHorizonError from occuring)
	fDeclination := telescopeConfig.declinationPark;
	fbHaDec2RaDec(	jd := fJd +fTimeOffset,
					ha := telescopeConfig.houranglePark,
					dec := telescopeConfig.declinationPark,
					lon := telescopeConfig.longitude,
					ra_out => fRightAscension);
	// reset elevation values to abitrarry value over horizon, will get overwritten down the line
	fElevationCalc := 20.0;
	fElevation := 20.0;
	// stop telescope
	bStop := TRUE;

ELSE
	// reset event trigger
	rtrigPoleError(CLK:=FALSE);
END_IF
//----------------------------------------------------------------------------------------------

tpPowerOnWarning(IN := bPower OR (NOT fbHourAngle.bEnable), PT := T#250MS);

tonPowerTimeout(IN := TCS_command = E_TCSCommand.no_command AND NOT bIsParked, PT := T#12H);
tonCommandTimeout();

// MONETcommon#17: state-machine timeouts, checked in _GotoTelescope/_HomeTelescope/_SlewTelescope
// #75: count only while the command is the one being run (TCS_command is last scan's dispatch) and without an error.
// Counting from the request, a command that never started (not ready, preempted) fired the timeout in the next
// stop/park/reset after 600 s and latched an error, and with the horizon/pole auto-home setting bGoHome again every
// scan the timer never dropped, so no reset cleared it.
tonGotoTimeout(IN := bGoto AND TCS_command = E_TCSCommand.goto AND NOT bError, PT := T#600S);
tonHomeTimeout(IN := bGoHome AND TCS_command = E_TCSCommand.gohome AND NOT bError, PT := T#600S);
tonSlewTimeout(IN := bSlew AND TCS_command = E_TCSCommand.slew AND NOT bError, PT := T#600S);
tonParkTimeout(IN := bPark AND TCS_command = E_TCSCommand.park AND NOT bError, PT := T#600S);
// #75: a Home() that never starts (axes off, telescope not ready) left bGoHome set for good, swallowing Track() and
// Slew(). Drop it after 2 min, with a log line, without an error. Not at once: the home that the power-on requests in
// stage 100 can wait a few scans for bReady, and a stop from slew speed takes about 4 s. Not during a power-on.
tonHomePending(IN := bGoHome AND TCS_command <> E_TCSCommand.gohome AND NOT bPower AND NOT bError, PT := T#2M);
IF tonHomePending.Q THEN
	bGoHome := FALSE;
	sHomeEnd := 'cancelled: telescope not ready';
	bHomeCancelled := TRUE;
END_IF
IF tonPowerTimeout.Q AND NOT bIsParked THEN
	bPark := TRUE;
	// #83: fire once. With the axes off or in error the park does not set bIsParked, so Q stayed TRUE and bPark was
	// set again every scan (dropping Track/Goto/Slew/Home, re-commanding the dome). The timer counts again from now.
	tonPowerTimeout(IN := FALSE);
END_IF
//----------------------------------------------------------------------------------------------		
// set TCS_command according to state variables ordered by precedence
// #27: an explicit Stop() outranks power-on, like in MONETcommon. The automatic stops (horizon, pole zone, no valid
// time) do not abort a running power-on, as before.
IF bStop AND (bUserStop OR NOT bPower) THEN
	bTrack := FALSE;
	bStopping := FALSE;

	// If the stop is during a movement, reset the stage of the movement first
	IF bPower THEN
		bPower := FALSE;
		_PowerOn();		// bStop is set: resets its stage
	ELSIF bPark THEN
		bPark := FALSE;
		sParkEnd := 'cancelled by stop';
		_ParkTelescope();
	ELSIF bGoto THEN
		bGoto := FALSE;
		_GotoTelescope();
	ELSIF bSlew THEN
		bSlew := FALSE;
		_SlewTelescope();
	ELSIF bGoHome THEN
		bGoHome := FALSE;
		sHomeEnd := 'cancelled by stop';
		_HomeTelescope();
	END_IF
	TCS_command := E_TCSCommand.stop;

ELSIF bPower THEN
	// Init() during a park cancels the park: its stage is reset and the move flags dropped. Left alone, bPark
	// survived the power-on, the park then preempted the go-home, resumed at its old stage and hung at 90 waiting
	// for covers that the power-on had just reopened.
	IF bPark THEN
		bPark := FALSE;
		sParkEnd := 'cancelled by power-on';
		bInterupted := TRUE;
		_ParkTelescope();
		bInterupted := FALSE;
		fbHourAngle.MoveAxis := FALSE;
		fbDeclination.MoveAxis := FALSE;
	END_IF
	TCS_command := E_TCSCommand.poweron;

ELSIF bStopping THEN
	// #43: a movement was preempted. Its flag and stage are already reset; TCS_command must not stay on the old
	// command (its method would keep the axes going), so run the stop until the axes stand still. The pending
	// command is picked up below in the next scan.
	TCS_command := E_TCSCommand.stop;
	IF bStopped THEN
		bStopping := FALSE;
	END_IF

ELSIF bPark THEN
	bTrack := FALSE;
	IF bError OR (TCS_command <> E_TCSCommand.park AND NOT fbHourAngle.Enable AND NOT fbDeclination.Enable) THEN
		// Park during an error: the axes are disabled by the error and the park state machine aborts on bError, so
		// bPark used to stay set and the park fired after the next Init() (or hung half way after a reset). Do what
		// is safe without the mount: close the covers, park the dome, disable the focus, and drop the command. The
		// mount is not moved and bIsParked is not set.
		// The same with the axes off (#54): the park command is dispatched only with bReady, which needs the axes
		// enabled, so a park after a stopped power-on, or on a parked telescope, waited until a power-on or the
		// 600 s timeout with the covers open. Not while a park is running (TCS_command park): stage 60 of the park
		// disables the axes itself and the park must go on to stage 100.
		bGoHome := FALSE;
		sHomeEnd := 'cancelled by park';
		bGoto := FALSE;
		bSlew := FALSE;
		bInterupted := TRUE;
		_ParkTelescope();
		_HomeTelescope();
		_GotoTelescope();
		_SlewTelescope();
		bInterupted := FALSE;
		fbCovers.Close();
		fbDome.Position := 180.0;
		fbDome.Park();
		IF fbFocus <> 0 THEN
			fbFocus.Enable := FALSE;
		END_IF
		bPark := FALSE;
		// #57: say what was commanded; with the E-stop pressed the cover and dome requests are dropped
		IF bEstopTriggered THEN
			TCSparkErrorEvent.OnMessage := 'Park refused: E-stop pressed, the covers and the dome cannot move. Release it, reset, then park again.';
		ELSIF bError THEN
			TCSparkErrorEvent.OnMessage := 'Park during an error: covers closed and dome parked, the mount was not moved. Reset, then park again.';
		ELSE
			TCSparkErrorEvent.OnMessage := 'Park with the axes off: covers closed and dome parked, the mount was not moved.';
		END_IF
		bParkInError := TRUE;
		TCS_command := E_TCSCommand.no_command;
	// If lower presedence commands are ongoing, let them know they are interupted
	ELSIF bGoto OR bSlew OR bGoHome THEN
		bGoHome := FALSE;
		sHomeEnd := 'cancelled by park';
		bGoto := FALSE;
		bSlew := FALSE;
		bInterupted := TRUE;
		_HomeTelescope();
		_GotoTelescope();
		_SlewTelescope();
		bInterupted := FALSE;	// #26: one-shot, the interrupted state machines have reset their stage; it could latch otherwise
		// #43: stop the axes now, park starts when they stand still. Only if one of the preempted commands is
		// the one moving; a Track()/Slew() arriving while the park itself runs must not stop the park.
		IF TCS_command = E_TCSCommand.goto OR TCS_command = E_TCSCommand.slew OR TCS_command = E_TCSCommand.gohome THEN
			bStopping := TRUE;
		END_IF

	ELSE
		IF bReady AND NOT bBusy THEN
			bInterupted := FALSE;
			TCS_command := E_TCSCommand.park;
		END_IF
	END_IF
	
	
	
ELSIF bGoHome THEN
	bTrack := FALSE;
	// If lower presedence commands are ongoing, let them know they are interupted
	IF bGoto OR bSlew THEN
		bGoto := FALSE;
		bSlew := FALSE;
		bInterupted := TRUE;
		_GotoTelescope();
		_SlewTelescope();
		bInterupted := FALSE;	// #26: one-shot, see the park branch
		IF TCS_command = E_TCSCommand.goto OR TCS_command = E_TCSCommand.slew THEN
			bStopping := TRUE;	// #43, only if the preempted command is the one moving
		END_IF

	ELSIF TCS_command <> E_TCSCommand.gohome AND NOT bStopped AND (TCS_command = E_TCSCommand.track OR fbHourAngle.Tracking OR fbDeclination.Tracking) THEN
		// #72: a home during tracking waited for bStopped, which is never TRUE while the axes track, so it never
		// ran (bGoHome stayed set) until a stop. End the tracking through the stop (#43); the home starts when the
		// axes stand still.
		bStopping := TRUE;

	ELSE
		IF bReady AND NOT bBusy AND bStopped THEN
			bInterupted := FALSE;
			TCS_command := E_TCSCommand.gohome;
		END_IF
	END_IF
	
	
ELSIF bGoto THEN
	bTrack := FALSE;
	// If lower presedence commands are ongoing, let them know they are interupted
	IF bSlew THEN
		bSlew := FALSE;
		bInterupted := TRUE;
		_SlewTelescope();
		bInterupted := FALSE;	// #26: one-shot, see the park branch
		IF TCS_command = E_TCSCommand.slew THEN
			bStopping := TRUE;	// #43, only if the preempted command is the one moving
		END_IF
	ELSIF bRestartGoto AND TCS_command = E_TCSCommand.goto THEN
		// #41: Track() while going to a target: stop, then go to the new one (bGoto stays set)
		bInterupted := TRUE;
		_GotoTelescope();
		bInterupted := FALSE;
		tonGotoTimeout(IN := FALSE, PT := T#600S);	// the timeout counts from the new request
		bStopping := TRUE;
	ELSE
		IF bReady AND NOT bBusy THEN
			bInterupted := FALSE;
			TCS_command := E_TCSCommand.goto;
		END_IF
	END_IF


ELSIF bSlew THEN
	bTrack := FALSE;
	IF bRestartSlew AND TCS_command = E_TCSCommand.slew THEN
		// #41: Slew() during a slew: stop, then slew to the new target (bSlew stays set)
		bInterupted := TRUE;
		_SlewTelescope();
		bInterupted := FALSE;
		tonSlewTimeout(IN := FALSE, PT := T#600S);	// the timeout counts from the new request
		bStopping := TRUE;
	ELSIF bReady AND NOT bBusy THEN
		TCS_command := E_TCSCommand.slew;
	END_IF
ELSIF bTrack THEN
	IF bReady AND NOT bBusy THEN
		TCS_command := E_TCSCommand.track;
	END_IF
ELSE
	TCS_command := E_TCSCommand.no_command;
	fbHourAngle.MoveAxis := FALSE;
	fbDeclination.MoveAxis := FALSE;
	fbHourAngle.bTracking := FALSE;
	fbDeclination.bTracking := FALSE;
END_IF
// the restart requests are consumed above or void
bRestartGoto := FALSE;
bRestartSlew := FALSE;
bUserStop := FALSE;

// #40: every command gets its own timeout; the timer used to run on from one command into the next
IF TCS_command <> eLastTimeoutCommand THEN
	tonCommandTimeout(IN := FALSE);
	eLastTimeoutCommand := TCS_command;
END_IF

IF TCS_command = E_TCSCommand.poweron THEN
	fReadyState := 0.7;
	_PowerOn();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.poweron, PT := T#12H);
	TCSCTOEvent.OnMessage := 'POWER';
ELSIF TCS_command = E_TCSCommand.stop THEN
	_StopTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.stop, PT := T#30S);	// #40: a stop from slew speed takes about 4 s, a preempting stop can follow a long move
	TCSCTOEvent.OnMessage := 'STOP';
ELSIF TCS_command = E_TCSCommand.park THEN
	fReadyState := 0.3;
	_ParkTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.park, PT := T#2M);
	TCSCTOEvent.OnMessage := 'PARK';
ELSIF TCS_command = E_TCSCommand.gohome THEN
	_HomeTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.gohome, PT := T#2M);
	TCSCTOEvent.OnMessage := 'GOHOME';
ELSIF TCS_command = E_TCSCommand.goto THEN
	_GotoTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.goto, PT := T#2M);
	TCSCTOEvent.OnMessage := 'GOTO';
ELSIF TCS_command = E_TCSCommand.slew THEN
	_SlewTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.slew, PT := T#2M);
	TCSCTOEvent.OnMessage := 'SLEW';
ELSIF TCS_command = E_TCSCommand.track THEN
	_TrackTelescope();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.track, PT := T#12H);
	TCSCTOEvent.OnMessage := 'TRACK';
ELSE
	// disable command timeout
	tonCommandTimeout(IN := FALSE);
	TCSCTOEvent.OnMessage := 'NOCOMMAND';
END_IF
//----------------------------------------------------------------------------------------------
(* STATUS BOOLS*)
bSliding := NOT bTracking AND (fbHourAngle.fbAxis.InMotion OR fbHourAngle.fbAxis.InRamp OR
			fbDeclination.fbAxis.InMotion OR fbDeclination.fbAxis.InRamp );

// signal must be stable for 1s
tonTrackingDelay(in := fbHourAngle.fbAxis.isTracking AND 
			fbDeclination.fbAxis.isTracking ,PT :=T#1000MS, Q => bTracking);

bStopped :=  (NOT fbHourAngle.bEnable OR fbHourAngle.fbAxis.StandStill) AND 
			(NOT fbDeclination.bEnable OR fbDeclination.fbAxis.StandStill);
			
bHomed := fbHourAngle.bCalibrated AND fbDeclination.bCalibrated AND (fbFocus <> 0 AND_THEN fbFocus.Calibrated);
			
bReady := bHomed AND 
	bIsPowered AND 
	fbHourAngle.bEnable AND
	fbDeclination.bEnable AND
	(fbFocus <> 0 AND_THEN fbFocus.Enable) AND
    NOT bError;

bBusy := fbHourAngle.fbAxis.Busy OR fbDeclination.fbAxis.Busy OR (fbFocus <> 0 AND_THEN fbFocus.Busy);
//----------------------------------------------------------------------------------------------
(* STATUS STATES*)
//fReadyState (see also _PowerOn and _ParkTelescope calls above)
IF bReady THEN
	fReadyState := 1.0;
ELSIF bError THEN
	fReadyState := -1.0;
ELSIF bIsParked THEN
	fReadyState := 0.0;
END_IF
//nMotionState
IF bStopped THEN
	nMotionState := 0;
ELSIF bSliding OR bBusy THEN
	nMotionState := 1;
ELSIF bTracking THEN
	nMotionState := 8;
END_IF
	
//----------------------------------------------------------------------------------------------
// unset the STOP command if telescope is already stopped
IF bStopped THEN
	bStop := FALSE;
END_IF

// unset the RESET command when no Error is present
IF NOT bError THEN
	bReset := FALSE;
END_IF

IF bEstopTriggered THEN
	fbHourAngle.Enable := FALSE;
	fbDeclination.Enable := FALSE;
END_IF
//----------------------------------------------------------------------------------------------
// send telemetry

IF bSliding OR bTrack OR bTracking THEN
	tonMQTTTimer.PT := T#1000MS; // during movement every second
ELSE
	tonMQTTTimer.PT := T#5000MS; // otherwise every five seconds
END_IF
tonMQTTTimer(IN:=TRUE);
IF tonMQTTTimer.Q THEN
	tonMQTTTimer(IN:=FALSE);
	THIS^._SendTelemetryEquitorial();
END_IF

//----------------------------------------------------------------------------------------------

(* Event function blocks start here. *)
TCSpowerEvent(	Trigger := bPowerFailure, 
				Level := ADSLOG_MSGTYPE_ERROR,
				FormatString := 'power %s',
				//OnMessage := 'Failure',
				OffMessage := 'OK', 
				Comm := fbComm);

TCSgohomeEvent.OffMessage := sHomeEnd;		// #75: "GOHOME completed" was also logged when the home was cancelled or timed out
TCSgohomeEvent(	Trigger := bGoHome, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'GOHOME %s',
				OnMessage := 'commencing',
				Comm := fbComm);
sHomeEnd := 'completed';
TCSparkEvent.OffMessage := sParkEnd;		// #57: "PARK completed" was also logged when the park was cancelled
TCSparkEvent(	Trigger := bPark,
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'PARK %s',
				OnMessage := 'commencing',
				Comm := fbComm);
sParkEnd := 'completed';
TCSgotoEvent(	Trigger := bGoto, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'GOTO %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed', 
				Comm := fbComm);
TCStrackEvent(	Trigger := bTrack, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'TRACK %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed', 
				Comm := fbComm);
TCSstopEvent(	Trigger := bStop, 
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := 'STOP %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed',
				OffLevel := ADSLOG_MSGTYPE_HINT, 
				Comm := fbComm);
TCStargetHorizonEvent(	Trigger := rtrigHorizonError.Q, 
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'Target below safe horizon, stopping telescope.',
				OffMEssage := '', 
				Comm := fbComm);
TCSaltitudeEvent(	Trigger := fElevationCurrent<MAX(fHorizon+2.0, fPointingSafeAltitude+2.0),
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'Telescope below safe horizon, aboard and slew telescope to home position.',
				OffMEssage := '', 
				Comm := fbComm);
TCSnearPoleEvent(	Trigger := rtrigPoleError.Q, 
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'Target to close to the celestial pole, stopping telescope.',
				OffMEssage := '', 
				Comm := fbComm);			
TCSreadyEvent(	Trigger := bReady, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := '%s',
				OnMessage := 'IAG50cm startup finished', 
				Comm := fbComm);
TCSparkErrorEvent(	Trigger := bParkInError,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				// OnMessage is set in the arbitration (three texts); a literal here overwrote it (#57)
				Comm := fbComm);
bParkInError := FALSE;
TCShomeCancelEvent(	Trigger := bHomeCancelled,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'Home request dropped: the telescope was not ready for 2 min. Power on, then send the home again.',
				Comm := fbComm);
bHomeCancelled := FALSE;
TCSpowerBlockedEvent(	Trigger := bPowerBlocked,
				Level := ADSLOG_MSGTYPE_ERROR,
				FormatString := '%s',
				Comm := fbComm);
bPowerBlocked := FALSE;
TCSsoftErrorEvent(	Trigger := bSoftwareError,
				Level := ADSLOG_MSGTYPE_ERROR,
				FormatString := 'Command timeout error %s',	// 16 goto, 32 park, 48 gohome, 64 slew (16#10, 16#20, 16#30, 16#40)
				OnMessage := UDINT_TO_STRING(nSoftwareErrorID),
				OffMessage := 'reset',
				Comm := fbComm);
TCSCTOEvent(	Trigger := tonCommandTimeout.Q,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := 'A timeout occured during %s command!',
				Comm := fbComm);]]></ST>
    </Implementation>
    <Folder Name="command methods" Id="{f8e9235d-f769-45dd-a5d6-c3922581f371}" />
    <Folder Name="internal methods" Id="{43f8a5dc-2166-4fdb-b436-34a8f62ea04a}" />
    <Folder Name="properties" Id="{65c2c08a-67b2-43de-bf16-65ce2beac397}" />
    <Method Name="_GotoTelescope" Id="{43ebaf76-c0fc-41db-8c98-2f7671dc6b31}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _GotoTelescope : USINT
VAR_INPUT
END_VAR
VAR
	GoToEvent		: FB_Eventlog;
END_VAR
VAR_INST
	nStage			: USINT := 0;
	nLastStage		: USINT := 101;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_GotoTelescope := nStage;
IF tonGotoTimeout.Q THEN	// MONETcommon#17: fed every scan in the body, a method-local TON never kept its state
	bSoftwareError := TRUE;		// #30: latched until a reset, bError is recomputed every scan
	nSoftwareErrorID := 16#10;
	bGoto := FALSE;
	nStage := 0;
	RETURN;
END_IF
IF bReset OR bError OR bStop OR bInterupted THEN
	nStage := 0;
	RETURN;
END_IF

CASE nStage OF
	0:	
		IF bReady AND NOT bBusy THEN
			nStage := 10;
		END_IF
	10:
		IF fbHourAngle.Tracking = TRUE OR fbDeclination.Tracking = TRUE THEN
			fbHourAngle.Tracking := FALSE;
			fbDeclination.Tracking := FALSE;
		ELSE
			nStage := 20;
		END_IF
	20:
		// send Dome position
		THIS^.fbDome.Position := fAzimuthCalc;
		// clear offsets
		THIS^.HourAngleOffset := 0.0;
		THIS^.DeclinationOffset := 0.0;
		// Declination (including offest and pointing model)
		fbDeclination.Position := fDeclinationApparent + fDeclinationOffset + fDeclinationPointingOffset;
		// HourAngle
		// change to -180 to 180 degree in HA
		IF MODABS(fHourAngleApparent + F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclinationApparent)+ fHourAnglePointingOffset, 360) > 180 THEN
			fbHourAngle.Position := MODABS(fHourAngleApparent + F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclination)+ fHourAnglePointingOffset,360) - 360.0;
		ELSE
			fbHourAngle.Position := MODABS(fHourAngleApparent + F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclination)+ fHourAnglePointingOffset,360);
		END_IF


		fbHourAngle.Velocity := fSlewVelocity;
		fbDeclination.Velocity := fSlewVelocity;
		
		// make sure to never drive under Horizon
		IF ABS(fbHourAngle.Position) < ABS(fHourAngleCurrent) THEN
			// move Ha then Dec
			nStage := 30;
		ELSE
			// move Dec then HA
			nStage := 40;
		END_IF
	// Stage 30: move Ha and then Dec
	30:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			nStage := 31;
		END_IF
	31:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   nStage := 32;
		END_IF
	32:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			nStage := 33;
		END_IF
	33:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   nStage := 75;
		END_IF
	// Stage 40: move Dec and then Ha
	40:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			nStage := 41;
		END_IF
	41:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   nStage := 42;
		END_IF
	42:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			nStage := 43;
		END_IF
	43:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   nStage := 75;
		END_IF

	75:
		IF NOT bSliding AND bStopped THEN // all axis standstill
			nStage := 100;
		END_IF
	100:
		bGoto := FALSE;
		// enable automatic tracking
		bTrack := bAutoTrack;
		nStage := 0;
END_CASE
GoToEvent(Trigger := nStage > nLastStage, FormatString := 'GOTO progress: %s', OnMessage := USINT_TO_STRING(nStage), comm := fbComm);
nLastStage := nStage;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_HomeTelescope" Id="{b2d9dfb4-bf7c-4f17-8ac5-7f074d6808c9}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _HomeTelescope : USINT
VAR_INPUT
END_VAR
VAR
	HomeEvent:	FB_Eventlog;
END_VAR
VAR_INST
	nStage:		USINT := 0;
	nLastStage:	USINT := 101;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_HomeTelescope := nStage;
IF tonHomeTimeout.Q THEN	// MONETcommon#17: fed every scan in the body
	bSoftwareError := TRUE;		// #30
	nSoftwareErrorID := 16#30;
	bGoHome := FALSE;	// like goto/slew; otherwise the expired timer would fire again right away
	sHomeEnd := 'timed out';
	nStage := 0;
	RETURN;		// #75: like goto/slew/park; bError is recomputed next scan, do not run the stages on
END_IF

IF bReset OR bError OR bStop OR bInterupted THEN
	nStage := 0;
	RETURN;
END_IF
CASE nStage OF
	0:	
		IF bReady AND bStopped AND NOT bBusy THEN
			nStage := 10;
		END_IF
	10:
		IF fbHourAngle.Tracking = TRUE OR fbDeclination.Tracking = TRUE THEN
			fbHourAngle.Tracking := FALSE;
			fbDeclination.Tracking := FALSE;
		ELSE
			nStage := 20;
		END_IF
	20:
		fbHourAngle.Position := telescopeConfig.hourangleHome;
		fbHourAngle.Velocity := fSlewVelocity;
		fbDeclination.Position := telescopeConfig.declinationHome;
		fbDeclination.Velocity := fSlewVelocity;
		
		// make sure to never drive under Horizon
		IF ABS(telescopeConfig.hourangleHome) < ABS(fHourAngleCurrent) THEN
			// move Ha then Dec
			nStage := 30;
		ELSE
			// move Dec then HA
			nStage := 40;
		END_IF
	// nStage 30: move Ha and then Dec
	30:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			nStage := 31;
		END_IF
	31:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   nStage := 32;
		END_IF
	32:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			nStage := 33;
		END_IF
	33:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   nStage := 100;
		END_IF
	// nStage 40: move Dec and then Ha
	40:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			nStage := 41;
		END_IF
	41:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   nStage := 42;
		END_IF
	42:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			nStage := 43;
		END_IF
	43:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   nStage := 100;
		END_IF
	100:
		fbFocus.Position := telescopeConfig.focusHome;
		fRightAscension := fRightAscensionCurrentICRS;
		fDeclination := fDeclinationCurrentICRS;
		bGoHome := FALSE;
		nStage := 0;
END_CASE

HomeEvent(Trigger := nStage > nLastStage, FormatString := 'GOHOME progress: %s', OnMessage := USINT_TO_STRING(nStage), comm := fbComm);
nLastStage := nStage;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ParkTelescope" Id="{94a12771-4c75-4743-9ad3-850f66878f1f}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _ParkTelescope : USINT
VAR_INPUT
END_VAR
VAR
	ParkEvent	: FB_Eventlog;
	bFocusMoving	: BOOL;
END_VAR
VAR_INST
	nStage		: USINT := 0;
	nLastStage	: USINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ParkTelescope := nStage;
IF tonParkTimeout.Q THEN	// fed every scan in the body, like the goto/home/slew timeouts
	bSoftwareError := TRUE;
	nSoftwareErrorID := 16#20;
	bPark := FALSE;
	sParkEnd := 'timed out';
	nStage := 0;
	RETURN;
END_IF
IF bReset OR bError OR bStop OR bInterupted THEN
	nStage := 0;
	RETURN;
END_IF
IF bIsParked THEN
	nStage := 100;
END_IF
CASE nStage OF
	0: 
		IF fbFocus <> 0 THEN
			fbFocus.Position := telescopeConfig.focusPark;
		END_IF
		// (the former "emergency park" under IF bError never ran: the method returns on bError above, and the
		// command is not even started while bError; a park during an error is handled in the arbitration)
		IF NOT bBusy THEN
			nStage := 10;
		END_IF
	10:
		fbDome.StopTrack();
		fbDome.Position := 180.0;
		IF fbHourAngle.Tracking = TRUE OR fbDeclination.Tracking = TRUE THEN
			fbHourAngle.Tracking := FALSE;
			fbDeclination.Tracking := FALSE;
		ELSE
			nStage := 20;
		END_IF
	20:
		fbDome.Park();
		THIS^.HourAngleOffset := 0.0;
		THIS^.DeclinationOffset := 0.0;
		fbHourAngle.Position := telescopeConfig.houranglePark;
		fbHourAngle.Velocity := fSlewVelocity;
		fbDeclination.Position := telescopeConfig.declinationPark;
		fbDeclination.Velocity := fSlewVelocity;
		
		// make sure to never drive under Horizon
		IF ABS(telescopeConfig.houranglePark) < ABS(fHourAngleCurrent) THEN
			// move Ha then Dec
			nStage := 30;
		ELSE
			// move Dec then HA
			nStage := 40;
		END_IF
	// Stage 30: move Ha and then Dec
	30:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			nStage := 31;
		END_IF
	31:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   nStage := 32;
		END_IF
	32:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			nStage := 33;
		END_IF
	33:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   nStage := 60;
		END_IF
	// Stage 40: move Dec and then Ha
	40:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			nStage := 41;
		END_IF
	41:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   nStage := 42;
		END_IF
	42:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			nStage := 43;
		END_IF
	43:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   nStage := 60;
		END_IF
	60:
		IF NOT fbHourAngle.Enable AND NOT fbDeclination.Enable THEN
			// #66: request the close once; repeating it every scan latched bClose in FB_CoverControl
			fbCovers.Close();
			nStage := 80;
		END_IF

		IF bStopped THEN
			fbHourAngle.Enable := FALSE;
			fbDeclination.Enable := FALSE;
		END_IF
		
		fbHourAngle.MoveAxis := FALSE;
		fbDeclination.MoveAxis := FALSE;
	80:
		// (the former "IF an axis is enabled THEN nStage := 60" was overwritten by the line below and never took
		// effect; nothing enables an axis while the park runs, _PowerOn is a different command)
		// #56: the focus move to focusPark starts at stage 0. A park from home does not move the mount, so the axes
		// are off after about a second and the focus enable was removed while it was still moving (error 16992
		// "Controller enable"). Wait until it has arrived or stopped (at most 60 s), then disable it.
		bFocusMoving := fbFocus <> 0 AND_THEN (fbFocus.Calibrated AND (fbFocus.Busy OR ABS(fbFocus.Position - fbFocus.ActualPosition) > 0.05));
		tonParkFocus(IN := bFocusMoving, PT := T#60S);
		IF NOT bFocusMoving OR tonParkFocus.Q THEN
			IF fbFocus <> 0 THEN
				fbFocus.Enable := FALSE;
			END_IF
			tonParkFocus(IN := FALSE);
			nStage := 90;
		END_IF
	90:
		IF fbCovers.Closed THEN
			nStage := 100;
		END_IF
	100:
		bIsPowered:=FALSE;
		bIsParked := TRUE;
		bPark := FALSE;
		_ParkTelescope := 100;
		nStage := 0;	
END_CASE
ParkEvent(Trigger := nStage > nLastStage, FormatString := 'Parking progress: %s', OnMessage := USINT_TO_STRING(nStage), comm := fbComm);
nLastStage := nStage;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ResetErroredAxes" Id="{5e8a3c17-9b42-4d06-a1f3-6c0d7e92b4a8}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #11: reset every axis that has an error, also a hidden one (nErrorID set with the error flag FALSE)
METHOD PRIVATE _ResetErroredAxes
VAR_INPUT
	bAll	: BOOL;		// also reset axes that are not enabled (#55), the second pass after the acknowledge
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fbHourAngle.Error OR fbHourAngle.nErrorID <> 0 OR (bAll AND NOT fbHourAngle.Enable) THEN
	fbHourAngle.Reset();
END_IF
IF fbDeclination.Error OR fbDeclination.nErrorID <> 0 OR (bAll AND NOT fbDeclination.Enable) THEN
	fbDeclination.Reset();
END_IF
IF fbFocus <> 0 AND_THEN (fbFocus.Error OR fbFocus.ErrorID <> 0 OR (bAll AND NOT fbFocus.Enable)) THEN
	fbFocus.Reset();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_PowerOnBlockedReason" Id="{7c1e4b52-3a9d-4f60-b8e5-5d2f0a6c91e3}" FolderPath="internal methods\">
      <Declaration><![CDATA[// #39: the reason a power-on cannot start, as one line for the ADS log. First match wins.
METHOD PRIVATE _PowerOnBlockedReason : STRING(120)
VAR
	sAxis		: STRING(8);
	nId			: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bEstopTriggered THEN
	_PowerOnBlockedReason := 'Power-on blocked: E-stop pressed. Release it, then reset.';
	RETURN;
END_IF

// the axis ids are used even when bError is FALSE (a hidden NC error, HA 16933 on 2026-10-12)
IF fbHourAngle.nErrorID <> 0 THEN
	sAxis := 'HA';
	nId := fbHourAngle.nErrorID;
ELSIF fbDeclination.nErrorID <> 0 THEN
	sAxis := 'Dec';
	nId := fbDeclination.nErrorID;
ELSIF fbFocus <> 0 AND_THEN fbFocus.ErrorID <> 0 THEN
	sAxis := 'Focus';
	nId := fbFocus.ErrorID;
END_IF

IF nId <> 0 THEN
	IF nId = 18000 OR nId = 19209 THEN
		// drive hardware not ready / axis not ready: the drives are in STO until the safety is acknowledged
		_PowerOnBlockedReason := CONCAT(CONCAT(CONCAT(CONCAT('Power-on blocked: safety not acknowledged (', sAxis), ' '), UDINT_TO_STRING(nId)), '). Reset the telescope (cabinet key or reset command).');
	ELSE
		_PowerOnBlockedReason := CONCAT(CONCAT(CONCAT(CONCAT('Power-on blocked: ', sAxis), ' error '), UDINT_TO_STRING(nId)), '. Reset the telescope.');
	END_IF
ELSIF bSafetyAckPending THEN
	_PowerOnBlockedReason := 'Power-on blocked: safety not acknowledged after the E-stop. Reset the telescope (cabinet key or reset command).';
ELSIF bSoftwareError THEN
	_PowerOnBlockedReason := CONCAT(CONCAT('Power-on blocked: command timeout error ', UDINT_TO_STRING(nSoftwareErrorID)), '. Reset the telescope.');
ELSE
	_PowerOnBlockedReason := 'Power-on blocked: telescope error. Reset the telescope.';
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_PowerOn" Id="{1dafa267-4251-4a45-a8e2-ae0ece289894}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _PowerOn : USINT
VAR_INPUT
END_VAR
VAR
	PowerOnEvent	: FB_Eventlog;
END_VAR
VAR_INST
	nStage		: USINT := 0;
	nLastStage	: USINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #59: also refused while the safety acknowledge after an E-stop is pending. While the reset is running
// (bAxisResetAfterAck) the power-on waits at stage 0 as before; the acknowledge ends before that wait does.
IF bError OR (bSafetyAckPending AND NOT bAxisResetAfterAck) THEN
	bPowerFailure := TRUE;
	TCSpowerEvent.OnMessage := 'failed';
	// #39: say why, on every refused request. bPowerFailure stays TRUE until a power-on succeeds, so it gives
	// no new edge for the second request and logged nothing; this one-scan flag does.
	TCSpowerBlockedEvent.OnMessage := _PowerOnBlockedReason();
	bPowerBlocked := TRUE;
	bPower := FALSE;
ELSE
	bPowerFailure := FALSE;		
END_IF

_PowerOn := nStage;
// #69: a power-on only runs while it is requested. Stage 100 clears bPower, but TCS_command stays poweron until
// the go-home takes over, so _PowerOn kept being called and restarted its stages; the go-home then left nStage at
// 10 or 20 and the next power=1 resumed there, skipping the wait for the safety acknowledge in stage 0.
IF NOT bPower OR bReset OR bError OR bStop OR bInterupted THEN
	nStage := 0;
	RETURN;
END_IF

CASE nStage OF
	0:
		// #55: wait for the axis reset that follows the safety acknowledge (at most 2.5 s); enabling the axes before
		// it gave 18000 on HA and Dec
		IF NOT bAxisResetAfterAck THEN
			bIsParked := FALSE;
			IF bCoverAutoOpen THEN
				// check if covers should automatic open
				nStage := 10;
			ELSE
				nStage := 40;
			END_IF
		END_IF
	10:
		// COVER MUST BE OPENED FOR A SUCCESSFUL WAKE & SHAKE COMMAND!
		IF NOT fbCovers.Opened THEN
			fbCovers.Open();
		END_IF
		nStage := 20;
	20:
		IF bMainReady AND fbCovers.Opened THEN
			nStage := 40;
		END_IF
	40:
		// enable hourangle, enable declination
		// #69: never while the safety acknowledge runs (the drives are still in STO: 0x441C, then 4225 on HA)
		IF NOT bAxisResetAfterAck THEN
			fbHourAngle.Enable := TRUE;
			fbDeclination.Enable := TRUE;
			IF fbHourAngle.Calibrated AND fbDeclination.Calibrated THEN
				nStage := 70;
			END_IF
		END_IF
	70:
		// if Focus, enable and calibrate
		IF fbFocus <> 0 THEN
			fbFocus.Enable := TRUE;
			fbFocus.Position := telescopeConfig.focusPark;
			IF fbFocus.Calibrated THEN
				nStage := 100;
			END_IF
		ELSE
			nStage := 100;
		END_IF
	100:
		//PowerOn is done, set bPower to False
		bPower := FALSE;
		bIsPowered := TRUE;
		// slew the telescope to the home position
		bGoHome := TRUE;
		// set dome to tracking
		fbDome.Position := 180.0;// reset Dome position
		fbDome.Track();
		_PowerOn := 100;
		nStage := 0;	
END_CASE
PowerOnEvent(Trigger := nStage > nLastStage, FormatString := 'PowerOn progress: %s', OnMessage := USINT_TO_STRING(nStage), comm := fbComm);
nLastStage := nStage;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SendTelemetryEquitorial" Id="{2e72b74c-93b9-406f-985e-048a1bd902d8}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD _SendTelemetryEquitorial : BOOL
VAR_INPUT

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Open TSI / TCI standart *)

(* TELESCOPE module*)

fbComm.Publish('telescope', 'dome', 'TELESCOPE.READY_STATE',	LREAL_TO_STRING(fReadyState));
fbComm.Publish('telescope', 'dome', 'TELESCOPE.MOTION_STATE',	LREAL_TO_STRING(nMotionState));

// INFO
fbComm.Publish('telescope', 'dome', 'TELESCOPE.INFO.NAME',	telescopeConfig.name);
fbComm.Publish('telescope', 'dome', 'TELESCOPE.INFO.DIAMETER',	LREAL_TO_STRING(telescopeConfig.diameter));
fbComm.Publish('telescope', 'dome', 'TELESCOPE.INFO.CABINET',	telescopeConfig.cabinet);
fbComm.Publish('telescope', 'dome', 'TELESCOPE.INFO.MANUFACTURER', telescopeConfig.manufacturer);

// CONFIG
IF fbDome <> 0 THEN
	fbComm.Publish('telescope', 'dome', 'TELESCOPE.CONFIG.CAPABILITIES', INT_TO_STRING(fbDome.Capabilities));
ELSE
	fbComm.Publish('telescope', 'dome', 'TELESCOPE.CONFIG.CAPABILITIES', '0');
END_IF
fbComm.Publish('telescope', 'dome', 'TELESCOPE.CONFIG.MOUNTOPTIONS', telescopeConfig.mountOptions);
fbComm.Publish('telescope', 'dome', 'TELESCOPE.CONFIG.MOUNT', telescopeConfig.mount);

// STATUS
IF bEstopTriggered THEN
	fbComm.Publish('telescope', 'dome', 'TELESCOPE.STATUS.GLOBAL', '1');
ELSIF bError THEN
	fbComm.Publish('telescope', 'dome', 'TELESCOPE.STATUS.GLOBAL', '2');
ELSE
	fbComm.Publish('telescope', 'dome', 'TELESCOPE.STATUS.GLOBAL', '0');
END_IF

IF bLocalMode THEN
	fbComm.Publish('telescope', 'dome', 'TELESCOPE.STATUS.LOCAL_MODE', '1');
ELSE
	fbComm.Publish('telescope', 'dome', 'TELESCOPE.STATUS.LOCAL_MODE', '0');
END_IF
(* ERROR LIST: TO BE IMPLEMENTED!!!*)

(* OBJECT Module*)
// Set Coords from outside | GoTo:RA DEC | Slew:Alt Az

// INSTRUMENTAL
fbComm.Publish('telescope', 'dome', 'OBJECT.INSTRUMENTAL.DEC', LREAL_TO_STRING(fDeclinationApparent + fDeclinationOffset + fDeclinationPointingOffset));
// change to -180 to 180 degree in HA
IF MODABS(fHourAngleApparent + F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclination)+ fHourAnglePointingOffset, 360) > 180 THEN
	fbComm.Publish('telescope', 'dome', 'OBJECT.INSTRUMENTAL.HA', LREAL_TO_STRING(MODABS(fHourAngleApparent + F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclinationApparent)+ fHourAnglePointingOffset,360)- 360.0));
ELSE
	fbComm.Publish('telescope', 'dome', 'OBJECT.INSTRUMENTAL.HA', LREAL_TO_STRING(MODABS(fHourAngleApparent + F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclinationApparent)+ fHourAnglePointingOffset,360)));
END_IF

// HORIZONTAL
IF bSlew THEN
	fbComm.Publish('telescope', 'dome', 'OBJECT.HORIZONTAL.ALT', LREAL_TO_STRING(fElevation));
	fbComm.Publish('telescope', 'dome', 'OBJECT.HORIZONTAL.AZ', LREAL_TO_STRING(fAzimuth));
ELSE
	fbComm.Publish('telescope', 'dome', 'OBJECT.HORIZONTAL.ALT', LREAL_TO_STRING(fElevationCalc));
	fbComm.Publish('telescope', 'dome', 'OBJECT.HORIZONTAL.AZ', LREAL_TO_STRING(fAzimuthCalc));
END_IF

//EQUATORIAL
fbComm.Publish('telescope', 'dome', 'OBJECT.EQUATORIAL.EPOCH', 'J2000.0');
fbComm.Publish('telescope', 'dome', 'OBJECT.EQUATORIAL.EQUINOX', 'J2000.0');
fbComm.Publish('telescope', 'dome', 'OBJECT.EQUATORIAL.RA_PM', '0.0');
fbComm.Publish('telescope', 'dome', 'OBJECT.EQUATORIAL.DEC_PM', '0.0');
fbComm.Publish('telescope', 'dome', 'OBJECT.EQUATORIAL.RA_RATE', '0.0');
fbComm.Publish('telescope', 'dome', 'OBJECT.EQUATORIAL.DEC_RATE', '0.0');
fbComm.Publish('telescope', 'dome', 'OBJECT.EQUATORIAL.RA', LREAL_TO_STRING(fRightAscension));	// degrees (BROTLib#37)
fbComm.Publish('telescope', 'dome', 'OBJECT.EQUATORIAL.DEC', LREAL_TO_STRING(fDeclination));
fbComm.Publish('telescope', 'dome', 'OBJECT.EQUATORIAL.HA_APPARENT', LREAL_TO_STRING(fHourAngleApparent));
fbComm.Publish('telescope', 'dome', 'OBJECT.EQUATORIAL.DEC_APPARENT', LREAL_TO_STRING(fDeclinationApparent));


(* POINTING *)
fbComm.Publish('telescope', 'dome', 'POINTING.SLEWTIME', LREAL_TO_STRING(fSlewtime));
fbComm.Publish('telescope', 'dome', 'POINTING.OFFSETS.HA', LREAL_TO_STRING(fHourAnglePointingOffset));
fbComm.Publish('telescope', 'dome', 'POINTING.OFFSETS.DEC', LREAL_TO_STRING(fDeclinationPointingOffset));


(*POSITION*)
//LOCAL
fbComm.Publish('telescope', 'dome', 'POSITION.LOCAL.SIDEREAL_TIME', LREAL_TO_STRING(fLst));
fbComm.Publish('telescope', 'dome', 'POSITION.LOCAL.JD', LREAL_TO_STRING(fJd));
fbComm.Publish('telescope', 'dome', 'POSITION.LOCAL.LATITUDE', LREAL_TO_STRING(telescopeConfig.latitude));
fbComm.Publish('telescope', 'dome', 'POSITION.LOCAL.LONGITUDE', LREAL_TO_STRING(telescopeConfig.longitude));
fbComm.Publish('telescope', 'dome', 'POSITION.LOCAL.HEIGHT', LREAL_TO_STRING(telescopeConfig.altitude));
//INSTRUMENTAL
// > DEC
// POWER_STATE
IF fbDeclination.Enable THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.POWER_STATE', '1.0');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.POWER_STATE', '0.0');
END_IF
//REFERENCED
IF fbDeclination.Calibrated THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.REFERENCED', '1.0');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.REFERENCED', '0.0');
END_IF
//ERROR_STATE
IF fbDeclination.Error THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.ERROR_STATE', UDINT_TO_STRING(fbDeclination.ErrorID));
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.ERROR_STATE', '0');
END_IF
//MOTION_STATE
IF fbDeclination.Busy THEN
	IF fbDeclination.isTracking THEN
		fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.MOTION_STATE', '8');
	ELSE
		fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.MOTION_STATE', '1');
	END_IF
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.MOTION_STATE', '0');
END_IF
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.REALPOS', LREAL_TO_STRING(fDeclinationCurrent-fDeclinationOffset));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.CURRPOS', LREAL_TO_STRING(fDeclinationCurrent));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.TARGETPOS', LREAL_TO_STRING(fbDeclination.Position));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.CURRSPEED', LREAL_TO_STRING(fbDeclination.Velocity));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.TARGETDISTANCE', LREAL_TO_STRING(ABS(fDeclinationCurrent-fbDeclination.Position)));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.DEC.OFFSET', LREAL_TO_STRING(fDeclinationOffset));

// > HA
// POWER_STATE
IF fbHourAngle.Enable THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.POWER_STATE', '1.0');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.POWER_STATE', '0.0');
END_IF
//REFERENCED
IF fbHourAngle.Calibrated THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.REFERENCED', '1.0');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.REFERENCED', '0.0');
END_IF
//ERROR_STATE
IF fbHourAngle.Error THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.ERROR_STATE', UDINT_TO_STRING(fbHourAngle.ErrorID));
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.ERROR_STATE', '0');
END_IF
//MOTION_STATE
IF fbHourAngle.Busy THEN
	IF fbHourAngle.isTracking THEN
		fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.MOTION_STATE', '8');
	ELSE
		fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.MOTION_STATE', '1');
	END_IF
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.MOTION_STATE', '0');
END_IF

fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.CURRPOS', LREAL_TO_STRING(fHourAngleCurrent));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.REALPOS', LREAL_TO_STRING(fHourAngleCurrent-F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclinationApparent)));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.TARGETPOS', LREAL_TO_STRING(fbHourAngle.Position));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.CURRSPEED', LREAL_TO_STRING(fbHourAngle.Velocity));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.TARGETDISTANCE', LREAL_TO_STRING(ABS(fHourAngleCurrent-fbHourAngle.Position)));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.HA.OFFSET', LREAL_TO_STRING(fHourAngleOffset));

// > FOCUS
// POWER_STATE
IF fbFocus.Enable THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.POWER_STATE', '1.0');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.POWER_STATE', '0.0');
END_IF
//REFERENCED
IF fbFocus.Calibrated THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.REFERENCED', '1.0');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.REFERENCED', '0.0');
END_IF
//ERROR_STATE
IF fbFocus.Error THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.ERROR_STATE', UDINT_TO_STRING(fbHourAngle.ErrorID));
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.ERROR_STATE', '0');
END_IF
//MOTION_STATE
IF fbFocus.Busy THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.MOTION_STATE', '1');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.MOTION_STATE', '0');
END_IF
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.CURRPOS', LREAL_TO_STRING(fbFocus.ActualPosition));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.REALPOS', LREAL_TO_STRING(fbFocus.ActualPosition));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.TARGETPOS', LREAL_TO_STRING(fbFocus.Position));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.TARGETDISTANCE', LREAL_TO_STRING(ABS(fbFocus.ActualPosition-fbFocus.Position)));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.CURRSPEED', LREAL_TO_STRING(fbFocus.Velocity));


(*HORIZONTAL*)
fbComm.Publish('telescope', 'dome', 'POSITION.HORIZONTAL.ALT', LREAL_TO_STRING(fElevationCurrentSky));
fbComm.Publish('telescope', 'dome', 'POSITION.HORIZONTAL.AZ', LREAL_TO_STRING(fAzimuthCurrentSky));
fbComm.Publish('telescope', 'dome', 'POSITION.HORIZONTAL.DOME', LREAL_TO_STRING(fbDome.Position));

(*EQUITORIAL*)
fbComm.Publish('telescope', 'dome', 'POSITION.EQUATORIAL.RA_ICRS', LREAL_TO_STRING(fRightAscensionCurrentICRScorr));	// degrees (BROTLib#37)
fbComm.Publish('telescope', 'dome', 'POSITION.EQUATORIAL.DEC_ICRS', LREAL_TO_STRING(fDeclinationCurrentICRScorr));
fbComm.Publish('telescope', 'dome', 'POSITION.EQUATORIAL.HA_APPARENT', LREAL_TO_STRING(fHourAngleCurrent - fHourAngleInversionOffset - F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclinationApparent)));
fbComm.Publish('telescope', 'dome', 'POSITION.EQUATORIAL.DEC_APPARENT', LREAL_TO_STRING(fDeclinationCurrent - fDeclinationInversionOffset - fDeclinationOffset));
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SlewTelescope" Id="{4aaca2e7-2dba-4c2d-80b3-cd4dcc5ad38b}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _SlewTelescope : USINT
VAR_INPUT
END_VAR
VAR
	SlewEvent:	FB_Eventlog;
END_VAR
VAR_INST
	nStage:		USINT := 0;
	nLastStage:	USINT := 101;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SlewTelescope := nStage;
IF tonSlewTimeout.Q THEN	// MONETcommon#17: fed every scan in the body
	bSoftwareError := TRUE;		// #30
	nSoftwareErrorID := 16#40;
	bSlew := FALSE;
	nStage := 0;
	RETURN;
END_IF
IF bReset OR bError OR bStop OR bInterupted THEN
	nStage := 0;
	RETURN;
END_IF
CASE nStage OF
	0:	
		// #42: not gated on bStopped/bTracking any more, stage 10 ends the tracking (like the goto). Waiting for
		// both here hung a slew sent while tracking: the arbitration had already dropped the track command.
		IF bReady AND NOT bBusy THEN
			nStage := 10;
		END_IF
	10:
		IF fbHourAngle.Tracking = TRUE OR fbDeclination.Tracking = TRUE THEN
			fbHourAngle.Tracking := FALSE;
			fbDeclination.Tracking := FALSE;
		ELSE
			nStage := 20;
		END_IF
	20:
		// send Dome position
		THIS^.fbDome.Position := fAzimuth;
		THIS^.HourAngleOffset := 0.0;
		THIS^.DeclinationOffset := 0.0;
		// write the calculated coordinates into the goto coordinates
		THIS^.fDeclination := fDeclinationCalc;
		THIS^.fRightAscension := fRightAscensionCalc;
		nStage := 25;
	25:
		// Declination (including pointing model)
		fbDeclination.Position := fDeclinationCalc + fDeclinationPointingOffset;
		// HourAngle
		// change to -180 to 180 degree in HA
		IF MODABS(fHourangleCalc + fHourAnglePointingOffset, 360) > 180 THEN
			fbHourAngle.Position := MODABS(fHourangleCalc + fHourAnglePointingOffset,360) - 360.0;
		ELSE
			fbHourAngle.Position := MODABS(fHourangleCalc + fHourAnglePointingOffset,360);
		END_IF
		
		fbHourAngle.Velocity := fSlewVelocity;
		fbDeclination.Velocity := fSlewVelocity;
		// make sure to never drive under Horizon
		IF ABS(fbHourAngle.Position) < ABS(fHourangleCalc) THEN
			// move Ha then Dec
			nStage := 30;
		ELSE
			// move Dec then HA
			nStage := 40;
		END_IF
	// Stage 30: move Ha and then Dec
	30:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			nStage := 31;
		END_IF
	31:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   nStage := 32;
		END_IF
	32:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			nStage := 33;
		END_IF
	33:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   nStage := 75;
		END_IF
	// Stage 40: move Dec and then Ha
	40:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			nStage := 41;
		END_IF
	41:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   nStage := 42;
		END_IF
	42:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			nStage := 43;
		END_IF
	43:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   nStage := 75;
		END_IF
	75:
		IF NOT bSliding AND bStopped THEN // all axis standstill
			nStage := 100;
		END_IF
	100:
		fbHourAngle.MoveAxis := FALSE;
		fbDeclination.MoveAxis := FALSE;

		bSlew := FALSE;
		nStage := 0;
END_CASE
SlewEvent(Trigger := nStage > nLastStage, FormatString := 'Slew progress: %s', OnMessage := USINT_TO_STRING(nStage), comm := fbComm);
nLastStage := nStage;		
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_StopTelescope" Id="{cc9583d1-2578-4480-8aee-f6d55f373bf1}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _StopTelescope : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fbHourAngle.Tracking = TRUE OR fbDeclination.Tracking = TRUE THEN
	fbHourAngle.Tracking := FALSE;
	fbDeclination.Tracking := FALSE;
ELSIF fbHourAngle.MoveAxis = TRUE OR  fbDeclination.MoveAxis = TRUE THEN
	fbHourAngle.MoveAxis := FALSE;
	fbDeclination.MoveAxis := FALSE;
ELSE
	// Only issue Axis stop commands if they are moving
	IF NOT fbHourAngle.fbAxis.StandStill THEN
		fbHourAngle.StopAxis := TRUE;
	ELSE
		fbHourAngle.StopAxis := FALSE;
	END_IF
	
	IF NOT fbDeclination.fbAxis.StandStill THEN
		fbDeclination.StopAxis := TRUE;
	ELSE
		fbDeclination.StopAxis := FALSE;
	END_IF	

	IF bStopped THEN
		fbHourAngle.StopAxis := FALSE;
		fbDeclination.StopAxis := FALSE;
		_StopTelescope := FALSE;
	END_IF
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="_TrackTelescope" Id="{0dd53d55-2f74-4268-9438-8bb832d1c59b}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _TrackTelescope : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// send Dome position
THIS^.fbDome.Position := fAzimuthCurrent;
// Declination (including offest and pointing model)
fbDeclination.Position := fDeclinationApparent + fDeclinationOffset + fDeclinationPointingOffset;
// HourAngle
// change to -180 to 180 degree in HA
IF MODABS(fHourAngleApparent + F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclinationApparent)+ fHourAnglePointingOffset, 360) > 180 THEN
	fbHourAngle.Position := MODABS(fHourAngleApparent + F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclinationApparent)+ fHourAnglePointingOffset,360) - 360.0;
ELSE
	fbHourAngle.Position := MODABS(fHourAngleApparent + F_HourAngleOffsetOnAxis(fHourAngleOffset, fDeclinationApparent)+ fHourAnglePointingOffset,360);
END_IF


IF NOT fbHourAngle.Tracking THEN
	fbHourAngle.Velocity := 1.0;
	fbHourAngle.MoveAxis := TRUE;
	IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
		fbHourAngle.MoveAxis := FALSE;
		IF fbHourAngle.isTracking THEN
			fbHourAngle.Velocity := fHourAngleVelocity;
		END_IF
		fbHourAngle.Tracking := TRUE;
	END_IF
ELSE
	fbHourAngle.Velocity := fHourAngleVelocity;
END_IF


IF NOT fbDeclination.Tracking THEN
	fbDeclination.Velocity := 1.0;
	fbDeclination.MoveAxis := TRUE;
	IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
		fbDeclination.MoveAxis := FALSE;
		IF fbDeclination.isTracking THEN
			fbDeclination.Velocity := fDeclinationVelocity;
		END_IF
		fbDeclination.Tracking := TRUE;
	END_IF
ELSE
	fbDeclination.Velocity := fDeclinationVelocity;
END_IF
]]></ST>
      </Implementation>
    </Method>
