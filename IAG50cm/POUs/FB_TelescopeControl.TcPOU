<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_TelescopeControl" Id="{10c2c294-efcf-424f-afd3-75ac57a5e8bc}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TelescopeControl IMPLEMENTS I_RaDecTelescope, I_Telescope
VAR_INPUT
(*
TCS interface section
see https://gitlab.aip.de/bmk10k/telescope_firmware/snippets/5
*)
	bPower				: BOOL;		// true: Power on
	bGoHome				: BOOL;		// true: go to home position, unset track/goto if active
	bPark				: BOOL;		// boolean, true: go into park position, ready to stow telescope, unset track/goto
	bTrack				: BOOL;		// boolean, TRUE: MOVE telescope TO last ra/de AND start tracking. Set 'goto' TO FALSE, IF TRUE. FALSE: Stop tracking as soon as possible
	bGoto				: BOOL;		// boolean, TRUE: MOVE telescope TO tau/de AND stop there. Set track TO FALSE, IF TRUE. FALSE: no effect.)	
	bSlew				: BOOL;		// move the telescope to a given az-alt position
	bStop				: BOOL;		// boolean, TRUE: Stop motion OF telescope immediately, set goto AND track TO FALSE. FALSE: Allow motion OF telescope again via track/goto).	
	bReset				: BOOL;		// initiates reset on all axis
	bAutoTrack			: BOOL := TRUE;	// automatic tracking after goto
	fRightAscension		: LREAL :=  0.0;	// apparent right ascension, degrees, double	
	fDeclination		: LREAL :=  0.0;	// apparent declination, degrees, double
	fElevation			: LREAL :=  0.0;	// desired elevation of the telescope pointing
	fAzimuth			: LREAL :=  0.0;	// desired azimut of the telescope pointing
	fHourAngleOffset	: LREAL := 0.0;		// absolute offset for right ascension
	fDeclinationOffset 	: LREAL := 0.0;		// absolute offset for declination
	fTimeOffset			: LREAL := 0.0;		// absolute offset for time
	fHorizon			: LREAL := 1.0;		// ELEVATION below which value the telescope will not go
	fPoleZone			: LREAL := 3.0;		// 90° - fPoleZone = No go Zone near the Pole
	
	fSlewVelocity		: LREAL := 4.0;		// Motor velocity for moving the telescope in degree/s
	
	bEstopTriggered		: BOOL	:= FALSE;	// TODO: CHANGE
	bMainReady			: BOOL	:= TRUE;
	
	fbFocus				: I_Focus;
	fbCovers			: I_MirrorCovers;
	fbDome				: I_Dome;

	fbHourAngle			: REFERENCE TO FB_HourAngleControl;
	fbDeclination		: REFERENCE TO FB_DeclinationControl;

	telescopeConfig		: ST_TelescopeConfig;
END_VAR
VAR
	comm 				: I_Comm;
	fbCabinet			: FB_CabinetControl;
	
	TCS_command			: E_TCSCommand;	// actual command from the TCS
	jd					: LREAL;	// current Julian Date calculated from system time
	lst					: LREAL;	// local siderial time calculated from Julian date in hours
	elevation_calc		: LREAL;	// elevation calulated when ra and dec are set by TCS 
	azimuth_calc		: LREAL;	// azimuth calulated when ra and dec are set by TCS
	fHourAngle			: LREAL;	// hourangle when ra and dec are set by TCS
	
	rightascension_calc	: LREAL;	// right ascension calulated when azimuth and elevation are set by TCS
	declination_calc	: LREAL;	// declination calulated when azimuth and elevation are set by TCS
	hourangle_calc		: LREAL;	// hour angle azimuth and elevation are set by TCS
	
	fHourAnglePointingOffset	: LREAL; // pointing offset to sky
	fDeclinationPointingOffset	: LREAL; // pointing offset to sky
	fHourAngleInversionOffset	: LREAL;
	fDeclinationInversionOffset : LREAL;
	fHourAngleVelocity			: LREAL;	// rotational velocity of the HourAngle
	fDeclinationVelocity		: LREAL;	// rotational velocity of the Declination
	fbTime				: FB_AstroClock;	// precise astronomical	time
	eq2hor				: FB_EQ2HOR;
	hor2eq				: FB_HOR2EQ;
	ha2ra				: FB_HA2RA;
	fbPointingForward	: FB_PointingModelForward;
	fbPointingInversion : FB_PointingModelInversion;
	
	reset_trigger		: R_TRIG;
	bInterupted			: BOOL;		// If a command is interuped by one with more presedence, the interupted needs to reset its stage
	
	powerfailure		: BOOL;		// triggers power-failure event
	poweronwarning		: TP;		// triggers power warning
	power_timeout		: TON;		// power on timeout
	command_timeout		: TON;		// command timeout
	tracking_delay		: TON;		// tracking delay
	isparked			: BOOL;		// telescope is parked
	TCSpowerEvent,
	TCSgohomeEvent,
	TCSparkEvent,
	TCSgotoEvent,
	TCStrackEvent,
	TCSstopEvent,
	TCStargetHorizonEvent,
	TCSaltitudeEvent,
	TCSnearPoleEvent,
	TCSreadyEvent,
	TCSCTOEvent			: FB_Eventlog;
	MQTTTimer 			: TON := (PT:=T#5S);
	
	

	StatusWord, LastStatus:	UDINT;
END_VAR
VAR_OUTPUT
	bReady				: BOOL;		// TRUE, IF telescope can be operated 
	bError				: BOOL;		// indicates an error on one of the components
	bHorizonError		: BOOL;		// if TRUE, the set Coordinate is below the Horizon threshold fHorizon
	errorid				: UDINT;	//error id of axis	
	bSliding			: BOOL;		//TRUE, IF telescope is in fast-MOVE phase (includes pole-swap)	
	bTracking			: BOOL;		//TRUE, IF telescope is on tracking position AND currently tracking.	
	bStopped			: BOOL;		//TRUE, IF telescope is AT rest.	
	hourangle_current	: LREAL;	// true position of the hour angle (without pointing and offset correction)
	declination_current	: LREAL;	// true position of the declination (without pointing and offset correction)
	rightascension_current: LREAL;	// true position of the right ascension (without pointing and offset correction)
	elevation_current	: LREAL;	// current position in elevation (calculated) (without pointing and offset correction)
	azimuth_current		: LREAL;	// current position in azimuth (calculated) (without pointing and offset correction)
	elevation_current_sky	: LREAL;	// current position in elevation (calculated)
	azimuth_current_sky		: LREAL;	// current position in azimuth (calculated)
	slewtime			: LREAL;	//	(time in sec. to reach the goto/track position) 
	bHomed				: BOOL;		// True: telescope is calibrated
	bBusy				: BOOL;		// telescope does not accept further commands
END_VAR
VAR CONSTANT
	d2r		: LREAL := PI/180.0;
	siderial_velocity: LREAL := 360.0 / 86164.099;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// get the system time
fbTime();
jd := DateTime2JD(fbTime.time_RTCEX2);
lst := CT2LST(telescopeConfig.longitude, jd);

// State of the Cabinet
fbCabinet();

// set reset state either by hardware (key pressed) or by software (set by e.g. tcs)


reset_trigger(CLK := bReset);

IF bReset THEN
	bHorizonError := FALSE; // if reset, the bHorizonError can be switched off
	
	// reset the stages of all statemachine methods
	bInterupted := TRUE; 
	_HomeTelescope();
	_GotoTelescope();
	_SlewTelescope();
	_ParkTelescope();
	bInterupted := FALSE;
END_IF

// get error ID, reset if bReset command is set
IF fbHourAngle.Error THEN
	errorid := fbHourAngle.nErrorID;
	IF bReset THEN
		fbHourAngle.Reset();
	END_IF
ELSIF fbDeclination.bError THEN
	errorid := fbDeclination.nErrorID;
	IF bReset THEN
		fbDeclination.Reset();
	END_IF
ELSIF fbFocus <> 0 AND_THEN fbFocus.Error THEN
	errorid := fbFocus.ErrorID;
	IF bReset THEN
		fbFocus.Reset();
	END_IF
END_IF

// slewtime
slewtime := fbHourAngle.fSlewTime + fbDeclination.fSlewTime;

// ERROR (either one of the Axis or below safe Horizon (fHorizon))
bError := fbHourAngle.Error OR fbDeclination.Error OR(fbFocus <> 0 AND_THEN fbFocus.Error) OR bHorizonError OR fbCabinet.Error;
			
IF bError THEN
	bGoHome := 	FALSE;
	bTrack := 	FALSE;
	bGoto := 	FALSE;
	bSlew := 	FALSE;
	fbHourAngle.Enable := FALSE;
	fbDeclination.Enable := FALSE;
ELSE
	errorid := 0;
END_IF


// calculate fHourAngle (and also horizontal coord. -> used for checking if target is on sky or in ground)

eq2hor(
	ra := fRightAscension,
	dec := fDeclination,
	lon := telescopeConfig.longitude,
	lat := telescopeConfig.latitude,
	altitude := telescopeConfig.altitude,
	JD := jd + fTimeOffset,
	refract_to_observed := TRUE,
	alt => elevation_calc,
	az => azimuth_calc,
	ha => fHourAngle);
	
// calculate equatorial coordinates (used by Slew command, takes Alt/Az -> moves telescope)
hor2eq(alt := fElevation, 
		az := fAzimuth,
		jd := jd+fTimeOffset,
		lat := telescopeConfig.latitude,
		lon := telescopeConfig.longitude,
		altitude := telescopeConfig.altitude,
		refract_to_observed := TRUE,
		ra => rightascension_calc,
		dec => declination_calc,
		ha => hourangle_calc);		
// caluclate pointing offsets
fbPointingForward(
	HourAngle	:= fHourAngle,
	Declination	:= fDeclination,
	Latitude	:= telescopeConfig.latitude,
	HourAngle_correction => fHourAnglePointingOffset,
	Declination_correction => fDeclinationPointingOffset,
	HourAngle_velocity => fHourAngleVelocity,
	Declination_velocity => fDeclinationVelocity,
);

// get current coordinates (of motors)
declination_current := fbDeclination.fActualPosition ;
hourangle_current := fbHourAngle.fActualPosition ;
fbPointingInversion(
	HourAngle:= hourangle_current,
	Declination:= declination_current,
	Latitude:=telescopeConfig.latitude,
	HourAngle_correction => fHourAngleInversionOffset,
	Declination_correction => fDeclinationInversionOffset
);

// transform into needed coordinates
ha2ra(
	ha := hourangle_current,
	dec := declination_current,
	jd := jd+fTimeOffset,
	lon := telescopeConfig.longitude,
	ra => rightascension_current);

eq2hor(
	ra := rightascension_current,
	dec := declination_current,
	lon := telescopeConfig.longitude,
	lat := telescopeConfig.latitude,
	altitude := telescopeConfig.altitude,
	refract_to_observed := FALSE,
	JD := jd + fTimeOffset,
	alt => elevation_current,
	az => azimuth_current);
	
eq2hor(
	ra := MODABS(rightascension_current +fHourAngleInversionOffset, 360),
	dec := declination_current - fDeclinationInversionOffset,
	lon := telescopeConfig.longitude,
	lat := telescopeConfig.latitude,
	altitude := telescopeConfig.altitude,
	refract_to_observed := FALSE,
	JD := jd + fTimeOffset,
	alt => elevation_current_sky,
	az => azimuth_current_sky);
	
// If the Telescope dips under the fHorizon (e.g. while tracking, stop and gohome)
IF elevation_current < (fHorizon+0.2) THEN
	IF NOT bStopped AND NOT bGoHome THEN
		bStop := TRUE;
	ELSE
		bGoHome := TRUE;
	END_IF
END_IF
	
poweronwarning(IN := bPower OR (NOT fbHourAngle.bEnable), PT := T#250MS);

power_timeout(IN := TCS_command = E_TCSCommand.no_command AND NOT isparked, PT := T#12H);
command_timeout();
IF power_timeout.Q AND NOT isparked THEN
	bPark := TRUE;
END_IF
		
// set TCS_command according to state variables ordered by precedence
IF bPower THEN
	TCS_command := E_TCSCommand.poweron;
	
ELSIF bStop THEN
	bTrack := FALSE;
	
	// If the stop is during a movement, reset the stage of the movement first
	IF bPark THEN
		bPark := FALSE;
		_ParkTelescope();
	ELSIF bGoto THEN
		bGoto := FALSE;
		_GotoTelescope();
	ELSIF bSlew THEN
		bSlew := FALSE;
		_SlewTelescope();
	ELSIF bGoHome THEN
		bGoHome := FALSE;
		_HomeTelescope();
	END_IF
	TCS_command := E_TCSCommand.stop;
	
ELSIF bPark THEN
	bTrack := FALSE;
	// If lower presedence commands are ongoing, let them know they are interupted
	IF bGoto OR bSlew OR bGoHome THEN
		bGoHome := FALSE;
		bGoto := FALSE;
		bSlew := FALSE;
		bInterupted := TRUE;
		_HomeTelescope();
		_GotoTelescope();
		_SlewTelescope();
		
	ELSE
		IF bReady AND NOT bBusy THEN
			bInterupted := FALSE;
			TCS_command := E_TCSCommand.park;
		END_IF
	END_IF
	
	
	
ELSIF bGoHome THEN
	bTrack := FALSE;
	// If lower presedence commands are ongoing, let them know they are interupted
	IF bGoto OR bSlew THEN
		bGoto := FALSE;
		bSlew := FALSE;
		bInterupted := TRUE;
		_GotoTelescope();
		_SlewTelescope();
		
	ELSE
		IF bReady AND NOT bBusy AND bStopped THEN
			bInterupted := FALSE;
			TCS_command := E_TCSCommand.gohome;
		END_IF
	END_IF
	
	
ELSIF bGoto THEN
	bTrack := FALSE;
	// If lower presedence commands are ongoing, let them know they are interupted
	IF bSlew THEN
		bSlew := FALSE;
		bInterupted := TRUE;
		_SlewTelescope();
	ELSE
		IF bReady AND NOT bBusy THEN
			bInterupted := FALSE;
			TCS_command := E_TCSCommand.goto;
		END_IF
	END_IF
	
	
ELSIF bSlew THEN
	bTrack := FALSE;
	IF bReady AND NOT bBusy THEN
		TCS_command := E_TCSCommand.slew;
	END_IF
ELSIF bTrack THEN
	IF bReady AND NOT bBusy THEN
		TCS_command := E_TCSCommand.track;
	END_IF
ELSE
	TCS_command := E_TCSCommand.no_command;
	fbHourAngle.bMoveAxis := FALSE;
	fbDeclination.bMoveAxis := FALSE;
	fbHourAngle.bTracking := FALSE;
	fbDeclination.bTracking := FALSE;
END_IF

IF TCS_command = E_TCSCommand.poweron THEN
	_PowerOn();
	command_timeout(IN := TCS_command = E_TCSCommand.poweron, PT := T#12H);
	TCSCTOEvent.OnMessage := 'POWER';
ELSIF TCS_command = E_TCSCommand.stop THEN
	_StopTelescope();
	command_timeout(IN := TCS_command = E_TCSCommand.stop, PT := T#2S);
	TCSCTOEvent.OnMessage := 'STOP';
ELSIF TCS_command = E_TCSCommand.park THEN
	_ParkTelescope();
	command_timeout(IN := TCS_command = E_TCSCommand.park, PT := T#2M);
	TCSCTOEvent.OnMessage := 'PARK';
ELSIF TCS_command = E_TCSCommand.gohome THEN
	_HomeTelescope();
	command_timeout(IN := TCS_command = E_TCSCommand.gohome, PT := T#2M);
	TCSCTOEvent.OnMessage := 'GOHOME';
ELSIF TCS_command = E_TCSCommand.goto THEN
	_GotoTelescope();
	command_timeout(IN := TCS_command = E_TCSCommand.goto, PT := T#2M);
	TCSCTOEvent.OnMessage := 'GOTO';
ELSIF TCS_command = E_TCSCommand.slew THEN
	_SlewTelescope();
	command_timeout(IN := TCS_command = E_TCSCommand.slew, PT := T#2M);
	TCSCTOEvent.OnMessage := 'SLEW';
ELSIF TCS_command = E_TCSCommand.track THEN
	_TrackTelescope();
	command_timeout(IN := TCS_command = E_TCSCommand.track, PT := T#12H);
	TCSCTOEvent.OnMessage := 'TRACK';
ELSE
	// disable command timeout
	command_timeout(IN := FALSE);
	TCSCTOEvent.OnMessage := 'NOCOMMAND';
END_IF
 
bSliding := NOT bTracking AND (fbHourAngle.fbAxis.InMotion OR fbHourAngle.fbAxis.InRamp OR
			fbDeclination.fbAxis.InMotion OR fbDeclination.fbAxis.InRamp );

// signal must be stable for 5500MS
tracking_delay(in := fbHourAngle.fbAxis.isTracking AND 
			fbDeclination.fbAxis.isTracking ,PT :=T#5500MS, Q => bTracking);

bStopped :=  (NOT fbHourAngle.bEnable OR fbHourAngle.fbAxis.StandStill) AND 
			(NOT fbDeclination.bEnable OR fbDeclination.fbAxis.StandStill);
			
bHomed := fbHourAngle.bCalibrated AND fbDeclination.bCalibrated AND (fbFocus <> 0 AND_THEN fbFocus.Calibrated);
			
bReady := bHomed AND 
	fbCovers.Opened AND 
	fbHourAngle.bEnable AND
	fbDeclination.bEnable AND
    NOT bError;

bBusy := fbHourAngle.fbAxis.Busy OR fbDeclination.fbAxis.Busy OR (fbFocus <> 0 AND_THEN fbFocus.Busy);
	

// unset the STOP command if telescope is already stopped
IF bStopped THEN
	bStop := FALSE;
END_IF

// unset the RESET command when no Error is present
IF NOT bError THEN
	bReset := FALSE;
END_IF

IF bEstopTriggered THEN
	fbHourAngle.Enable := FALSE;
	fbDeclination.Enable := FALSE;
END_IF

// send telemetry

IF bSliding OR bTrack OR bTracking THEN
	MQTTTimer.PT := T#1000MS; // during movement every second
ELSE
	MQTTTimer.PT := T#5000MS; // otherwise every five seconds
END_IF
MQTTTimer(IN:=TRUE);
IF MQTTTimer.Q THEN // publish new payload every second
	MQTTTimer(IN:=FALSE);

	comm.Publish('telescope', 'dome', 'JulianDate', LREAL_TO_STRING(jd));
	comm.Publish('telescope', 'dome', 'LocalSiderialTime', LREAL_TO_STRING(lst));
	(*
		ON SKY COORDS (with offsets but without pointing offsets)
		ALT AZ HA RA DEC
	*)
	comm.Publish('telescope', 'dome', 'Azimuth', LREAL_TO_STRING(azimuth_current_sky));
	comm.Publish('telescope', 'dome', 'Elevation', LREAL_TO_STRING(elevation_current_sky));
	comm.Publish('telescope', 'dome', 'Declination', LREAL_TO_STRING( declination_current - fDeclinationInversionOffset));
	// change to -180 to 180 degree in HA
	IF hourangle_current - fHourAngleInversionOffset < -180 THEN
		comm.Publish('telescope', 'dome', 'HourAngle', LREAL_TO_STRING(180 + LMOD(180+hourangle_current - fHourAngleInversionOffset, 360)));
	ELSIF hourangle_current - fHourAngleInversionOffset > 180 THEN
		comm.Publish('telescope', 'dome', 'HourAngle', LREAL_TO_STRING(-180 + LMOD(-180+hourangle_current - fHourAngleInversionOffset, 360)));
	ELSE
		comm.Publish('telescope', 'dome', 'HourAngle', LREAL_TO_STRING(hourangle_current - fHourAngleInversionOffset));
	END_IF
	comm.Publish('telescope', 'dome', 'RightAscension', LREAL_TO_STRING(MODABS(rightascension_current +fHourAngleInversionOffset, 360)));
	

	
	
	(*
		RAW ON SKY COORDS (with out any offsets) -> used for creating pointing model
		HA DEC
	*)
	comm.Publish('telescope', 'dome', 'DeclinationRaw', LREAL_TO_STRING( declination_current - fDeclinationInversionOffset - fDeclinationOffset));
	// change to -180 to 180 degree in HA
	IF hourangle_current - fHourAngleInversionOffset - fHourAngleOffset/COS(fDeclination*d2r) < -180 THEN
		comm.Publish('telescope', 'dome', 'HourAngleRaw', LREAL_TO_STRING(180 + LMOD(180+hourangle_current - fHourAngleInversionOffset - fHourAngleOffset/COS(fDeclination*d2r), 360)));
	ELSIF hourangle_current - fHourAngleInversionOffset - fHourAngleOffset/COS(fDeclination*d2r) > 180 THEN
		comm.Publish('telescope', 'dome', 'HourAngleRaw', LREAL_TO_STRING(-180 + LMOD(-180+hourangle_current - fHourAngleInversionOffset - fHourAngleOffset/COS(fDeclination*d2r), 360)));
	ELSE
		comm.Publish('telescope', 'dome', 'HourAngleRaw', LREAL_TO_STRING(hourangle_current - fHourAngleInversionOffset - fHourAngleOffset/COS(fDeclination*d2r)));
	END_IF

	

	(*
		Instrument COORDS (with all offsets) -> actual motor/encoder positions of both axis
		HA DEC
	*)
	comm.Publish('telescope', 'dome', 'HourAngleInstrument', LREAL_TO_STRING(hourangle_current));
	comm.Publish('telescope', 'dome', 'DeclinationInstrument', LREAL_TO_STRING(declination_current));
	(*
		Offsets both in Ha Dec system, not actual sky distance
	*)
	comm.Publish('telescope', 'dome', 'DeclinationOffset', LREAL_TO_STRING(fDeclinationOffset));
	comm.Publish('telescope', 'dome', 'HourAngleOffset', LREAL_TO_STRING(fHourAngleOffset));
	comm.Publish('telescope', 'dome', 'DeclinationPointingOffset', LREAL_TO_STRING(fDeclinationPointingOffset));
	comm.Publish('telescope', 'dome', 'HourAnglePointingOffset', LREAL_TO_STRING(fHourAnglePointingOffset));
	
	comm.Publish('telescope', 'dome', 'errorid',	UDINT_TO_STRING(errorid));
	comm.Publish('telescope', 'dome', 'error',		BOOL_TO_STRING(bError));
	comm.Publish('telescope', 'dome', 'ready',		BOOL_TO_STRING(bReady));
	comm.Publish('telescope', 'dome', 'sliding',	BOOL_TO_STRING(bSliding));
	comm.Publish('telescope', 'dome', 'tracking', 	BOOL_TO_STRING(bTracking));
	comm.Publish('telescope', 'dome', 'stopped',	BOOL_TO_STRING(bStopped));
	comm.Publish('telescope', 'dome', 'homed',		BOOL_TO_STRING(bHomed));
	comm.Publish('telescope', 'dome', 'parked',		BOOL_TO_STRING(isparked));
	comm.Publish('telescope', 'dome', 'busy',		BOOL_TO_STRING(bBusy));
END_IF

StatusWord.0 := bError;
StatusWord.1 := bReady;
StatusWord.2 := bSliding;
StatusWord.3 := bTracking;
StatusWord.4 := bStopped;
StatusWord.5 := bHomed;
StatusWord.6 := bPower;
StatusWord.7 := bPark;
StatusWord.8 := bGoHome;
StatusWord.9 := bTrack;
StatusWord.10 := bGoto;
StatusWord.11 := bSlew;
StatusWord.12 := bStop;
StatusWord.13 := bBusy;

IF StatusWord<>LastStatus THEN // publish new payload every second
	LastStatus := StatusWord;
	comm.Publish('telescope', 'dome', 'error',		BOOL_TO_STRING(bError));
	comm.Publish('telescope', 'dome', 'ready',		BOOL_TO_STRING(bReady));
	comm.Publish('telescope', 'dome', 'sliding',		BOOL_TO_STRING(bSliding));
	comm.Publish('telescope', 'dome', 'tracking', 	BOOL_TO_STRING(bTracking));
	comm.Publish('telescope', 'dome', 'stopped',		BOOL_TO_STRING(bStopped));
	comm.Publish('telescope', 'dome', 'homed',		BOOL_TO_STRING(bHomed));
	comm.Publish('telescope', 'dome', 'power',		BOOL_TO_STRING(bPower));
	comm.Publish('telescope', 'dome', 'park',		BOOL_TO_STRING(bPark));
	comm.Publish('telescope', 'dome', 'gohome',		BOOL_TO_STRING(bGoHome));
	comm.Publish('telescope', 'dome', 'track',		BOOL_TO_STRING(bTrack));
	comm.Publish('telescope', 'dome', 'goto',		BOOL_TO_STRING(bGoto));
	comm.Publish('telescope', 'dome', 'slew',		BOOL_TO_STRING(bSlew));
	comm.Publish('telescope', 'dome', 'stop',		BOOL_TO_STRING(bStop));
	comm.Publish('telescope', 'dome', 'busy',		BOOL_TO_STRING(bBusy));
END_IF


(* Event function blocks start here. *)
TCSpowerEvent(	Trigger := powerfailure, 
				Level := ADSLOG_MSGTYPE_ERROR,
				FormatString := 'power %s',
				//OnMessage := 'Failure',
				OffMessage := 'OK', 
				Comm := comm);

TCSgohomeEvent(	Trigger := bGoHome, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'GOHOME %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed', 
				Comm := comm);
TCSparkEvent(	Trigger := bPark, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'PARK %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed', 
				Comm := comm);
TCSgotoEvent(	Trigger := bGoto, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'GOTO %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed', 
				Comm := comm);
TCStrackEvent(	Trigger := bTrack, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := 'TRACK %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed', 
				Comm := comm);
TCSstopEvent(	Trigger := bStop, 
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := 'STOP %s',
				OnMessage := 'commencing',
				OffMEssage := 'completed',
				OffLevel := ADSLOG_MSGTYPE_HINT, 
				Comm := comm);
TCStargetHorizonEvent(	Trigger := bReady AND elevation_calc<fHorizon, 
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'Target below safe horizon',
				OffMEssage := '', 
				Comm := comm);
TCSaltitudeEvent(	Trigger := elevation_current<(fHorizon+2.0), 
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'Telescope below safe horizon',
				OffMEssage := '', 
				Comm := comm);
TCSnearPoleEvent(	Trigger := fDeclination + fDeclinationOffset + fDeclinationPointingOffset > (90.0 - fPoleZone), 
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := '%s',
				OnMessage := 'To close to the pole, stopping telescope.',
				OffMEssage := '', 
				Comm := comm);			
TCSreadyEvent(	Trigger := bReady, 
				Level := ADSLOG_MSGTYPE_HINT,
				FormatString := '%s',
				OnMessage := 'IAG50cm startup finished', 
				Comm := comm);
TCSCTOEvent(	Trigger := command_timeout.Q,
				Level := ADSLOG_MSGTYPE_WARN,
				FormatString := 'A timeout occured during %s command!',
				OnMessage := 'NOCOMMAND', 
				Comm := comm);]]></ST>
    </Implementation>
    <Folder Name="command methods" Id="{f8e9235d-f769-45dd-a5d6-c3922581f371}" />
    <Folder Name="internal methods" Id="{43f8a5dc-2166-4fdb-b436-34a8f62ea04a}" />
    <Folder Name="properties" Id="{65c2c08a-67b2-43de-bf16-65ce2beac397}" />
    <Method Name="_GotoTelescope" Id="{43ebaf76-c0fc-41db-8c98-2f7671dc6b31}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _GotoTelescope : USINT
VAR_INPUT
END_VAR
VAR
	GoToEvent		: FB_Eventlog;
	commandTimeout	: TON;
END_VAR
VAR_STAT
	Stage			: USINT := 0;
	LastStage		: USINT := 101;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_GotoTelescope := Stage;
commandTimeout(IN := Stage < 100 AND Stage > 0, PT := T#600S);
IF commandTimeout.Q THEN
	bError := TRUE;
	errorid := 16#10;
	bGoto := FALSE;
	Stage := 0;
	RETURN;
END_IF

IF elevation_calc < fHorizon THEN
	bHorizonError := TRUE;
	errorid := 16#15;
	bGoto := FALSE;
	Stage := 0;
	RETURN;
END_IF


IF bReset OR bError OR bStop OR bInterupted THEN
	Stage := 0;
	RETURN;
END_IF

CASE Stage OF
	0:	
		IF bReady AND NOT bBusy THEN
			Stage := 10;
		END_IF
	10:
		IF fbHourAngle.Tracking = TRUE OR fbDeclination.Tracking = TRUE THEN
			fbHourAngle.Tracking := FALSE;
			fbDeclination.Tracking := FALSE;
		ELSE
			Stage := 20;
		END_IF
	20:	
		// clear offsets
		THIS^.HourAngleOffset := 0.0;
		THIS^.DeclinationOffset := 0.0;
		// Declination (including offest and pointing model)
		IF fDeclination + fDeclinationOffset + fDeclinationPointingOffset > (90.0 - fPoleZone) THEN
			// if too close to pole -> stop
			Stage := 0;
			bGoto := FALSE;
			bStop := TRUE;
			RETURN;
		ELSE
			fbDeclination.Position := fDeclination + fDeclinationOffset + fDeclinationPointingOffset;
			// HourAngle
			// change to -180 to 180 degree in HA
			IF MODABS(fHourAngle + fHourAngleOffset/COS(fDeclination*d2r)+ fHourAnglePointingOffset, 360) > 180 THEN
				fbHourAngle.Position := MODABS(fHourAngle + fHourAngleOffset/COS(fDeclination*d2r)+ fHourAnglePointingOffset,360) - 360.0;
			ELSE
				fbHourAngle.Position := MODABS(fHourAngle + fHourAngleOffset/COS(fDeclination*d2r)+ fHourAnglePointingOffset,360);
			END_IF
		END_IF

		fbHourAngle.Velocity := fSlewVelocity;
		fbDeclination.Velocity := fSlewVelocity;
		
		// make sure to never drive under Horizon
		IF ABS(fbHourAngle.Position) < ABS(hourangle_current) THEN
			// move Ha then Dec
			Stage := 30;
		ELSE
			// move Dec then HA
			Stage := 40;
		END_IF
	// Stage 30: move Ha and then Dec
	30:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			Stage := 31;
		END_IF
	31:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   Stage := 32;
		END_IF
	32:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			Stage := 33;
		END_IF
	33:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   Stage := 75;
		END_IF
	// Stage 40: move Dec and then Ha
	40:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			Stage := 41;
		END_IF
	41:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   Stage := 42;
		END_IF
	42:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			Stage := 43;
		END_IF
	43:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   Stage := 75;
		END_IF

	75:
		IF NOT bSliding AND bStopped THEN // all axis standstill
			Stage := 100;
		END_IF
	100:
		bGoto := FALSE;
		// enable automatic tracking
		bTrack := bAutoTrack;
		Stage := 0;
END_CASE
GoToEvent(Trigger := Stage > LastStage, FormatString := 'GOTO progress: %s', OnMessage := USINT_TO_STRING(Stage), comm := comm);
LastStage := Stage;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_HomeTelescope" Id="{b2d9dfb4-bf7c-4f17-8ac5-7f074d6808c9}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _HomeTelescope : USINT
VAR_INPUT
END_VAR
VAR
	HomeEvent:	FB_Eventlog;
	commandTimeout: TON;
END_VAR
VAR_STAT
	Stage:		USINT := 0;
	LastStage:	USINT := 101;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_HomeTelescope := Stage;
commandTimeout(IN := Stage < 100 AND Stage > 0, PT := T#600S);
IF commandTimeout.Q THEN
	bError := TRUE;
	errorid := 16#30;
	Stage := 0;
END_IF

IF bReset OR bError OR bStop OR bInterupted THEN
	Stage := 0;
	RETURN;
END_IF
CASE Stage OF
	0:	
		IF bReady AND bStopped AND NOT bBusy THEN
			Stage := 10;
		END_IF
	10:
		IF fbHourAngle.Tracking = TRUE OR fbDeclination.Tracking = TRUE THEN
			fbHourAngle.Tracking := FALSE;
			fbDeclination.Tracking := FALSE;
		ELSE
			Stage := 20;
		END_IF
	20:
		fbHourAngle.Position := telescopeConfig.hourangleHome;
		fbHourAngle.Velocity := fSlewVelocity;
		fbDeclination.Position := telescopeConfig.declinationHome;
		fbDeclination.Velocity := fSlewVelocity;
		
		// make sure to never drive under Horizon
		IF ABS(telescopeConfig.hourangleHome) < ABS(hourangle_current) THEN
			// move Ha then Dec
			Stage := 30;
		ELSE
			// move Dec then HA
			Stage := 40;
		END_IF
	// Stage 30: move Ha and then Dec
	30:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			Stage := 31;
		END_IF
	31:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   Stage := 32;
		END_IF
	32:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			Stage := 33;
		END_IF
	33:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   Stage := 100;
		END_IF
	// Stage 40: move Dec and then Ha
	40:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			Stage := 41;
		END_IF
	41:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   Stage := 42;
		END_IF
	42:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			Stage := 43;
		END_IF
	43:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   Stage := 100;
		END_IF
	100:
		fbFocus.Position := telescopeConfig.focusHome;
		fRightAscension := rightascension_current;
		fDeclination := declination_current;
		bGoHome := FALSE;
		Stage := 0;
END_CASE

HomeEvent(Trigger := Stage > LastStage, FormatString := 'GOHOME progress: %s', OnMessage := USINT_TO_STRING(Stage), comm := comm);
LastStage := Stage;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ParkTelescope" Id="{94a12771-4c75-4743-9ad3-850f66878f1f}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _ParkTelescope : USINT
VAR_INPUT
END_VAR
VAR
	ParkEvent	: FB_Eventlog;
END_VAR
VAR_STAT
	Stage		: USINT := 0;
	LastStage	: USINT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ParkTelescope := Stage;
IF bReset OR bError OR bStop OR bInterupted THEN
	Stage := 0;
	RETURN;
END_IF
IF isparked THEN
	Stage := 100;
END_IF
CASE Stage OF
	0: 
		IF fbFocus <> 0 THEN
			fbFocus.Position := telescopeConfig.focusPark;
		END_IF
		IF bError THEN // emergency park
			fbHourAngle.Enable := FALSE;
			fbDeclination.Enable := FALSE;	
			fbCovers.Close();	
			Stage := 80;
		END_IF
		IF NOT bBusy THEN
			Stage := 10;
		END_IF
	10:
		IF fbHourAngle.Tracking = TRUE OR fbDeclination.Tracking = TRUE THEN
			fbHourAngle.Tracking := FALSE;
			fbDeclination.Tracking := FALSE;
		ELSE
			Stage := 20;
		END_IF
	20:
		THIS^.HourAngleOffset := 0.0;
		THIS^.DeclinationOffset := 0.0;
		fbHourAngle.Position := telescopeConfig.houranglePark;
		fbHourAngle.Velocity := fSlewVelocity;
		fbDeclination.Position := telescopeConfig.declinationPark;
		fbDeclination.Velocity := fSlewVelocity;
		
		// make sure to never drive under Horizon
		IF ABS(telescopeConfig.houranglePark) < ABS(hourangle_current) THEN
			// move Ha then Dec
			Stage := 30;
		ELSE
			// move Dec then HA
			Stage := 40;
		END_IF
	// Stage 30: move Ha and then Dec
	30:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			Stage := 31;
		END_IF
	31:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   Stage := 32;
		END_IF
	32:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			Stage := 33;
		END_IF
	33:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   Stage := 60;
		END_IF
	// Stage 40: move Dec and then Ha
	40:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			Stage := 41;
		END_IF
	41:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   Stage := 42;
		END_IF
	42:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			Stage := 43;
		END_IF
	43:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   Stage := 60;
		END_IF
	60:
		IF NOT fbHourAngle.Enable AND NOT fbDeclination.Enable THEN
			stage := 80;
		END_IF

		IF bStopped THEN
			fbHourAngle.Enable := FALSE;
			fbDeclination.Enable := FALSE;
		END_IF
		
		fbHourAngle.bMoveAxis := FALSE;
		fbDeclination.bMoveAxis := FALSE;
	80:
		IF fbHourAngle.Enable OR fbDeclination.Enable THEN
			stage := 60;
		END_IF
		fbCovers.Close();
		fbFocus.Enable := FALSE;
		Stage := 90;	
	90:
		IF fbCovers.Closed THEN
			Stage := 100;
		END_IF
	100:
		isparked := TRUE;
		bPark := FALSE;
		_ParkTelescope := 100;
		Stage := 0;	
END_CASE
ParkEvent(Trigger := Stage > LastStage, FormatString := 'Parking progress: %s', OnMessage := USINT_TO_STRING(Stage), comm := comm);
LastStage := Stage;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_PowerOn" Id="{1dafa267-4251-4a45-a8e2-ae0ece289894}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _PowerOn : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bError THEN
	powerfailure := TRUE;
	TCSpowerEvent.OnMessage := 'Generic error during power on occured.';
	bPower := FALSE;
ELSE
	powerfailure := FALSE;		
END_IF
// COVER MUST BE OPENED FOR A SUCCESSFUL WAKE & SHAKE COMMAND!

fbCovers.Open();



// enable hourangle, enable declination
IF bMainReady AND fbCovers.Opened THEN 
	fbHourAngle.Enable := TRUE;
	fbDeclination.Enable := TRUE;
END_IF


IF fbHourAngle.Calibrated AND fbFocus <> 0 THEN
	fbFocus.Enable := TRUE;
	fbFocus.Position := telescopeConfig.focusPark;
END_IF

IF fbHourAngle.Calibrated AND
	fbDeclination.Calibrated AND
	fbCovers.Opened AND 
	fbFocus.Calibrated THEN
	//PowerOn is done, set bPower to False
	bPower := FALSE;
	_PowerOn := TRUE;
	isparked := FALSE;
	// slew the telescope to the home position
	bGoHome := TRUE;
ELSE
	_PowerOn := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SlewTelescope" Id="{4aaca2e7-2dba-4c2d-80b3-cd4dcc5ad38b}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _SlewTelescope : USINT
VAR_INPUT
END_VAR
VAR
	SlewEvent:	FB_Eventlog;
	command_timeout: TON;
END_VAR
VAR_STAT
	Stage:		USINT := 0;
	LastStage:	USINT := 101;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SlewTelescope := Stage;
command_timeout(IN := Stage < 100 AND Stage > 0, PT := T#600S);
IF command_timeout.Q THEN
	bError := TRUE;
	errorid := 16#40;
	bSlew := FALSE;
	Stage := 0;
	RETURN;
END_IF
IF fElevation < fHorizon THEN
	bHorizonError := TRUE;
	errorid := 16#15;
	bSlew := FALSE;
	Stage := 0;
	RETURN;
END_IF
IF bReset OR bError OR bStop OR bInterupted THEN
	Stage := 0;
	RETURN;
END_IF
CASE Stage OF
	0:	
		IF bReady AND bStopped AND NOT bBusy AND NOT bTracking THEN
			Stage := 10;
		END_IF
	10:
		IF fbHourAngle.Tracking = TRUE OR fbDeclination.Tracking = TRUE THEN
			fbHourAngle.Tracking := FALSE;
			fbDeclination.Tracking := FALSE;
		ELSE
			Stage := 25;
		END_IF
	25:
		THIS^.HourAngleOffset := 0.0;
		THIS^.DeclinationOffset := 0.0;
		// change to -180 to 180 degree in HA
		IF hourangle_calc > 180 THEN
			fbHourAngle.Position := hourangle_calc-360.0;
		ELSE
			fbHourAngle.Position := hourangle_calc;
		END_IF
		// Declination (including offest and pointing model)
		IF declination_calc + fDeclinationPointingOffset > (90.0 - fPoleZone) THEN
			// if too close to pole -> stop
			Stage := 0;
			bStop := TRUE;
			RETURN;
		ELSE
			fbDeclination.Position := declination_calc + fDeclinationPointingOffset;
			// HourAngle
			// change to -180 to 180 degree in HA
			IF MODABS(hourangle_calc + fHourAnglePointingOffset, 360) > 180 THEN
				fbHourAngle.Position := MODABS(hourangle_calc + fHourAnglePointingOffset,360) - 360.0;
			ELSE
				fbHourAngle.Position := MODABS(hourangle_calc + fHourAnglePointingOffset,360);
			END_IF
		END_IF
		fbHourAngle.Velocity := fSlewVelocity;
		fbDeclination.Velocity := fSlewVelocity;
		// make sure to never drive under Horizon
		IF ABS(fbHourAngle.Position) < ABS(hourangle_current) THEN
			// move Ha then Dec
			Stage := 30;
		ELSE
			// move Dec then HA
			Stage := 40;
		END_IF
	// Stage 30: move Ha and then Dec
	30:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			Stage := 31;
		END_IF
	31:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   Stage := 32;
		END_IF
	32:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			Stage := 33;
		END_IF
	33:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   Stage := 75;
		END_IF
	// Stage 40: move Dec and then Ha
	40:
		fbDeclination.MoveAxis := TRUE;
		IF fbDeclination.Busy THEN
			Stage := 41;
		END_IF
	41:
		IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
			fbDeclination.MoveAxis := FALSE;
		END_IF
		IF NOT fbDeclination.MoveAxis THEN
		   Stage := 42;
		END_IF
	42:
		fbHourAngle.MoveAxis := TRUE;
		IF fbHourAngle.Busy THEN
			Stage := 43;
		END_IF
	43:
		IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
			fbHourAngle.MoveAxis := FALSE;
		END_IF
		IF NOT fbHourAngle.MoveAxis THEN
		   Stage := 75;
		END_IF
	75:
		IF NOT bSliding AND bStopped THEN // all axis standstill
			Stage := 100;
		END_IF
	100:
		fbHourAngle.MoveAxis := FALSE;
		fbDeclination.MoveAxis := FALSE;
		fRightAscension := rightascension_current;
		fDeclination := declination_current;
		bSlew := FALSE;
		Stage := 0;
END_CASE
SlewEvent(Trigger := Stage > LastStage, FormatString := 'Slew progress: %s', OnMessage := USINT_TO_STRING(Stage), comm := comm);
LastStage := Stage;		
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_StopTelescope" Id="{cc9583d1-2578-4480-8aee-f6d55f373bf1}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _StopTelescope : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fbHourAngle.Tracking = TRUE OR fbDeclination.Tracking = TRUE THEN
	fbHourAngle.Tracking := FALSE;
	fbDeclination.Tracking := FALSE;
ELSIF fbHourAngle.MoveAxis = TRUE OR  fbDeclination.MoveAxis = TRUE THEN
	fbHourAngle.MoveAxis := FALSE;
	fbDeclination.MoveAxis := FALSE;
ELSE
	// Only issue Axis stop commands if they are moving
	IF NOT fbHourAngle.fbAxis.StandStill THEN
		fbHourAngle.StopAxis := TRUE;
	ELSE
		fbHourAngle.StopAxis := FALSE;
	END_IF
	
	IF NOT fbDeclination.fbAxis.StandStill THEN
		fbDeclination.StopAxis := TRUE;
	ELSE
		fbDeclination.StopAxis := FALSE;
	END_IF	

	IF bStopped THEN
		fbHourAngle.StopAxis := FALSE;
		fbDeclination.StopAxis := FALSE;
		_StopTelescope := FALSE;
	END_IF
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="_TrackTelescope" Id="{0dd53d55-2f74-4268-9438-8bb832d1c59b}" FolderPath="internal methods\">
      <Declaration><![CDATA[METHOD PRIVATE _TrackTelescope : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Declination (including offest and pointing model)
IF fDeclination + fDeclinationOffset + fDeclinationPointingOffset > (90.0 - fPoleZone) THEN
	// if too close to pole -> stop
	bStop := TRUE;
	RETURN;
ELSE
	fbDeclination.Position := fDeclination + fDeclinationOffset + fDeclinationPointingOffset;
	// HourAngle
	// change to -180 to 180 degree in HA
	IF MODABS(fHourAngle + fHourAngleOffset/COS(fDeclination*d2r)+ fHourAnglePointingOffset, 360) > 180 THEN
		fbHourAngle.Position := MODABS(fHourAngle + fHourAngleOffset/COS(fDeclination*d2r)+ fHourAnglePointingOffset,360) - 360.0;
	ELSE
		fbHourAngle.Position := MODABS(fHourAngle + fHourAngleOffset/COS(fDeclination*d2r)+ fHourAnglePointingOffset,360);
	END_IF
END_IF

IF NOT fbHourAngle.Tracking THEN
	fbHourAngle.Velocity := 1.0;
	fbHourAngle.MoveAxis := TRUE;
	IF NOT fbHourAngle.Busy AND fbHourAngle.MoveDone THEN
		fbHourAngle.MoveAxis := FALSE;
		IF fbHourAngle.isTracking THEN
			fbHourAngle.Velocity := LIMIT(0.004, fHourAngleVelocity, 0.01);
		END_IF
		fbHourAngle.Tracking := TRUE;
	END_IF
ELSE
	fbHourAngle.Velocity := LIMIT(0.004, fHourAngleVelocity, 0.01);
END_IF


IF NOT fbDeclination.Tracking THEN
	fbDeclination.Velocity := 1.0;
	fbDeclination.MoveAxis := TRUE;
	IF NOT fbDeclination.Busy AND fbDeclination.MoveDone THEN
		fbDeclination.MoveAxis := FALSE;
		IF fbDeclination.isTracking THEN
			fbDeclination.Velocity := LIMIT(0.0, fDeclinationVelocity, 0.004);
		END_IF
		fbDeclination.Tracking := TRUE;
	END_IF
ELSE
	fbDeclination.Velocity := LIMIT(0.0, fDeclinationVelocity, 0.004);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="AltAz" Id="{82dbc2ee-80ef-40a3-8c1f-856f0af6c171}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY AltAz : BROTLib.ST_AltAzCoordinate
]]></Declaration>
      <Get Name="Get" Id="{8533a901-9986-4274-8ee4-831d970f2e24}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[AltAz.Altitude 	:= elevation_calc;
AltAz.Azimuth 	:= azimuth_calc;]]></ST>
        </Implementation>
