<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_LatchHome" Id="{0b377430-54ed-4537-932a-357e8a08a6c5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LatchHome

VAR_IN_OUT
	Axis						: AXIS_REF;
END_VAR
VAR_INPUT
	Execute					: BOOL;										(* B *)
	StopActive				: BOOL;										(* #113: the axis is being stopped (stop requested or MC_Stop lock): abort the sequence *)
	Reset					: BOOL;										(* #155: leave the abort state at once, whatever MC_AbortHoming does *)

	(* static parameters *)
	Direction					: MC_Home_Direction;						(* E *)
	

	Velocity					: LREAL;									(* E *)
	Acceleration				: LREAL;									(* V *)	(* Beckhoff proprietary input *)
	Deceleration				: LREAL;									(* V *)	(* Beckhoff proprietary input *)
	Jerk						: LREAL;									(* V *)	(* Beckhoff proprietary input *)
	
	MoveIsCountDirection		: BOOL := TRUE;								(* If not specified : TRUE *)

	RefPosition					: LREAL;									(* Position (physical) of first marker of RefDistance in travel direction [deg]*)
	RefDistance					: LREAL; 									(* Reference distance to calibrate Latch distances to physical coords. ( >5.00 deg!!!)*)
	(* maximum time for one ref search process *)
	TimeLimit					: TIME;										(* E *)

	(* maximum travel distance for on calibration step (should be 6) *)
	DistanceLimit				: LREAL;									(* E *)
	
	(* Set bipolar torque limit to this value to avoid mechanical damadges [%] *)
	TorqueLimit					: LREAL;								(* E *)

	BufferMode					: MC_BufferMode;							(* E *)
	Options						: ST_Home_Options4;
END_VAR
VAR_OUTPUT
	Done						: BOOL;										(* B *)
	Busy						: BOOL;										(* E *)
	Active						: BOOL;										(* E *)
	CommandAborted				: BOOL;										(* E *)
	Error						: BOOL;										(* B *)
	ErrorID						: UDINT;									(* E *)
END_VAR
VAR	
	RefSignal					: MC_Ref_Signal_Ref;
	ReadApplicationRequest		: MC_ReadApplicationRequest;
	ApplicationRequest			: ST_NcApplicationRequest;

	Parameter					: MC_HomingParameter;

	Axis_Status:	MC_ReadStatus;
	Axis_Power:		MC_Power;
	
	bEnable						: BOOL;
	bReady						: BOOL;
	bCalibrated					: BOOL;

	Request						: BOOL;		(* application request bit [0/1] *)
	RequestType					: UINT;		(* application request TYPE/ID *)

	StepReferencePulseDetection			: MC_StepReferencePulseDetection;
	MoveAxis					: MC_Jog;

	SetPos						: MC_SetPosition;
	
	StepFinishHoming			: MC_FinishHoming;
	StepAbortHoming				: MC_AbortHoming;
	
	(* Need three Ref positions for absolut calibration *)
	(* One way *)
	RecordedPositions_to		: ARRAY [0..2] OF LREAL;
	(* Going back for checking*)
	RecordedPositions_back		: ARRAY [0..2] OF LREAL;
	
	RecordedDistances_to		: ARRAY [0..1] OF LREAL;
	RecordedDistances_back		: ARRAY [0..1] OF LREAL;
	
	PostionReset				: ARRAY [0..2] OF LREAL := [0,0,0];
	DistanceReset				: ARRAY [0..1] OF LREAL := [0,0];
	
	PositionOffset				: LREAL;
	iErrorId					: UDINT;
	iCommandAborted				: BOOL;
	
	nState						: INT;
	nSearch						: INT;

	fbStartReq					: FB_StartRequest;						(* #155: start request, kept until state 0 can take it *)
	fbReady						: R_TRIG;
	fbTimeOut					: TON;
	fbLockWait					: TON;									(* #113: longest wait for the MC_Stop lock before MC_AbortHoming *)
	fbAbortTimeout				: TON;									(* #155: longest time in the abort state, it has no other exit *)
END_VAR
VAR CONSTANT
	ERR_ABORT_TIMEOUT			: UDINT := 16#4F000001;					(* #155: the abort did not finish in time *)
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[// #155: the rising edge of Execute is only taken in state 0. One that arrives while the sequence is still aborting would
// be lost and the axis would never start, so remember it until state 0 is reached (and drop it with Execute).
fbStartReq(Execute := Execute);

RefSignal.TouchProbe := E_TouchProbe.TouchProbe1;

// #113: nothing else stops this sequence (a step block ignores a falling Execute, and the state machine reads Execute
// only in state 0). A stop of the axis, or Execute going away, aborts it: release the step blocks and go to the abort
// state, which waits for the MC_Stop lock to clear.
IF nState >= 1 AND nState <= 6 AND (NOT Execute OR StopActive) THEN
	StepReferencePulseDetection(
		Execute					:= FALSE,
		Parameter				:= Parameter,
		Axis					:= Axis);
	MoveAxis(
		Axis					:= Axis,
		JogForward				:= FALSE,
		JogBackwards			:= FALSE);
	SetPos(
		Execute					:= FALSE,
		Axis					:= Axis);
	StepFinishHoming(
		Execute					:= FALSE,
		Parameter				:= Parameter,
		Axis					:= Axis);
	iErrorId := 0;
	nState := 20;
END_IF
fbLockWait(IN := nState = 20 AND StopActive AND NOT StepAbortHoming.Busy, PT := T#5S);
fbAbortTimeout(IN := nState = 20, PT := T#10S);

CASE nState OF
	0 :	(* init *)
		IF NOT Execute THEN
			(* reset at falling edge of Execute *)
			Busy 			:= FALSE;
			Done			:= FALSE;
			CommandAborted 	:= FALSE;
			Error 			:= FALSE;
			ErrorID 		:= 0;
			iErrorID 		:= 0;
			
			bEnable			:= FALSE;
			
			nSearch 		:= 0;
			
			//Reset Arrays to zeros
			RecordedPositions_to	:= PostionReset;
			RecordedPositions_back	:= PostionReset;
			RecordedDistances_to	:= DistanceReset;
			RecordedDistances_back	:= DistanceReset;
		END_IF
 	
	  	IF fbStartReq.Take() THEN
			(* initialize output values *)
	  		Busy 				:= TRUE;

			IF BufferMode <> 0 THEN
				Busy := FALSE;
				Error := TRUE;
				ErrorID := MC_ERROR_BUFFERMODE_NOT_SUPPORTED;

				nState := 0;
			ELSE
				(* For axis with non Beckhoff components -> needs to be true (don't get why)*)
				Options.DisableDriveAccess := TRUE;
				nSearch:=0;
				nState := nState + 1; 
			END_IF
		END_IF
	1: (* Search one Block *)
		StepReferencePulseDetection(
			Execute 			:= TRUE,
			Direction 			:= Direction,
			ReferenceSignal 	:= RefSignal,
			Velocity 			:= Velocity,
			Acceleration 		:= Acceleration,
			Deceleration 		:= Deceleration,
			Jerk				:= Jerk,
			TimeLimit 			:= TimeLimit,
			TorqueLimit			:= TorqueLimit,
			DistanceLimit 		:= DistanceLimit,
			Axis				:= Axis,
			Parameter			:= Parameter,
			BufferMode			:= BufferMode, 
			Options				:= Options, 
			RecordedPosition	=> RecordedPositions_to[nSearch]);
			
		IF NOT StepReferencePulseDetection.Busy AND StepReferencePulseDetection.Done THEN
			StepReferencePulseDetection(	
				Execute					:= FALSE, 
				Parameter				:= Parameter,
				Axis					:= Axis);
			nSearch := nSearch +1;
			IF nSearch >2 THEN
				nState := nState + 1;
			END_IF

			
		ELSIF NOT StepReferencePulseDetection.Busy AND (StepReferencePulseDetection.Error OR StepReferencePulseDetection.CommandAborted) THEN
			iErrorID := StepReferencePulseDetection.ErrorID; 					(* functional/calibration error *) (* HKP *)
			
			StepReferencePulseDetection(	
				Execute					:= FALSE, 
				Parameter				:= Parameter,
				Axis					:= Axis);

			nState 	:= 20;
		END_IF
	2:	(* Jog 2 degrees *)
		nSearch := 0;
		IF Direction = MC_Home_Direction.mcPositiveDirection THEN
			MoveAxis.JogForward := TRUE;
		ELSIF Direction = MC_Home_Direction.mcNegativeDirection THEN
			MoveAxis.JogBackwards := TRUE;
		ELSE
			iErrorID := 1;
			nState := 20;
		END_IF
		MoveAxis(
			Axis				:= Axis,	
			Mode 				:= E_JogMode.MC_JOGMODE_INCHING,
			JogForward			:=,
			JogBackwards		:=,
			Position			:= 2,
			Velocity 			:= Velocity,
			Acceleration 		:= Acceleration,
			Deceleration 		:= Deceleration,
			Jerk				:= Jerk);
		IF NOT MoveAxis.Busy AND MoveAxis.Done THEN
			MoveAxis(	
				Axis				:= Axis,
				JogForward			:= FALSE,
				JogBackwards		:= FALSE);
			nState := nState + 1;

			
		ELSIF NOT MoveAxis.Busy AND (MoveAxis.Error OR MoveAxis.CommandAborted) THEN
			iErrorID := MoveAxis.ErrorID; 					(* functional/calibration error *) (* HKP *)
			
			MoveAxis(	
				Axis				:= Axis,
				JogForward			:= FALSE,
				JogBackwards		:= FALSE);

			nState 	:= 20;
		END_IF
		
	3:	(* Search two Block *)
		// Change Direction to move backwards
		IF Direction = MC_Home_Direction.mcPositiveDirection THEN
			StepReferencePulseDetection.Direction := MC_Home_Direction.mcNegativeDirection;
		ELSIF Direction = MC_Home_Direction.mcNegativeDirection THEN
			StepReferencePulseDetection.Direction := MC_Home_Direction.mcPositiveDirection;
		ELSE
			iErrorID := 1;
			nState := 20;
		END_IF
		StepReferencePulseDetection(
			Execute 			:= TRUE,
			Direction 			:=,
			ReferenceSignal 	:= RefSignal,
			Velocity 			:= Velocity,
			Acceleration 		:= Acceleration,
			Deceleration 		:= Deceleration,
			Jerk				:= Jerk,
			TimeLimit 			:= TimeLimit,
			TorqueLimit			:= TorqueLimit,
			DistanceLimit 		:= DistanceLimit,
			Axis				:= Axis,
			Parameter			:= Parameter,
			BufferMode			:= BufferMode, 
			Options				:= Options, 
			RecordedPosition	=> RecordedPositions_back[nSearch]);
			
		IF NOT StepReferencePulseDetection.Busy AND StepReferencePulseDetection.Done THEN
			StepReferencePulseDetection(	
				Execute					:= FALSE, 
				Parameter				:= Parameter,
				Axis					:= Axis);
			nSearch := nSearch +1;
			IF nSearch >2 THEN
				nState := nState + 1;
			END_IF

			
		ELSIF NOT StepReferencePulseDetection.Busy AND (StepReferencePulseDetection.Error OR StepReferencePulseDetection.CommandAborted) THEN
			iErrorID := StepReferencePulseDetection.ErrorID; 					(* functional/calibration error *) (* HKP *)
			
			StepReferencePulseDetection(	
				Execute					:= FALSE, 
				Parameter				:= Parameter,
				Axis					:= Axis);

			nState 	:= 20;
		END_IF
	4: (* Calculate Distances*)
		nSearch:=0;
		FOR nSearch:=0 TO 1 BY 1 DO
			RecordedDistances_to[nSearch] := F_RoundLREAL(ABS(RecordedPositions_to[nSearch] - RecordedPositions_to[nSearch+1]), 2);
			RecordedDistances_back[nSearch] := F_RoundLREAL(ABS(RecordedPositions_back[nSearch] - RecordedPositions_back[nSearch+1]), 2);
		END_FOR
		IF RecordedDistances_to[0] = RecordedDistances_back[1] AND RecordedDistances_to[1] = RecordedDistances_back[0] THEN
			nState := nState +1;
		ELSE
			(*if distances changed -> something is truely wrong*)
			iErrorID:=1;
			nState := 20;
		END_IF
	
	5: (* look up distance gaps and then set position and reference flag *)
		SetPos.Options.ClearPositionLag := TRUE;
		
		IF RefDistance > 5.0 THEN
			IF MoveIsCountDirection THEN
				IF RecordedDistances_to[0] > 5 THEN
					PositionOffset := (RecordedDistances_to[0] - RefDistance)*1000 + RefPosition - RecordedPositions_to[0];
				ELSE
					PositionOffset := (RecordedDistances_to[1] - RefDistance)*1000 + RefPosition - RecordedPositions_to[1];
				END_IF
			ELSE
				IF RecordedDistances_to[0] > 5 THEN
					PositionOffset := -(RecordedDistances_to[0] - RefDistance)*1000 + RefPosition - RecordedPositions_to[0];
				ELSE
					PositionOffset := -(RecordedDistances_to[1] - RefDistance)*1000 + RefPosition - RecordedPositions_to[1];
				END_IF
			END_IF
		ELSE
			iErrorID := 1;
			nState := 20;
		END_IF
		
		
		SetPos(
			Axis				:= Axis, 
			Execute				:= TRUE, 
			Position			:= PositionOffset, 
			Mode				:= TRUE, // relative postion change
			Options				:= );

		IF NOT SetPos.Busy AND SetPos.Done THEN
			SetPos(	
				Execute					:= FALSE, 
				Axis					:= Axis);

			nState := nState + 1;
		ELSIF NOT SetPos.Busy AND SetPos.Error THEN
			iErrorID := SetPos.ErrorID; (* functional/calibration error *)

			SetPos(	
				Execute					:= FALSE, 
				Axis					:= Axis);

			nState 	:= 20;
		END_IF
	
	6:
		StepFinishHoming.Options.DisableDriveAccess := Options.DisableDriveAccess;
		
		StepFinishHoming(	
			Execute				:= TRUE, 
			Distance			:= , 
			Velocity			:= Velocity, 
			Acceleration		:= Acceleration, 
			Deceleration		:= Acceleration, 
			Jerk				:= Jerk, 
			BufferMode			:= BufferMode, 
			Options				:= , 
			Axis				:= Axis, 
			Parameter			:= Parameter); 

		IF NOT StepFinishHoming.Busy AND StepFinishHoming.Done THEN
			Busy 				:= FALSE;
			Done	 			:= TRUE;

			StepFinishHoming(	
				Execute					:= FALSE, 
				Parameter				:= Parameter,
				Axis					:= Axis);

			nState := 0; 
		ELSIF NOT StepFinishHoming.Busy AND (StepFinishHoming.Error OR StepFinishHoming.CommandAborted) THEN
			iErrorID 		:= StepFinishHoming.ErrorID;

			StepFinishHoming(
				Execute					:= FALSE, 
				Parameter				:= Parameter,
				Axis					:= Axis);

			nState := 20;
		END_IF

	20:	(*Abort Homing*)
		// #155: no other exit: a reset or the timeout leaves the state even if MC_AbortHoming never reports back
		IF Reset OR fbAbortTimeout.Q THEN
			StepAbortHoming(
				Axis				:= Axis,
				Parameter			:= Parameter,
				Execute				:= FALSE,
				Options				:= );
			Busy := FALSE;
			IF Reset THEN
				CommandAborted := TRUE;
			ELSE
				Error := TRUE;
				ErrorID := ERR_ABORT_TIMEOUT;
			END_IF
			nState := 0;
		ELSE
		// #113: MC_Stop locks the axis for motion commands until it is done (StateDWord bit 29); MC_AbortHoming sent into the
		// lock is rejected (17135) and the error disables both axes. Wait for the lock to clear, 5 s at most.
		IF NOT StopActive OR fbLockWait.Q OR StepAbortHoming.Busy THEN
			StepAbortHoming.Options.DisableDriveAccess := Options.DisableDriveAccess;

			StepAbortHoming(
				Axis				:= Axis, 
				Parameter			:= Parameter, 
				Execute				:= TRUE, 
				Options				:= ); 

			IF NOT StepAbortHoming.Busy AND StepAbortHoming.Done THEN
				Busy 				:= FALSE;
				IF iErrorId <> 0 THEN
					Error	 			:= TRUE;
					ErrorId				:= iErrorId;
				ELSE
					CommandAborted		:= TRUE;
				END_IF
		
				StepAbortHoming(	
					Execute					:= FALSE, 
					Parameter				:= Parameter,
					Axis					:= Axis);

				nState := 0; 
			ELSIF NOT StepAbortHoming.Busy AND StepAbortHoming.Error THEN
				Busy := FALSE;
				Error := TRUE;
				ErrorID 		:= StepAbortHoming.ErrorID;

				StepAbortHoming(
					Execute					:= FALSE, 
					Parameter				:= Parameter,
					Axis					:= Axis);

				nState := 0;
			END_IF
		END_IF
		END_IF

END_CASE]]></ST>
    </Implementation>
