<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_DeclinationControl" Id="{6080c426-7a5e-4f1a-af47-78007455d126}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DeclinationControl EXTENDS FB_AxisControl
VAR_INPUT
	fMinPosition : LREAL := -50.0;
	fMaxPosition : LREAL := 180.0;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	bAxisError : BOOL;
	bLatchHomeError	: BOOL;
	nAxisErrorID : UDINT;
	nLatchHomeErrorID: UDINT;
	fbLatchHome : FB_LatchHome;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// limit to sane positions
fPosition := LIMIT(fMinPosition, fPosition, fMaxPosition);


IF bEnable AND NOT fbAxis.Calibrated THEN
	bHomeAxis := TRUE;
END_IF

IF fbAxis.Calibrated THEN
	bHomeAxis := FALSE;
	bCalibrated := fbAxis.Calibrated;
END_IF

IF bHomeAxis THEN
	fPosition := fPosition;
END_IF

fbAxis(
	enable 			:= bEnable,
	Reset 			:= bReset,
	MoveAxis 		:= bMoveAxis,
	HomeAxis 		:= FALSE,
	StopAxis 		:= bStopAxis,
	Tracking 		:= bTracking,
	HomingMode 		:= MC_ForceCalibration,
	Position 		:= fPosition, 
	Velocity 		:= fVelocity,
	TrackVelocityRef:= 0.0,
	TrackDirectionRef:= 0,
	Enable_Positive := NOT axisRef.Status.SoftLimitMaxExceeded,
	Enable_Negative := NOT axisRef.Status.SoftLimitMinExceeded,
	Jog_Forward 	:= bMovePos,
	Jog_Backwards 	:= bMoveNeg,
	ActualPosition 	=> fActualPosition,
	Error 			=> bError,
	ErrorID 		=> nErrorID,
	AxisRef 		:= axisRef);
	
fbLatchHome(
	Axis				:= AxisRef,
	Execute				:= bHomeAxis,
	Direction 			:= MC_Home_Direction.mcPositiveDirection,
	Velocity 			:= 1.0,
	Acceleration		:= 3.6,
	Deceleration		:= 3.6,
	Jerk				:= 3.6,
	RefPosition			:= -15.61+1.8,
	RefDistance			:= 5.18,
	TimeLimit 			:= T#1M,
	DistanceLimit 		:= 6,
	Error 				=> bLatchHomeError,
	ErrorID 			=> nLatchHomeErrorID);
	

bError := bLatchHomeError OR bAxisError;

IF bAxisError THEN
	nErrorID := nAxisErrorID;
ELSIF bLatchHomeError THEN
	nErrorID := nLatchHomeErrorID;
END_IF
	
IF fbAxis.MoveDone OR bReset OR bError THEN
	bMoveAxis := FALSE;
END_IF

IF (fbAxis.HomeDone AND fbLatchHome.Done) OR bReset OR bError THEN
	bHomeAxis := FALSE;
END_IF
	
IF fbAxis.ResetDone THEN
	bReset := FALSE;
END_IF

IF fbAxis.StopDone THEN
	bStopAxis := FALSE;
END_IF


bReady := fbAxis.Ready;

fbReadParameter(	
	Axis 			:= axisRef, 
	Enable 			:= fbAxis.InMotion, 
	ParameterNumber := MC_AxisParameter.AxisRemainingTimeToGo, 
	ReadMode 		:= E_ReadMode.READMODE_CYCLIC);
				
IF fbReadParameter.Valid THEN
	fSlewtime := fbReadParameter.Value;
END_IF

IF bSoEReset THEN
	fbSoEReset(
		Axis 	:= axisRef,
		Execute := TRUE,
		Timeout := DEFAULT_ADS_TIMEOUT);
 	IF NOT fbSoEReset.Busy THEN
		fbSoEReset(Axis := axisRef, Execute := FALSE);
		bSoEReset := FALSE;
		bReset := TRUE;
	END_IF
END_IF


axisEvent(	
	Trigger 		:= bError, 
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString	:= 'Declination Axis Error: %s',
	OnMessage 		:= NCError_TO_STRING(nErrorID),
	OffMEssage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	Comm			:= fbComm);
	

CalibrationEvent(	
	Trigger 		:= bCalibrated, 
	Level 			:= ADSLOG_MSGTYPE_HINT,
	OnMessage 		:= 'Declination Axis is calibrated.',
	Comm			:= fbComm);
	
]]></ST>
    </Implementation>
    <LineIds Name="FB_DeclinationControl">
      <LineId Id="10" Count="22" />
      <LineId Id="136" Count="0" />
      <LineId Id="33" Count="2" />
      <LineId Id="186" Count="1" />
      <LineId Id="36" Count="1" />
      <LineId Id="97" Count="1" />
      <LineId Id="39" Count="3" />
      <LineId Id="146" Count="0" />
      <LineId Id="148" Count="21" />
      <LineId Id="147" Count="0" />
      <LineId Id="43" Count="4" />
      <LineId Id="50" Count="0" />
      <LineId Id="170" Count="1" />
      <LineId Id="51" Count="34" />
      <LineId Id="99" Count="8" />
      <LineId Id="121" Count="5" />
      <LineId Id="87" Count="0" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>