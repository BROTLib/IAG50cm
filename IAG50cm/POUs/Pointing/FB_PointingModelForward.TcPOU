<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PointingModelForward" Id="{ebb46eb4-547b-401e-8748-73f4ab83529c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PointingModelForward
VAR_INPUT
	HourAngle		: LREAL;
	Declination		: LREAL;
	Latitude		: LREAL;
END_VAR
VAR_OUTPUT
	HourAngle_correction	: LREAL;
	Declination_correction	: LREAL;
	HourAngle_velocity		: LREAL;
	Declination_velocity 	: LREAL; 
END_VAR
VAR
	// inputs in rad
	tau		: LREAL;
	dec		: LREAL;
	alt		: LREAL;
	lat		: LREAL;
	// offsets
	off_tau_esti : LREAL :=0.0;
	off_dec_esti : LREAL :=0.0;
	// trackingspeeds
	track_tau_esti : LREAL := 0.0;
	track_dec_esti : LREAL := 0.0;
	// Altitude
	alt_diff : LREAL;
	// pre calculated sin/cos
	sin_tau	: LREAL;
	cos_tau	: LREAL;
	sin_dec	: LREAL;
	cos_dec : LREAL;
	sin_lat	: LREAL;
	cos_lat : LREAL;
	sin_alt : LREAL;
	cos_alt : LREAL;
END_VAR
VAR CONSTANT
	d2r		: LREAL := PI/180.0;
	omega 	: LREAL := 360.0 / 86164.099 * (PI/180.0); //sidereal velocity
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// degrees to rad
tau := HourAngle * d2r;
dec	:= Declination * d2r;
lat := Latitude * d2r;


// pre-calculate repeating sine and cosine functions
sin_TAU := SIN(tau);
cos_TAU := COS(tau);
sin_DEC := SIN(dec);
cos_DEC := COS(dec);
sin_lat := SIN(lat);
cos_lat := COS(lat);

// alt difference estimation (WITHOUT Nutation, Aberation, Presession)
sin_alt := SIN(dec) * sin_lat + COS(dec) * cos_lat * cos_TAU;
alt := ASIN(sin_alt);
cos_alt := COS(alt);
alt_diff := -omega * (1/SQRT(1 - sin_alt*sin_alt)) * COS(dec) * cos_lat * SIN(tau);

// ### TAU offset ###
off_tau_esti := - C_mAl_tau * ((cos_TAU * sin_DEC) / cos_DEC);
off_tau_esti := off_tau_esti + C_mEl_tau * ((sin_TAU * sin_DEC) / cos_DEC);
off_tau_esti := off_tau_esti + C_Coll_tau;
off_tau_esti := off_tau_esti + C_Refr_tau * ((sin_TAU * cos_lat) / (sin_alt * cos_DEC)); 
off_tau_esti := off_tau_esti + C_Flex_tau * ((sin_TAU * cos_lat) / cos_DEC);
off_tau_esti := off_tau_esti + C_Enc_tau / cos_DEC;
off_tau_esti := off_tau_esti - C_NP_tau * (sin_DEC / cos_DEC);
off_tau_esti := off_tau_esti - C_E1_tau * cos_TAU - C_E2_tau * COS(4 * tau);


track_tau_esti := c_mal_tau * omega * ((sin_TAU * sin_DEC) / cos_DEC);
track_tau_esti := track_tau_esti + c_mel_tau * omega * ((cos_TAU * sin_DEC) / cos_DEC);
track_tau_esti := track_tau_esti + c_refr_tau * omega * ((cos_TAU * cos_lat) / (sin_alt * cos_DEC)); // 1ST derivative term
track_tau_esti := track_tau_esti - c_refr_tau * alt_diff * cos_alt * ((sin_TAU * cos_lat) / (sin_alt*sin_alt * cos_DEC)); // 2nd term
track_tau_esti := track_tau_esti + c_flex_tau * omega * ((cos_TAU * cos_lat) / cos_DEC);
track_tau_esti := track_tau_esti + omega * (c_e1_tau * sin_TAU + 4 * c_e2_tau * SIN(4 * tau));


// ### DEC offset ###
off_dec_esti := C_mAl_dec * sin_TAU;
off_dec_esti := off_dec_esti + C_mEl_dec * cos_TAU;
off_dec_esti := off_dec_esti + C_Coll_dec;
off_dec_esti := off_dec_esti + C_Refr_dec * ((sin_lat - sin_alt * sin_DEC) / (cos_DEC * sin_alt));
off_dec_esti := off_dec_esti - C_Flex_dec * ((sin_lat - sin_alt * sin_DEC) / cos_DEC);


track_dec_esti := c_mal_dec * omega * cos_TAU;
track_dec_esti := track_dec_esti - c_mel_dec * omega * sin_TAU;
track_dec_esti := track_dec_esti - c_refr_dec * alt_diff * ((cos_alt * sin_DEC) / (cos_DEC * sin_alt));//# 1ST term
track_dec_esti := track_dec_esti - c_refr_dec * alt_diff * cos_alt * ((sin_lat - sin_alt * sin_DEC) / (cos_DEC * sin_alt*sin_alt)); //# 2nd derivative term
track_dec_esti := track_dec_esti + c_flex_dec * alt_diff * ((cos_alt * sin_DEC) / cos_DEC);

HourAngle_correction	:= off_tau_esti;
Declination_correction	:= off_dec_esti;
HourAngle_velocity		:= ABS((track_tau_esti + omega)/d2r);
Declination_velocity 	:= ABS(track_dec_esti/d2r); 

            ]]></ST>
    </Implementation>
