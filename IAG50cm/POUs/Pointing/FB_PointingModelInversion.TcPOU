<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PointingModelInversion" Id="{12b898bd-db5a-496e-8f1c-7de4951e9b09}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PointingModelInversion
VAR_INPUT
	HourAngle		: LREAL;
	Declination		: LREAL;
	Altitude		: LREAL;
	Latitude		: LREAL;
	epsilon			: LREAL := 0.25; //iteration accuracy in arcsec
END_VAR
VAR_OUTPUT
	HourAngle_correction	: LREAL;
	Declination_correction	: LREAL;
	bValid					: BOOL;	// FALSE if the iteration did not converge within epsilon (e.g. altitude too close to the horizon, where the model is chaotic -- see testing/check_pointing_inversion.py). HourAngle_correction/Declination_correction are 0.0 when FALSE.
END_VAR
VAR
	fbpointing : FB_PointingModelForward;
	d_ha		: LREAL := 0.0;
	d_dec		: LREAL := 0.0;
	d_ha_new	: LREAL := 0.0;
	d_dec_new	: LREAL := 0.0;
	i			: INT;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// iterate untill diff < epsilon or i_max=7 is reached
// 5 passes converge to <0.25" for the normal operating envelope (alt >= 3deg);
// see testing/check_pointing_inversion.py. Kept a small margin over the bare minimum.
bValid := FALSE;
FOR i:=0 TO 7 BY 1 DO
	d_ha := d_ha_new;
	d_dec := d_dec_new;
	fbpointing(
		HourAngle := LMOD(HourAngle-d_ha,360),
		Declination:= Declination-d_dec,
		Latitude:= Latitude,
		HourAngle_correction => d_ha_new,
		Declination_correction => d_dec_new
	);
	IF ABS(d_ha - d_ha_new) <= epsilon/3600.0 AND ABS(d_dec - d_dec_new) <= epsilon/3600.0 THEN
		bValid := TRUE;
		EXIT;
	END_IF
END_FOR;
// below alt~2-3deg the map is chaotic and never settles within epsilon (see script above);
// do not hand back whatever the last unconverged pass produced
IF bValid THEN
	HourAngle_correction := d_ha_new;
	Declination_correction := d_dec_new;
ELSE
	HourAngle_correction := 0.0;
	Declination_correction := 0.0;
END_IF]]></ST>
    </Implementation>
    <LineIds Name="FB_PointingModelInversion">
      <LineId Id="97" Count="0" />
      <LineId Id="47" Count="0" />
      <LineId Id="91" Count="1" />
      <LineId Id="53" Count="2" />
      <LineId Id="57" Count="2" />
      <LineId Id="50" Count="0" />
      <LineId Id="94" Count="2" />
      <LineId Id="65" Count="0" />
      <LineId Id="69" Count="1" />
    </LineIds>
  </POU>
</TcPlcObject>