<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_DomeControl" Id="{6d19e4e0-cd8e-40f8-8605-b776152ffcc0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DomeControl IMPLEMENTS I_Dome
VAR_IN_OUT
	TxBuffer	: ComBuffer;
	RxBuffer	: ComBuffer;
END_VAR
VAR
	ipState		: I_DomeState := fbDomeIdleState;
	bOpen		: BOOL;
	bClose		: BOOL;
	bReset		: BOOL;
	bHome		: BOOL;
	bTrack		: BOOL;
	bStopTrack	: BOOL;
	bPark		: BOOL;
	
	fDomeAzi_go		: LREAL;
	fDomeAzi_current: LREAL := 0.0;
	eDomeState		: E_DomeState;
	eDomeStateOld	: E_DomeState;
	bParked			: BOOL;
	bTracking		: BOOL;
	
	bDomeError	: BOOL;
	iDomeErrorID: UINT;
	
	ipStateOld			: I_DomeState := fbDomeIdleState;
	fbDomeCloseingState : FB_DomeClosingState(THIS);
	fbDomeErrorState	: FB_DomeErrorState(THIS);
	fbDomeHomeingState	: FB_DomeHomingState(THIS);
	fbDomeIdleState		: FB_DomeIdleState(THIS);
	fbDomeOpeningState	: FB_DomeOpeningState(THIS);
	fbDomeTrackingState	: FB_DomeTrackingState(THIS);
	fbDomeParkingState	: FB_DomeParkingState(THIS);
	

	rtrigOpen		: R_TRIG;
	rtrigClose		: R_TRIG;
	rtrigReset		: R_TRIG;
	rtrigHome		: R_TRIG;
	rtrigTrack		: R_TRIG;
	rtrigStopTrack	: R_TRIG;
	rtrigPark		: R_TRIG;
	
	fbComm			: I_Comm;
	tonComm 		: TON := (PT:=T#5S);
	
	fbDomeParkedEvent:	FB_EventLog;
	fbDomeErrorEvent: FB_EventLog;
	
	sSendstring	: STRING;
	Stage		: UINT:= 0;
	Timer		: TON := (PT:=T#30S);
	fbSend		: SendString;
	bSendBusy	: BOOL;
	eSendErrorID: ComError_t;

	fbReceive		: ReceiveString;
	sReceivedString	: STRING;
	sLastReceivedString: STRING;
	bStringReceived	: BOOL;
	bReceiveBusy	: BOOL;
	bReceiveError	: BOOL;
	eReceiveErrorID	: ComError_t;
	bReceiveTimeout	: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//	Receive string data:
fbReceive(
	Prefix:='',
	Suffix:= '',
	Timeout:= T#1S,
	ReceivedString:= sReceivedString,
	RXbuffer:= THIS^.RxBuffer,
	StringReceived=> bStringReceived,
	Busy=> bReceiveBusy,
	Error=> ,
	RxTimeout=> bReceiveTimeout );
// Check Errors
IF fbSend.Error <> COMERROR_NOERROR THEN
	eSendErrorID := fbSend.Error;
	bDomeError := TRUE;
END_IF
IF fbReceive.Error <> COMERROR_NOERROR THEN
	eReceiveErrorID := fbReceive.Error;
	bDomeError := TRUE;
END_IF

IF bDomeError THEN
	THIS^.ipState.FoundError();
END_IF

rtrigOpen(CLK := bOpen);
rtrigClose(CLK := bClose);
rtrigReset(CLK := bReset);
rtrigHome(CLK := bHome);
rtrigTrack(CLK := bTrack);
rtrigStopTrack(CLK := bStopTrack);
rtrigPark(CLK := bPark);

IF (rtrigReset.Q) THEN
	bReset := FALSE;
	ipState.ResetCommand();
END_IF

IF (rtrigClose.Q) THEN
	bClose := FALSE;
	ipState.CloseCommand();
END_IF

IF (rtrigOpen.Q) THEN
	bOpen := FALSE;
	ipState.OpenCommand();
END_IF

IF (rtrigHome.Q) THEN
	bHome := FALSE;
	ipState.HomeCommand();
END_IF

IF (rtrigTrack.Q) THEN
	bTrack := FALSE;
	ipState.TrackCommand();
END_IF

IF (rtrigStopTrack.Q) THEN
	bStopTrack := FALSE;
	ipState.StopTrackCommand();
END_IF

IF (rtrigPark.Q) THEN
	bPark := FALSE;
	ipState.ParkCommand();
END_IF

ipState.RunState();
IF ipState.StateID = 'Tracking State' THEN
	bTracking := TRUE;
ELSE
	bTracking := FALSE;
END_IF
// send telemetry
tonComm(IN:=TRUE);
IF tonComm.Q THEN // publish new payload every second
	tonComm(IN:=FALSE);

	fbComm.Publish('telescope', 'dome', 'DomeShutter', TO_STRING(eDomeState));
	fbComm.Publish('telescope', 'dome', 'DomeParked', BOOL_TO_STRING(bParked));
	fbComm.Publish('telescope', 'dome', 'DomeTracking', BOOL_TO_STRING(bTracking));
	fbComm.Publish('telescope', 'dome', 'DomeError', BOOL_TO_STRING(bDomeError));
END_IF


fbDomeParkedEvent(
	Trigger := bParked,
	Level := ADSLOG_MSGTYPE_HINT,
	OnMessage := 'Dome is in parking position.',
	comm:= fbComm);
fbDomeErrorEvent(
	Trigger := bDomeError,
	Level := ADSLOG_MSGTYPE_ERROR,
	FormatString := 'Dome Error %s',
	OnMessage := 'found.',
	OffMessage := 'resolved.',
	comm:= fbComm);
// Buffer
ipStateOld := ipState;
eDomeStateOld := eDomeState;]]></ST>
    </Implementation>
