<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_DomeControl" Id="{6d19e4e0-cd8e-40f8-8605-b776152ffcc0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DomeControl IMPLEMENTS I_Dome
VAR_INPUT
	ipTelescope: I_RaDecTelescope;
END_VAR
VAR
	ipState		: I_DomeState := fbDomeIdleState;
	bOpen		: BOOL;
	bClose		: BOOL;
	bReset		: BOOL;
	bHome		: BOOL;
	bTrack		: BOOL;
	bPark		: BOOL;
	
	fDomeAziGoInput			: LREAL := 180.0;
	fDomeAziGo				: LREAL := 180.0;
	fDomeAziCurrent			: LREAL := 0.0;
	eDomeRotationState		: E_DomeRotationState;
	eDomeRotationStateOld	: E_DomeRotationState;
	eDomeShutterState		: E_RoofState;
	eDomeShutterStateOld	: E_RoofState;
	bParked			: BOOL;
	
	bDomeError	: BOOL;
	iDomeErrorID: UINT;
	
	ipStateOld			: I_DomeState := fbDomeIdleState;
	fbDomeCloseingState : FB_DomeClosingState(THIS);
	fbDomeErrorState	: FB_DomeErrorState(THIS);
	fbDomeHomeingState	: FB_DomeHomingState(THIS);
	fbDomeIdleState		: FB_DomeIdleState(THIS);
	fbDomeOpeningState	: FB_DomeOpeningState(THIS);
	fbDomeMovingState	: FB_DomeMovingState(THIS);
	fbDomeParkingState	: FB_DomeParkingState(THIS);
	

	rtrigOpen		: R_TRIG;
	rtrigClose		: R_TRIG;
	rtrigReset		: R_TRIG;
	rtrigHome		: R_TRIG;
	rtrigPark		: R_TRIG;
	
	fbComm			: I_Comm;
	tonComm 		: TON := (PT:=T#5S);
	
	fbDomeParkedEvent:	FB_EventLog;
	fbDomeErrorEvent: FB_EventLog;
	
	sSendstring	: STRING;
	Stage		: UINT:= 0;
	Timer		: TON := (PT:=T#30S);
	fbSend		: SendString;
	bSendBusy	: BOOL;
	eSendErrorID: ComError_t;

	fbReceive		: ReceiveString;
	sReceivedString	: STRING;
	sLastReceivedString: STRING;
	bStringReceived	: BOOL;
	bReceiveBusy	: BOOL;
	bReceiveError	: BOOL;
	eReceiveErrorID	: ComError_t;
	bReceiveTimeout	: BOOL;
END_VAR
VAR CONSTANT
	nCapabilities : INT := 2; 	//OPEN TSI : TELESCOPE.CONFIG.CAPABILITIES
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// account for off center mount
IF fDomeAziGoInput >= 0.0 AND fDomeAziGoInput < 115.0 THEN
	fDomeAziGo := fDomeAziGoInput - 5.0;
ELSIF fDomeAziGoInput >= 225.0 AND fDomeAziGoInput < 360.0 THEN
	fDomeAziGo := fDomeAziGoInput + 5.0;
ELSE
	fDomeAziGo := fDomeAziGoInput;
END_IF

//	Receive string data:
fbReceive(
	Prefix:='',
	Suffix:= '',
	Timeout:= T#1S,
	ReceivedString:= sReceivedString,
	RXbuffer:= RxBufferDome,
	StringReceived=> bStringReceived,
	Busy=> bReceiveBusy,
	Error=> ,
	RxTimeout=> bReceiveTimeout );
// Check Errors
IF fbSend.Error <> COMERROR_NOERROR THEN
	eSendErrorID := fbSend.Error;
	bDomeError := TRUE;
END_IF
IF fbReceive.Error <> COMERROR_NOERROR THEN
	eReceiveErrorID := fbReceive.Error;
	bDomeError := TRUE;
END_IF

IF bDomeError THEN
	THIS^.ipState.FoundError();
END_IF

rtrigOpen(CLK := bOpen);
rtrigClose(CLK := bClose);
rtrigReset(CLK := bReset);
rtrigHome(CLK := bHome);
rtrigPark(CLK := bPark);

IF (rtrigReset.Q) THEN
	bReset := FALSE;
	ipState.ResetCommand();
END_IF

IF (rtrigClose.Q) THEN
	bClose := FALSE;
	ipState.CloseCommand();
END_IF

IF (rtrigOpen.Q) THEN
	bOpen := FALSE;
	ipState.OpenCommand();
END_IF

IF (rtrigHome.Q) THEN
	bHome := FALSE;
	ipState.HomeCommand();
END_IF

IF (rtrigPark.Q) THEN
	bPark := FALSE;
	bTrack := FALSE;
	ipState.ParkCommand();
END_IF

// #83: requests are one-shot, like the covers (#66). They are consumed in this scan whether they produced an edge or
// not: a caller repeating a request every scan gave a single edge and then left the flag TRUE, so no later request of
// that kind had an edge until a PLC restart.
bOpen := FALSE;
bClose := FALSE;
bReset := FALSE;
bHome := FALSE;
bPark := FALSE;

ipState.RunState();

IF eDomeRotationState = E_DomeRotationState.parked AND eDomeShutterState = E_RoofState.closed THEN
	bParked := TRUE;
ELSE
	bParked := FALSE;
END_IF
// send telemetry
tonComm(IN:=TRUE);
IF tonComm.Q THEN // publish new payload every 5 seconds
	tonComm(IN:=FALSE);
	THIS^._SendTelemetry();	
END_IF


fbDomeParkedEvent(
	Trigger := bParked,
	Level := ADSLOG_MSGTYPE_HINT,
	OnMessage := 'Dome is in parking position and closed.',
	comm:= fbComm);
fbDomeErrorEvent(
	Trigger := bDomeError,
	Level := ADSLOG_MSGTYPE_ERROR,
	FormatString := 'Dome Error %s',
	OnMessage := 'found.',
	OffMessage := 'resolved.',
	comm:= fbComm);
// Buffer
ipStateOld := ipState;
eDomeRotationStateOld := eDomeRotationState;
eDomeShutterStateOld := eDomeShutterState;]]></ST>
    </Implementation>
