<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_DomeErrorState" Id="{1c3fd2da-883e-4dfd-9e70-6396fe4dc63e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DomeErrorState EXTENDS  FB_DomeState
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CloseCommand" Id="{2211e3ad-15ee-4774-946f-138090512f81}">
      <Declaration><![CDATA[
METHOD CloseCommand : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #202: a close is accepted in every state, it is the way to shut the roof
// the error is cleared like a reset does it: the shutter command must not wait for a dome_reset
ResetCommand();
pDome^.SetState(pDome^.fbDomeCloseingState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetCommand" Id="{f76344eb-46e9-441e-956f-e4feed1005b3}">
      <Declaration><![CDATA[
METHOD ResetCommand : BOOL
VAR
	fbClearTx			: ClearComBuffer;
	fbClearRx			: ClearComBuffer;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbClearTx(Buffer:=TxBuffer);
fbClearRx(Buffer:=TxBuffer);

pDome^._Error := FALSE;
pDome^.SetState(pDome^.fbDomeIdleState);]]></ST>
      </Implementation>
    </Method>
    <Property Name="StateID" Id="{f76a3fa6-76fb-4d56-aec9-546023ad0ca7}">
      <Declaration><![CDATA[
PROPERTY StateID : STRING
]]></Declaration>
      <Get Name="Get" Id="{131512d7-c6aa-4508-ab7e-7f04233ba0cb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StateID := 'Error State';]]></ST>
        </Implementation>
      </Get>
    </Property>
    <LineIds Name="FB_DomeErrorState">
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="FB_DomeErrorState.ResetCommand">
      <LineId Id="7" Count="3" />
      <LineId Id="4" Count="0" />
    </LineIds>
    <LineIds Name="FB_DomeErrorState.StateID.Get">
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>