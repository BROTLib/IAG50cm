<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_DomeMovingState" Id="{590ca781-bd3a-4b24-8aa5-728f22f2d284}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DomeMovingState EXTENDS  FB_DomeState

VAR
	Stage		: UINT:= 0;
	tonSleep	: TON := (PT:=T#5S);
	tonTimeout	: TON:= (PT:=T#3M); // see Baader Handbook
	tonDelay	: TON:= (PT:=T#20MS);
	tonMoveDelay: TON:= (PT:=T#10M); // only move the Dome every PT minutes
	
	sSeperator		: STRING := 'd#azi';
	sSend			: STRING := 'd#azi';
	sLeft			: STRING;
	sAzi			: STRING;
	fAzi		: LREAL;
	fAzi_Old		: LREAL;
	bSplitSuccess 	: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CloseCommand" Id="{18e72070-0fe2-4237-a856-8470a94c85ac}">
      <Declaration><![CDATA[
METHOD CloseCommand : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// #202: a close is accepted in every state, it is the way to shut the roof
Stage := 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
tonDelay(IN:=FALSE);
pDome^.SetState(pDome^.fbDomeCloseingState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FoundError" Id="{1fa8c4f4-a5fa-4c18-b588-b4b7333ab130}">
      <Declaration><![CDATA[
METHOD FoundError : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage:= 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
tonDelay(IN:=FALSE);
pDome^._Error := TRUE;
pDome^.SetState(pDome^.fbDomeErrorState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParkCommand" Id="{b5b54c9f-26ab-4bd9-abf3-2fd51b916173}">
      <Declaration><![CDATA[
METHOD ParkCommand : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage:= 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
tonDelay(IN:=FALSE);
pDome^.SetState(pDome^.fbDomeParkingState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunState" Id="{fc53ed66-9223-4998-aee7-d674d6b352a2}">
      <Declaration><![CDATA[METHOD RunState : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Stage OF
	0:
		tonTimeout(IN:=TRUE);
		Stage:=1;
	1:
		//Baader measures azimuth as West of South, so we need to convert it. This works both ways.
		
		IF pDome^._Position  >= 180.0 THEN
			fAzi := pDome^._Position - 180.0;
		ELSE
			fAzi := pDome^._Position + 180.0;
		END_IF
		IF LREAL_TO_INT(fAzi*10) < 10 THEN
			sSend := CONCAT('d#azi000',  INT_TO_STRING(LREAL_TO_INT(fAzi*10)));
		ELSIF LREAL_TO_INT(fAzi*10) < 100 THEN
			sSend := CONCAT('d#azi00',  INT_TO_STRING(LREAL_TO_INT(fAzi*10)));
		ELSIF LREAL_TO_INT(fAzi*10) < 1000 THEN
			sSend := CONCAT('d#azi0',  INT_TO_STRING(LREAL_TO_INT(fAzi*10)));
		ELSE
			sSend := CONCAT('d#azi', INT_TO_STRING(LREAL_TO_INT(fAzi*10)));
		END_IF
		pDome^.fbSend(	SendString:= sSend,
					TXbuffer:= TxBufferDome,
					Busy=>,
					Error=> );
		IF NOT pDome^.fbSend.Busy  THEN
			Stage := 2;
		END_IF
	2: 
		IF pDome^._HasReceivedString THEN
			pDome^._DomeRotationState := E_DomeRotationState.slewing;
			IF pDome^._ReceivedString = 'd#comerro' OR pDome^._ReceivedString = 'd#domerro' THEN
				FoundError();
			ELSIF  pDome^._ReceivedString = 'd#gotmess' THEN
				Stage := 3;
			END_IF
		ELSIF NOT pDome^.fbReceive.Busy THEN
			tonSleep(IN:=TRUE);
			IF tonSleep.Q THEN
				tonSleep(IN:=FALSE);
				Stage := 1;
			END_IF
		END_IF
		tonTimeout(IN:=TRUE);
		IF tonTimeout.Q THEN
			tonTimeout(IN:=FALSE);
			FoundError();
		END_IF
	3:
		SuccessfulFinished();
END_CASE



]]></ST>
      </Implementation>
    </Method>
    <Property Name="StateID" Id="{789ef98b-8d5c-4127-a933-d7ebc0511169}">
      <Declaration><![CDATA[
PROPERTY StateID : STRING
]]></Declaration>
      <Get Name="Get" Id="{e13bca77-59e4-48ec-8aa6-d8cf00ae9cdc}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StateID := 'Moving State';]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="StopCommand" Id="{cc68548d-c24d-4021-8558-a1db2322d5fb}">
      <Declaration><![CDATA[
METHOD StopCommand : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage:= 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
tonDelay(IN:=FALSE);
pDome^.SetState(pDome^.fbDomeStoppingState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SuccessfulFinished" Id="{ccc1244d-56ad-40e1-b6f1-91ee9a4d11ac}">
      <Declaration><![CDATA[METHOD SuccessfulFinished : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage := 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
pDome^.SetState(pDome^.fbDomeIdleState);]]></ST>
      </Implementation>
    </Method>
