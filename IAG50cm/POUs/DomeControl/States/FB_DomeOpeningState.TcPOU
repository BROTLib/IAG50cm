<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_DomeOpeningState" Id="{298cd783-8180-481a-9bc6-814b912b38cc}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DomeOpeningState EXTENDS  FB_DomeState

VAR
	Stage		: UINT:= 0;
	tonSleep	: TON := (PT:=T#2S);
	tonTimeout	: TON:= (PT:=T#3M); // see Baader Handbook
	// #202: d#opeshut acknowledged but the shutter reports closed: at most nMaxAttempts sends in all, then an error
	nAttempts	: UINT;
	nMaxAttempts: UINT := 3;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CloseCommand" Id="{96f991ad-71d3-4ec1-acd3-5b8cde4fd821}">
      <Declaration><![CDATA[
METHOD CloseCommand : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nAttempts := 0;
Stage := 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
pDome^.SetState(pDome^.fbDomeCloseingState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FoundError" Id="{3e2cccf3-5977-44c4-8fa2-3c1d78ca1f58}">
      <Declaration><![CDATA[
METHOD FoundError : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nAttempts := 0;
Stage := 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
pDome^._Error := TRUE;
pDome^.SetState(pDome^.fbDomeErrorState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunState" Id="{5dcc6960-c5ba-436d-9066-b79451988bb4}">
      <Declaration><![CDATA[METHOD RunState : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Stage OF
	0:
		tonTimeout(IN:=TRUE);
		Stage := 1;
	1:
		pDome^.fbSend(	SendString:= 'd#opeshut',
					TXbuffer:= TxBufferDome,
					Busy=>,
					Error=> );
		IF NOT pDome^.fbSend.Busy  THEN
			Stage := 2;
		END_IF
	2:
		IF pDome^.bStringReceived THEN
			IF pDome^._ReceivedString = 'd#comerro' OR pDome^._ReceivedString = 'd#domerro' THEN
				FoundError();
			ELSIF pDome^._ReceivedString = 'd#gotmess' THEN
				Stage := 3;
			END_IF
		ELSIF NOT pDome^.fbReceive.Busy THEN
			tonSleep(IN:=TRUE);
			IF tonSleep.Q THEN
				tonSleep(IN:=FALSE);
				Stage := 1;
			END_IF
		END_IF
		tonTimeout(IN:=TRUE);
		IF tonTimeout.Q THEN
			tonTimeout(IN:=FALSE);
			FoundError();
		END_IF
	3:
		tonTimeout(IN:=FALSE);
		tonSleep(IN:=TRUE);
		IF tonSleep.Q THEN
			tonSleep(IN:=FALSE);
			Stage := 4;
			tonTimeout(IN:=TRUE);
		END_IF
	4:
		pDome^.fbSend(	SendString:= 'd#getshut',
					TXbuffer:= TxBufferDome,
					Busy=>,
					Error=> );
		IF NOT pDome^.fbSend.Busy  THEN
			Stage := 5;
		END_IF
	5: 
		IF pDome^.bStringReceived THEN
			IF pDome^._ReceivedString = 'd#comerro' OR pDome^._ReceivedString = 'd#domerro' THEN
				FoundError();
			ELSIF pDome^._ReceivedString = 'd#shutclo' THEN
				pDome^._DomeShutterState := E_RoofState.closed;
				tonTimeout(IN:=FALSE);
				nAttempts := nAttempts + 1;
				IF nAttempts >= nMaxAttempts THEN
					LogEvent(sText := 'Dome: the shutter does not open, d#opeshut is acknowledged but the shutter stays closed', sLevel := 'WARNING');
					FoundError();
				ELSE
					Stage := 0; // restart
				END_IF
			ELSIF pDome^._ReceivedString = 'd#shutope' THEN
				pDome^._DomeShutterState := E_RoofState.opened;
				Stage := 6;
			ELSIF pDome^._ReceivedString = 'd#shutrun' THEN
				pDome^._DomeShutterState := E_RoofState.opening;
				Stage := 3; // wait longer
			END_IF
		ELSIF NOT pDome^.fbReceive.Busy THEN
			tonSleep(IN:=TRUE);
			IF tonSleep.Q THEN
				tonSleep(IN:=FALSE);
				Stage := 4;
			END_IF
		END_IF
		
		tonTimeout(IN:=TRUE);
		IF tonTimeout.Q THEN
			tonTimeout(IN:=FALSE);
			FoundError();
		END_IF
	
	6:
		tonTimeout(IN:=FALSE);
		SuccessfulFinished();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="StateID" Id="{186674df-8838-40fd-af8a-a625d92cb6d6}">
      <Declaration><![CDATA[
PROPERTY StateID : STRING
]]></Declaration>
      <Get Name="Get" Id="{c2b0ca33-dd13-43d9-b2ec-6129050f6c83}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StateID := 'Opening State';]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SuccessfulFinished" Id="{56311afb-cd93-4d69-931e-4404b33a37b0}">
      <Declaration><![CDATA[
METHOD SuccessfulFinished : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nAttempts := 0;
Stage := 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
pDome^.SetState(pDome^.fbDomeIdleState);]]></ST>
      </Implementation>
    </Method>
