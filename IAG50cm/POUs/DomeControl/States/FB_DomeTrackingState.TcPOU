<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_DomeTrackingState" Id="{590ca781-bd3a-4b24-8aa5-728f22f2d284}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DomeTrackingState EXTENDS  FB_DomeState

VAR
	Stage		: UINT:= 0;
	tonSleep	: TON := (PT:=T#5S);
	tonTimeout	: TON:= (PT:=T#3M); // see Baader Handbook
	tonDelay	: TON:= (PT:=T#20MS);
	fAzi		: LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CloseCommand" Id="{3c4c8546-7cd2-495e-9e4f-e270dd58eba4}">
      <Declaration><![CDATA[
METHOD CloseCommand : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage:= 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
tonDelay(IN:=FALSE);
pDome^.SetState(pDome^.fbDomeCloseingState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FoundError" Id="{1fa8c4f4-a5fa-4c18-b588-b4b7333ab130}">
      <Declaration><![CDATA[
METHOD FoundError : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage:= 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
tonDelay(IN:=FALSE);
pDome^._Error := TRUE;
pDome^.SetState(pDome^.fbDomeErrorState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OpenCommand" Id="{654265e8-a024-415e-a3b8-8a8a5557b67e}">
      <Declaration><![CDATA[
METHOD OpenCommand : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage:= 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
tonDelay(IN:=FALSE);
pDome^.SetState(pDome^.fbDomeOpeningState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ParkCommand" Id="{b5b54c9f-26ab-4bd9-abf3-2fd51b916173}">
      <Declaration><![CDATA[
METHOD ParkCommand : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage:= 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
tonDelay(IN:=FALSE);
pDome^.SetState(pDome^.fbDomeParkingState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunState" Id="{fc53ed66-9223-4998-aee7-d674d6b352a2}">
      <Declaration><![CDATA[METHOD RunState : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// send 'd#getshut' wait for answer
// wait 5 seconds
// send 'd#getazi' wait for answer
CASE Stage OF
	0:
		tonTimeout(IN:=TRUE);
		Stage:=1;
	1:
		pDome^.fbSend(	SendString:= 'd#getshut',
					TXbuffer:= TxBuffer,
					Busy=>,
					Error=> );
		IF NOT pDome^.fbSend.Busy  THEN
			Stage := 2;
		END_IF
	2: 
		IF pDome^.bStringReceived THEN
			IF pDome^._ReceivedString = 'd#comerro' OR pDome^._ReceivedString = 'd#domerro' THEN
				FoundError();
			ELSIF pDome^._ReceivedString = 'd#shutclo' THEN
				pDome^._DomeState := E_DomeState.closed;
				Stage := 3;
			ELSIF pDome^._ReceivedString = 'd#shutope' THEN
				pDome^._DomeState := E_DomeState.open;
				Stage := 3;
			ELSIF pDome^._ReceivedString = 'd#shutrun' THEN
				// wait till open or closed
				pDome^._DomeState := E_DomeState.slewing;
				tonTimeout(IN:=FALSE);
				Stage := 0;
			END_IF
		ELSIF NOT pDome^.fbReceive.Busy THEN
			tonSleep(IN:=TRUE);
			IF tonSleep.Q THEN
				tonSleep(IN:=FALSE);
				Stage := 1;
			END_IF
		END_IF
		tonTimeout(IN:=TRUE);
		IF tonTimeout.Q THEN
			tonTimeout(IN:=FALSE);
			FoundError();
		END_IF
	3:
		tonTimeout(IN:=FALSE);
		tonSleep(IN:=TRUE);
		IF tonSleep.Q THEN
			tonSleep(IN:=FALSE);
			Stage := 4;
			tonTimeout(IN:=TRUE);
		END_IF
	4:
		//Baader measures azimuth as West of South, so we need to convert it. This works both ways.
		IF pDome^._Position  >= 180.0 THEN
			fAzi := pDome^._Position - 180.0;
		ELSE
			fAzi := pDome^._Position + 180.0;
		END_IF
		pDome^.fbSend(	SendString:= CONCAT('d#azi', INT_TO_STRING(LREAL_TO_INT(fAzi*10))),
					TXbuffer:= TxBuffer,
					Busy=>,
					Error=> );
		IF NOT pDome^.fbSend.Busy  THEN
			Stage := 5;
		END_IF
	5: 
		IF pDome^._HasReceivedString THEN
			IF pDome^._ReceivedString = 'd#comerro' OR pDome^._ReceivedString = 'd#domerro' THEN
				FoundError();
			ELSIF  pDome^._ReceivedString = 'd#gotmess' THEN
				Stage := 6;
			END_IF
		ELSIF NOT pDome^.fbReceive.Busy THEN
			tonSleep(IN:=TRUE);
			IF tonSleep.Q THEN
				tonSleep(IN:=FALSE);
				Stage := 4;
			END_IF
		END_IF
		tonTimeout(IN:=TRUE);
		IF tonTimeout.Q THEN
			tonTimeout(IN:=FALSE);
			FoundError();
		END_IF
	6:
		tonTimeout(IN:=FALSE);
		tonSleep(IN:=TRUE);
		IF tonSleep.Q THEN
			tonSleep(IN:=FALSE);
			Stage := 0;
		END_IF		
END_CASE



]]></ST>
      </Implementation>
    </Method>
    <Property Name="StateID" Id="{789ef98b-8d5c-4127-a933-d7ebc0511169}">
      <Declaration><![CDATA[
PROPERTY StateID : STRING
]]></Declaration>
      <Get Name="Get" Id="{e13bca77-59e4-48ec-8aa6-d8cf00ae9cdc}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StateID := 'Tracking State';]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="StoptrackCommand" Id="{6b49d2d6-0d90-4f25-ade1-4c30a022bf19}">
      <Declaration><![CDATA[METHOD StoptrackCommand : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage:= 0;
tonSleep(IN:=FALSE);
tonTimeout(IN:=FALSE);
tonDelay(IN:=FALSE);
pDome^.SetState(pDome^.fbDomeIdleState);]]></ST>
      </Implementation>
    </Method>
