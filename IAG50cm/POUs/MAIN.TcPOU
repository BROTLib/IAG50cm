<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{d994e49b-b7f8-4497-8346-561ddfb9c2db}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	comm			: FB_Comm_MQTT_Influx;
	coverControl	: FB_CoverControl(comm := comm);
	focusControl	: FB_FocusControl(comm:=comm);
	haControl		: FB_HourAngleControl(comm:=comm);
	decControl		: FB_DeclinationControl(comm:=comm);
	telescopeControl: FB_TelescopeControl(comm := comm);
	domeControl		: FB_DomeControl(comm := comm);
	pendantControl 	: FB_PendantControl(comm:=comm);
	safetyHandling	: FB_SafetyHandling(comm:=comm);
	search			: FB_RefMarkerSearch();

	
END_VAR
VAR CONSTANT
	telescopeConfig		: ST_TelescopeConfig := (longitude := 9.9452433, latitude := 51.5592378, altitude := 100.0, 
													houranglePark := 0.0, declinationPark := -23.0, focusPark:= 16.3,
													hourangleHome := 0.0, declinationHome := -23.0, focusHome:= 16.3,
													name := 'Emmy Noether', diameter := 0.5, cabinet := 'Beckhoff', manufacturer := '???',
													mountOptions := 'HA-DEC', mount := 'HA_DEC');
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[search(Enable:=TRUE);

domeControl(ipTelescope	:= telescopeControl);

pendantControl(
	ipTelescope	:= telescopeControl,
	ipFocus		:= focusControl);

coverControl(
	Delta := T#5S,
	TimeToCycle := T#15S);
	
focusControl(
	fVelocity:=1);
	
haControl();
decControl();
telescopeControl(
	fbHourAngle		:= haControl,
	fbDeclination	:= decControl,
	fbFocus			:= focusControl,
	fbDome			:= domeControl,
	fbCovers		:= coverControl,
	telescopeConfig	:= telescopeConfig,
);

//Safety
safetyHandling();

// Comm
comm(	
	sHostName			:= '169.254.149.100',
    nHostPort  			:= 1883,
    nKeepAlive  		:= 60,
	sTopicSub  		 	:= '50cm/Telescope/SET',
	sTopicPublish		:= '50cm/Telemetry',
	sTopicLog			:= '50cm/Log',
	Telescope			:= telescopeControl,
	RaDecTelescope		:= telescopeControl,
	Focus				:= focusControl,
	Dome				:= domeControl
);

]]></ST>
    </Implementation>
