<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{d994e49b-b7f8-4497-8346-561ddfb9c2db}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	comm			: FB_IagComm;	// BROTLib.FB_Comm_MQTT_Influx plus "command refraction=old|new" (IAG50cm#7)
	coverControl	: FB_CoverControl(comm := comm);
	focusControl	: FB_FocusControl(comm:=comm);
	haControl		: FB_HourAngleControl(comm:=comm);
	decControl		: FB_DeclinationControl(comm:=comm);
	telescopeControl: FB_TelescopeControl(comm := comm);
	domeControl		: FB_DomeControl(comm := comm);
	pendantControl 	: FB_PendantControl(comm:=comm);
	safetyHandling	: FB_SafetyHandling(comm:=comm);
	// X1: I_Cabinet for the comm layer and the HMI gateway, with the physical Local/Remote key (FB_CabinetControl.bIMode, via
	// telescopeControl.fbCabinet.LocalMode): key Local -> E_ControlMode.local, otherwise remote. Polarity of the key (TRUE = Local) is NOT yet
	// verified on site (plan O16). In Local the MQTT comm layer refuses the motion and reset verbs and the HMI may move the axes (gateway).
	// The pendant-active signal does not exist yet (plan I3): bPendantActive stays FALSE. No setter: the mode is not software-writable.
	cabinet			: FB_IagCabinet;
	// X10 (BROTLib 0.26.0): the HMI gateway (TcHMI maintenance UI). Called once per cycle, unconditionally, before the axis blocks (contract 7.5).
	Hmi				: FB_HmiGateway;
	rtrigStartUpDone: R_TRIG;
	//search			: FB_RefMarkerSearch(); // use for searching for the Heideinhain encoder reference markers

	
END_VAR
VAR CONSTANT
	// HMI axis descriptors (contract 5.2). fMin/fMax are the only limit of HMI jog and go-to-position and are a required, reviewed
	// item per telescope: they are NOT set here (0.0), and bCanJog/bCanMoveTo/bCanHome/bCanEnable are FALSE, so the HMI shows the axes
	// read-only until the limits are chosen with the telescope owner (inside the NC soft limits) and verified on site.
	stHaInfo			: ST_HmiAxisInfo := (sName := 'axis.hour_angle', eRole := E_HmiAxisRole.hour_angle, sUnit := 'deg');
	stDecInfo			: ST_HmiAxisInfo := (sName := 'axis.declination', eRole := E_HmiAxisRole.declination, sUnit := 'deg');
	stFocusInfo			: ST_HmiAxisInfo := (sName := 'axis.focus', eRole := E_HmiAxisRole.focus, sUnit := 'mm');	// the range comes from I_Focus.MinPosition/MaxPosition
	telescopeConfig		: ST_TelescopeConfig := (longitude := 9.9452433, latitude := 51.5592378, altitude := 100.0, 
													houranglePark := 0.0, declinationPark := 52.0, focusPark:= 16.3,
													hourangleHome := 0.0, declinationHome := 52.0, focusHome:= 16.3,
													name := 'Emmy Noether', diameter := 0.5, cabinet := 'Beckhoff', manufacturer := '???',
													mountOptions := 'HA-DEC', mount := 'HA_DEC');
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[//search(Enable:=TRUE); // use for reference marker search

// X1: the cabinet state of the previous cycle (safetyHandling runs below, like the signals of telescopeControl)
cabinet(
	bLocalKey			:= telescopeControl.fbCabinet.LocalMode,	// the Local/Remote key, previous cycle (telescopeControl runs below); polarity unverified (O16)
	bEstop				:= safetyHandling.estop,
	bSafetyError		:= safetyHandling.error,
	bSafetyAckPending	:= safetyHandling.ackPending);
	// bPendantActive stays FALSE: FB_PendantControl has no pendant-active signal yet (plan I3)

// X10: the HMI gateway, before the axis blocks and unconditionally (no IF, no RETURN above it): its jog dead-man lives here.
// Wired: the telescope (RaDec), the cabinet, the two mount axes, the focus, the covers and the dome. Left out on purpose:
// ipSafety (FB_SafetyHandling has no I_SafetyDiagnostics yet, plan I5) and ipTelescopeStatus (I_TelescopeStatus, X2, later);
// IAG50cm has no hydraulics, brake, roof, filter or Nasmyth.
Hmi.aipAxes[1]			:= haControl;
Hmi.aipAxes[2]			:= decControl;
Hmi.astAxisInfo[1]		:= stHaInfo;
Hmi.astAxisInfo[2]		:= stDecInfo;
Hmi(
	ipRaDec					:= telescopeControl,
	ipCabinet				:= cabinet,
	ipFocus					:= focusControl,
	stFocusInfo				:= stFocusInfo,
	ipCovers				:= coverControl,
	ipDome					:= domeControl,
	sTelescopeName			:= 'IAG 50cm',
	bTelescopeRunsInLocal	:= TRUE);	// the IAG50cm telescope control runs with the switch on Local as well (contract 5.3)

domeControl(ipTelescope	:= telescopeControl);

pendantControl(
	ipTelescope	:= telescopeControl,
	ipFocus		:= focusControl);

coverControl(
	Delta := T#5S,
	TimeToCycle := T#15S,
	bEmergency := safetyHandling.estop);	// previous cycle's value, see bEstopTriggered below (#15)
	
focusControl(
	fVelocity:=1);
	
haControl();
decControl();
telescopeControl(
	fbHourAngle		:= haControl,
	fbDeclination	:= decControl,
	fbFocus			:= focusControl,
	fbDome			:= domeControl,
	fbCovers		:= coverControl,
	telescopeConfig	:= telescopeConfig,
	// was never wired, so STATUS.GLOBAL never reported the E-stop (BROTLib#10). safetyHandling runs below, so
	// this is the previous cycle's value; the drives are cut by the safety circuit regardless.
	bEstopTriggered	:= safetyHandling.estop,
	bSafetyAckPending	:= safetyHandling.ackPending,	// previous cycle, like bEstopTriggered (#59)
	eRefractionMode	:= GVL_Pointing.eRefractionMode,	// IAG50cm#7: the refraction switch, at once
	stWeather		:= comm.Weather,	// live pressure and temperature (BROTLib#33), used in NEW only
);

//Safety
// #11: a telescope reset (cabinet key or the reset command, only fires with an error or a pending acknowledge after an E-stop, #59) also gives the safety
// acknowledge, so the drives leave STO without the VISU
IF telescopeControl.bSafetyAckRequest THEN
	telescopeControl.bSafetyAckRequest := FALSE;
	safetyHandling.Acknowledge();
END_IF
safetyHandling();
// #103: one axis reset pass once the safety start-up is done (the start-up only acknowledges the drives)
rtrigStartUpDone(CLK := safetyHandling.bStartUpDone);
IF rtrigStartUpDone.Q THEN
	telescopeControl.bStartupAxisReset := TRUE;
END_IF

// Comm
comm(	
	sHostName			:= '169.254.149.100',
    nHostPort  			:= 1883,
    nKeepAlive  		:= 10,
	sTopicSub  		 	:= '50cm/Telescope/SET',
	sTopicPublish		:= '50cm/Telemetry',
	sTopicLog			:= '50cm/Log',
	Cabinet				:= cabinet,		// X9: with the key on Local the motion and reset verbs are refused (the HMI moves the axes instead)
	Telescope			:= telescopeControl,
	RaDecTelescope		:= telescopeControl,
	Focus				:= focusControl,
	Dome				:= domeControl,
	MirrorCovers		:= coverControl,
);

]]></ST>
    </Implementation>
