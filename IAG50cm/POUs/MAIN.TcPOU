<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{d994e49b-b7f8-4497-8346-561ddfb9c2db}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	comm			: FB_Comm_MQTT_Influx;
	coverControl 	: FB_MirrorCoverControl(comm:=comm);
	focusControl	: FB_FocusControl(comm:=comm);
	haControl		: FB_HourAngleControl(comm:=comm);
	decControl		: FB_DeclinationControl(comm:=comm);
	telescopeControl: FB_TelescopeControl(comm := comm);
	domeControl		: FB_DomeControl(comm := comm);
	pendant_Test : FB_PendantControl;
	
END_VAR
VAR CONSTANT
	telescopeConfig		: ST_TelescopeConfig := (longitude := 9.9452433, latitude := 51.5592378, altitude := 100.0, 
													houranglePark := 0.0, declinationPark := -23.0, focusPark:= 1.0,
													hourangleHome := 0.0, declinationHome := -23.0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[GVL_Safety.Run := TRUE;

domeControl(TxBuffer:=TxBufferDome, RxBuffer:=RxBufferDome);
pendant_Test(TxBuffer:=TxBufferPendant, RxBuffer:=RxBufferPendant);

coverControl(delta_t:= T#5s);
focusControl(fVelocity:=1);
haControl();
decControl();
telescopeControl(
	fbHourAngle		:= haControl,
	fbDeclination	:= decControl,
	fbFocus			:= focusControl,
	fbDome			:= domeControl,
	fbCovers		:= coverControl,
	telescopeConfig	:= telescopeConfig,
);

comm(	
	sHostName			:= '169.254.149.100',
    nHostPort  			:= 1883,
    nKeepAlive  		:= 60,
	sTopicSub  		 	:= '50cm/Telescope/SET',
	sTopicPublish		:= '50cm/Telemetry',
	sTopicLog			:= '50cm/Log',
	Telescope			:= telescopeControl,
	Focus				:= focusControl,
	Dome				:= domeControl
);
]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="2" Count="0" />
