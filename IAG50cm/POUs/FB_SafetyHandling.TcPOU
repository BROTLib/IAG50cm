<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_SafetyHandling" Id="{ef2ee5a1-90f1-47ea-a6da-e2af04ff9de1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SafetyHandling
VAR
	// power on delay

	inError					AT%I*:	BOOL;		// Safety Error Condition
	outRun					AT%Q*:	BOOL;		// Run/Stop Safety
	outRestart				AT%Q*:	BOOL;		// Restart Safety
	outErrAck				AT%Q*:	BOOL;		// Error Acknowledgement 

	
	// Safety group
	fbInfoGroup1			: FB_InfoGroup;
	stInfoGroup1	AT%I*	: ST_InfoDataGroup;
	sStateGroup1			: STRING;
	
	// Estop
	fbInfoEStop1			:FB_InfoEStop;
	stInfoEStop1 	AT%I*	:ST_InfoDataFB;
	sStateEStop1			:STRING;
	sDiagEStop1				:STRING;	
	
	// Info safety inputs: unused, the EL1918's local inputs have no connection info data
	fbInfoSafetyIn			: FB_InfoConnection;
	stInfoSafetyIn 	AT%I*	: ST_InfoDataConnection;
	sStateSafetyIn			: STRING;
	sDiagSafetyIn			: STRING;
	bSafetyInCh1			: BOOL;
	bSafetyInCh2			: BOOL;
	bSafetyInCh3			: BOOL;
	bSafetyInCh4			: BOOL;
	
	// Info EL2904
	fbInfoSafetyOut			: FB_InfoConnection;
	stInfoSafetyOut AT%I*	: ST_InfoDataConnection;
	sStateSafetyOut			: STRING;
	sDiagSafetyOut			: STRING;
	bSafetyOutCh1			: BOOL;
	bSafetyOutCh2			: BOOL;
	bSafetyOutCh3			: BOOL;
	bSafetyOutCh4			: BOOL;
	
	initialStartUpStep		: INT := 0;
	startDelay 				: TON := (PT := T#2S);
	stateDelay 				: TON := (PT := T#1S);

	// #11: acknowledge on request (the telescope reset), the same ErrAck and Restart pulses as the start-up
	bAckRequest				: BOOL;			// Acknowledge() was called (one scan)
	bAckSkipped				: BOOL;			// the request was ignored this scan
	nAckStep				: INT;			// 0 idle, 1 ErrAck, 2 Restart
	ackDelay				: TON := (PT := T#1S);
	AckLog, AckSkippedLog	: FB_EventLog;

	// #59: an E-stop needs a safety acknowledge. The telescope reset fires on this flag as well as on an error,
	// so the acknowledge is not lost when the axis errors are already cleared (or never latched).
	rtrigEstop				: R_TRIG;
	bEstopDuringAck			: BOOL;			// the E-stop was pressed while an acknowledge sequence ran
	AckPendingLog			: FB_EventLog;

	
	ErrAckLog				: FB_EventLog;		// Errack logging
	RestartLog				: FB_EventLog;		// restart logging
	SafetyLog				: FB_EventLog;		// safety logging
	
	comm					: I_Comm;
END_VAR
VAR_OUTPUT
	error					: BOOL;		// error condition
	state          			: BOOL;		// safety is okay
	estop					: BOOL;		// Emergency_stop engaged
	ackPending				: BOOL;		// E-stop seen, no clean acknowledge since (#59)
END_VAR
VAR_INPUT
	// issue a remote restart
	//remote_restart:		BOOL;
	// issue a remute run/stop
	remote_run		: BOOL := TRUE;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Safety is running on start
outRun := remote_run;
GVL_Safety.Run := outRun;

// error?
error := inError;

// get safety status
fbInfoGroup1(
	stInfoData	:= stInfoGroup1,
	sState		=> sStateGroup1);
state := sStateGroup1 = 'RUN' OR initialStartUpStep <> 100;

// estop triggered?
fbInfoEStop1(
	stInfoData	:= stInfoEStop1, 
	sState		=> sStateEStop1, 
	sDiag		=> sDiagEStop1);
estop := sStateEStop1 <> 'RUN' AND initialStartUpStep = 100;

// #59: every E-stop (also one held through the PLC start, estop is masked until the start-up is done) needs an
// acknowledge. Cleared only by a clean sequence below; nothing is acknowledged automatically.
rtrigEstop(CLK := estop);
IF rtrigEstop.Q THEN
	ackPending := TRUE;
END_IF

// No info for the safety inputs: they are the EL1918's own local inputs, not an FSoE connection,
// so TwinSAFE offers no connection info data for them and stInfoSafetyIn stays unlinked (#34).

//Info SafetyOut EL2904
fbInfoSafetyOut(
	stInfoData		:=stInfoSafetyOut, 
	sState			=>sStateSafetyOut, 
	sDiag			=>sDiagSafetyOut, 
	bChannel1		=>bSafetyOutCh1, 
	bChannel2		=>bSafetyOutCh2, 
	bChannel3		=>bSafetyOutCh3, 
	bChannel4		=>bSafetyOutCh4);

// initial startup	
CASE initialStartUpStep OF
	0:
		// begin start up procedure, do ErrAck
		startDelay(IN := TRUE);
		IF startDelay.Q THEN
			startDelay(IN := FALSE);
			initialStartUpStep := initialStartUpStep+1;
		END_IF		
	1:
		// do err ack 
		GVL_Safety.ErrAck := TRUE;
		stateDelay(IN := TRUE);
		IF stateDelay.Q THEN
			stateDelay(IN := FALSE);
			GVL_Safety.ErrAck := FALSE;
			initialStartUpStep := initialStartUpStep+1;
		END_IF
	2:
		// do restart
		GVL_Safety.Restart := TRUE;
		stateDelay(IN := TRUE);
		IF stateDelay.Q THEN
			stateDelay(IN := FALSE);
			GVL_Safety.Restart := FALSE;
			initialStartUpStep := 100;
		END_IF		
END_CASE

// #11: acknowledge on request. Ignored while the start-up runs, while a sequence runs, and while the E-stop is
// pressed (the safety logic also gates the drive acknowledge on the E-stop input, so it would do nothing).
bAckSkipped := bAckRequest AND nAckStep = 0 AND (initialStartUpStep <> 100 OR estop);
IF bAckRequest AND nAckStep = 0 AND NOT bAckSkipped THEN
	nAckStep := 1;
END_IF
bAckRequest := FALSE;

// an E-stop during the sequence spoils it: TwinSAFE gates the Restart on the E-stop input
bEstopDuringAck := bEstopDuringAck OR (estop AND nAckStep <> 0);

CASE nAckStep OF
	1:
		GVL_Safety.ErrAck := TRUE;
		ackDelay(IN := TRUE);
		IF ackDelay.Q THEN
			ackDelay(IN := FALSE);
			GVL_Safety.ErrAck := FALSE;
			nAckStep := 2;
		END_IF
	2:
		GVL_Safety.Restart := TRUE;
		ackDelay(IN := TRUE);
		IF ackDelay.Q THEN
			ackDelay(IN := FALSE);
			GVL_Safety.Restart := FALSE;
			IF NOT bEstopDuringAck THEN
				ackPending := FALSE;
			END_IF
			bEstopDuringAck := FALSE;
			nAckStep := 0;
		END_IF
END_CASE

AckLog(
	Trigger		:= nAckStep = 1,
	Level		:= ADSLOG_MSGTYPE_WARN,
	OnMessage	:= 'Safety acknowledge by telescope reset: ErrAck, then Restart.',
	Comm		:= comm);
AckSkippedLog(
	Trigger		:= bAckSkipped,
	Level		:= ADSLOG_MSGTYPE_WARN,
	OnMessage	:= 'Safety acknowledge skipped: E-stop pressed or safety start-up running.',
	Comm		:= comm);
AckPendingLog(
	Trigger		:= ackPending,
	Level		:= ADSLOG_MSGTYPE_WARN,
	OnMessage	:= 'Safety acknowledge needed after the E-stop: release it, then reset the telescope.',
	OffMessage	:= 'Safety acknowledged after the E-stop.',
	OffLevel	:= ADSLOG_MSGTYPE_HINT,
	Comm		:= comm);
(*

ErrAckLog(  
	Trigger 	:= outErrAck,
	OnMessage 	:= 'Safety error was acknowledged.',
	Comm		:= comm
);
			
RestartLog(	
	Trigger 	:= outRestart,
	Level 		:= ADSLOG_MSGTYPE_WARN,
	OnMessage 	:= 'Safety was restarted.',
	Comm		:= comm
);

SafetyLog(	
	Trigger 	:= estop,
	Level 		:= ADSLOG_MSGTYPE_ERROR,
	OnMessage 	:= 'Safety Error! Emergency stop enganged!',
	OffMessage 	:= 'Safety is OK.',
	OffLevel 	:= ADSLOG_MSGTYPE_HINT,
	Comm		:= comm);
*)]]></ST>
    </Implementation>
    <Method Name="Acknowledge" Id="{2b6f9d14-8c3e-4a71-9e05-f4a8d1c73b62}">
      <Declaration><![CDATA[// #11: request the safety acknowledge (ErrAck 1 s, then Restart 1 s), as the telescope reset does after an E-stop
METHOD Acknowledge : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bAckRequest := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{78880c56-5a68-4979-b4f3-852d102d76af}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains	: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode		: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	comm			: I_Comm;	      
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.comm := comm;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_SafetyHandling">
      <LineId Id="76" Count="1" />
      <LineId Id="178" Count="0" />
      <LineId Id="78" Count="63" />
      <LineId Id="155" Count="22" />
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="FB_SafetyHandling.FB_Init">
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>