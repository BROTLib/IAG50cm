<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PendantControl" Id="{31943a3c-0e0b-4aa2-80e9-dadb4d86be37}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PendantControl
VAR_INPUT
	ipTelescope	: I_RaDecTelescope;
	ipFocus		: I_Focus;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	fbComm			: I_Comm;
	tonComm 		: TON := (PT:=T#5S);
	(*  State Definitions *)
	ipState			: I_PendantState := fbPendantPreInitState;
	ipStateOld		: I_PendantState := fbPendantPreInitState;
	
	fbPendantPreInitState	: FB_PendantPreInitState(THIS);
	fbPendantIdleState 		: FB_PendantIdleState(THIS);
	fbPendantInitState 		: FB_PendantInitState(THIS);
	fbPendantSetHAState		: FB_PendantSetHAState(THIS);
	fbPendantSetDECState	: FB_PendantSetDECState(THIS);
	fbPendantSetFocusState	: FB_PendantSetFocusState(THIS);
	fbPendantErrorState		: FB_PendantErrorState(THIS);
	
	bReady			: BOOL;
	bError			: BOOL;
	bReset			: BOOL;
	nErrorID		: UINT;
	
	(* Set Logic:
		bFastMove:	TRUE (move big step)
					FALSE (move small step)
		bMovePositive:	TRUE +
						FALSE -*)
	bFastMove		: BOOL;
	bMovePositive	: BOOL;
	
	rtrigReset		: R_TRIG;
	rtrigError		: R_TRIG;
	
	(*SEND*)
	fbSendString	: SendString;
	fbSendHex		: SendData;
	eSendErrorID	: ComError_t;
	
	
	(* RECEIVE*)
	fbReceive		: ReceiveString;
	rtrigReceive	: R_TRIG;
	sReceivedString	: STRING;
	sLastReceivedString: STRING;
	bStringReceived	: BOOL;
	bReceiveBusy	: BOOL;
	bReceiveError	: BOOL;
	eReceiveErrorID	: ComError_t;
	bReceiveTimeout	: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//	Receive string data:	
fbReceive(
	Prefix:='',
	Suffix:= '',
	Timeout:= T#1MS,
	ReceivedString:= sReceivedString,
	RXbuffer:= RxBufferPendant,
	StringReceived=> bStringReceived,
	Busy=> bReceiveBusy,
	Error=> ,
	RxTimeout=> bReceiveTimeout );

(*Send / Receive Errors? *)
IF fbReceive.Error <> COMERROR_NOERROR THEN
	bError:=TRUE;
	nErrorID		:= fbReceive.Error;
	eReceiveErrorID := fbReceive.Error;
END_IF
IF fbSendString.Error <> COMERROR_NOERROR THEN
	bError:=TRUE;
	nErrorID	:= fbSendString.Error;
	eSendErrorID := fbSendString.Error;
ELSIF fbSendHex.Error <> COMERROR_NOERROR THEN
	bError:=TRUE;
	nErrorID := fbSendHex.Error;
	eSendErrorID := fbSendHex.Error;
END_IF

(* Triggers*)
rtrigReceive(CLK:=bStringReceived);
rtrigReset(CLK:=bReset);
rtrigError(CLK:=bError);

IF rtrigError.Q THEN
	bFastMove := FALSE;
	ipState.FoundError();
ELSIF rtrigReset.Q THEN
	ipState.ResetCommand();
	bReset:=FALSE;
ELSIF rtrigReceive.Q AND NOT bError THEN
	(* INIT *)
	IF sReceivedString = '#' THEN
		ipState.InitCommand();
		
	(* HA *)
	ELSIF sReceivedString = 'û' AND bReady THEN
		(* -, slow*)
		bFastMove := FALSE;
		bMovePositive := FALSE;
		ipState.HaCommand();
	ELSIF sReceivedString = '{' AND bReady THEN
		(* -, fast*)
		bFastMove := TRUE;
		bMovePositive := FALSE;
		ipState.HaCommand();
	ELSIF sReceivedString = 'ý' AND bReady THEN
		(* +, slow*)
		bFastMove := FALSE;
		bMovePositive := TRUE;
		ipState.HaCommand();
	ELSIF sReceivedString = '}' AND bReady THEN
		(* +, fast*)
		bFastMove := TRUE;
		bMovePositive := TRUE;
		ipState.HaCommand();
	
	(* DEC *)
	ELSIF sReceivedString = 'ï' AND bReady THEN
		(* -, slow*)
		bFastMove := FALSE;
		bMovePositive := FALSE;
		ipState.DecCommand();
	ELSIF sReceivedString = 'o' AND bReady THEN
		(* -, fast*)
		bFastMove := TRUE;
		bMovePositive := FALSE;
		ipState.DecCommand();
	ELSIF sReceivedString = '÷' AND bReady THEN
		(* +, slow*)
		bFastMove := FALSE;
		bMovePositive := TRUE;
		ipState.DecCommand();
	ELSIF sReceivedString = 'w' AND bReady THEN
		(* +, fast*)
		bFastMove := TRUE;
		bMovePositive := TRUE;
		ipState.DecCommand();
	
	(* Focus *)
	ELSIF sReceivedString = '¿' AND bReady THEN
		(* -, slow*)
		bFastMove := FALSE;
		bMovePositive := FALSE;
		ipState.FocusCommand();
	ELSIF sReceivedString = '?' AND bReady THEN
		(* -, fast*)
		bFastMove := TRUE;
		bMovePositive := FALSE;
		ipState.FocusCommand();
	ELSIF sReceivedString = 'ß' AND bReady THEN
		(* +, slow*)
		bFastMove := FALSE;
		bMovePositive := TRUE;
		ipState.FocusCommand();
	ELSIF sReceivedString = '_' AND bReady THEN
		(* +, fast*)
		bFastMove := TRUE;
		bMovePositive := TRUE;
		ipState.FocusCommand();
	ELSE
		bFastMove := FALSE;
		ipState.ToIdle();
	END_IF
	
END_IF

ipState.RunState();]]></ST>
    </Implementation>
