<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PendantInitState" Id="{c922cae0-46c5-4818-b4f6-b506043328b3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PendantInitState EXTENDS FB_PendantState
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	Stage		: UINT:= 0;
	
	//Hex stuff
	aTxHexData		: ARRAY[0..2] OF BYTE;
	tonDelay		: TON:= (PT:=T#20MS);

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FoundError" Id="{c0286c1d-f02c-4485-842f-a300cd3a22d0}">
      <Declaration><![CDATA[METHOD FoundError : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage := 0;
tonDelay(IN:=FALSE);
pPendant^.SetState(pPendant^.fbPendantErrorState);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunState" Id="{18e5faab-466a-41fe-af62-9fa7d46adc4b}">
      <Declaration><![CDATA[METHOD RunState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Stage OF
	0:
		IF NOT pPendant^.fbSendHex.Busy OR pPendant^.fbSendString.Busy THEN
			Stage := Stage +1;
		END_IF
	1:
		HEXSTR_TO_DATA('fd', ADR(aTxHexData), SIZEOF(aTxHexData));
		pPendant^.fbSendHex(
				pSendData:= ADR(aTxHexData),
				Length	:= 1,
				TXbuffer:= TxBufferPendant,
				Busy=>,
				Error=> );
		IF NOT pPendant^.fbSendHex.Busy THEN
			Stage := Stage +1;
		END_IF
	2: 
		
		HEXSTR_TO_DATA('fe', ADR(aTxHexData), SIZEOF(aTxHexData));
		pPendant^.fbSendHex(
				pSendData:= ADR(aTxHexData),
				Length	:= 1,
				TXbuffer:= TxBufferPendant,
				Busy=>,
				Error=> );
		IF NOT pPendant^.fbSendHex.Busy THEN
			Stage := Stage +1;
		END_IF
	3: 
		
		HEXSTR_TO_DATA('01', ADR(aTxHexData), SIZEOF(aTxHexData));
		pPendant^.fbSendHex(
				pSendData:= ADR(aTxHexData),
				Length	:= 1,
				TXbuffer:= TxBufferPendant,
				Busy=>,
				Error=> );
		IF NOT pPendant^.fbSendHex.Busy THEN
			Stage := Stage +1;
		END_IF
	4: 
		
		HEXSTR_TO_DATA('00', ADR(aTxHexData), SIZEOF(aTxHexData));
		pPendant^.fbSendHex(
				pSendData:= ADR(aTxHexData),
				Length	:= 1,
				TXbuffer:= TxBufferPendant,
				Busy=>,
				Error=> );
		IF NOT pPendant^.fbSendHex.Busy THEN
			Stage := Stage +1;
		END_IF
	5:	
		HEXSTR_TO_DATA('0e', ADR(aTxHexData), SIZEOF(aTxHexData));
		pPendant^.fbSendHex(
				pSendData:= ADR(aTxHexData),
				Length	:= 1,
				TXbuffer:= TxBufferPendant,
				Busy=>,
				Error=> );
		IF NOT pPendant^.fbSendHex.Busy THEN
			Stage := Stage +1;
		END_IF
	6:
		pPendant^.fbSendString(SendString:= 'Pendant ',
					TXbuffer:= TxBufferPendant,
					Busy=>,
					Error=> );
		IF NOT pPendant^.fbSendString.Busy  THEN
			Stage := Stage +1;
		END_IF
	7: 
		tonDelay(IN:=TRUE);
		IF tonDelay.Q THEN
			tonDelay(IN:=FALSE);
			Stage:=Stage +1;
		END_IF
	8:
		pPendant^.fbSendString(SendString:= 'on      ',
					TXbuffer:= TxBufferPendant,
					Busy=>,
					Error=> );
		IF NOT pPendant^.fbSendString.Busy  THEN
			Stage := Stage +1;
		END_IF
	9:
		pPendant^._Ready := TRUE;
		THIS^.ToIdle();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="StateID" Id="{43b739f4-0f2d-4acc-9cf2-0f25c34d9dc3}">
      <Declaration><![CDATA[PROPERTY StateID : STRING]]></Declaration>
      <Get Name="Get" Id="{6cd1f088-4517-4209-9453-e162ee89373b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StateID := 'Init State';]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ToIdle" Id="{5616b8f2-c671-4699-99f0-fe4647fc42b1}">
      <Declaration><![CDATA[METHOD ToIdle : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stage := 0;
pPendant^.SetState(pPendant^.fbPendantIdleState);]]></ST>
      </Implementation>
    </Method>
