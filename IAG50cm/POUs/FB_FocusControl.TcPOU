<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FocusControl" Id="{758e08ff-7d69-4056-9327-dc96b024961b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_FocusControl EXTENDS FB_AxisControl IMPLEMENTS I_Focus
VAR_INPUT
	fMinPosition		: LREAL := 1.0;			// minimum Position
	fMaxPosition		: LREAL := 17.0;		// maximum Position
	fTolerance			: LREAL := 0.005;
END_VAR
VAR
	mqttTimer 			: TON := (PT:=T#5S);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// limit to sane positions
fPosition := LIMIT(fMinPosition, fPosition, fMaxPosition);


IF bEnable AND NOT fbAxis.Calibrated THEN
	THIS^.HomeAxis := TRUE;		// starts _StartHoming on FALSE -> TRUE
END_IF

IF fbAxis.Calibrated THEN
	bHomeAxis := FALSE;
	bCalibrated := fbAxis.Calibrated;
	// the reference for the next homing (#20): there is no reference switch (#22)
	fLastPosition := fActualPosition;
	IF ABS(fPosition - fActualPosition) > fTolerance THEN
			IF fbAxis.Ready AND NOT fbAxis.MoveDone THEN
				// start a move on FALSE -> TRUE (BROTLib #63); bMoveAxis is cleared on MoveDone
				IF NOT bMoveAxis THEN
					fbAxis.MoveTo();
				END_IF
				bMoveAxis := TRUE;
			ELSE
				bMoveAxis := FALSE;
			END_IF;
	END_IF;
END_IF



fbAxis(
	enable 			:= bEnable,
	Reset 			:= bReset,
	HomingMode 		:= MC_ForceCalibration,
	Position 		:= fPosition, 
	Velocity 		:= fVelocity,
	Enable_Positive := TRUE,//NOT axisRef.Status.SoftLimitMaxExceeded,
	Enable_Negative := TRUE,// NOT axisRef.Status.SoftLimitMinExceeded,
	Jog_Forward 	:= bMovePos,
	Jog_Backwards 	:= bMoveNeg,
	isModuloAxis 	:= FALSE,
	ActualPosition 	=> fActualPosition,
	Error 			=> bError,
	ErrorID 		=> nErrorID,
	AxisRef 		:= axisRef);
	
IF fbAxis.MoveDone OR bReset OR bError THEN
	bMoveAxis := FALSE;
END_IF

IF fbAxis.HomeDone OR bReset OR bError THEN
	bHomeAxis := FALSE;
END_IF
	
IF fbAxis.ResetDone THEN
	bReset := FALSE;
END_IF

IF fbAxis.StopDone THEN
	bStopAxis := FALSE;
END_IF


bReady := fbAxis.Ready;

fbreadParameter(	
	Axis 			:= axisRef, 
	Enable 			:= fbAxis.InMotion, 
	ParameterNumber := MC_AxisParameter.AxisRemainingTimeToGo, 
	ReadMode 		:= E_ReadMode.READMODE_CYCLIC);
				
IF fbreadParameter.Valid THEN
	fSlewtime := fbreadParameter.Value;
END_IF

IF bSoEReset THEN
	fbSoEReset(
		Axis 	:= axisRef,
		Execute := TRUE,
		Timeout := DEFAULT_ADS_TIMEOUT);
 	IF NOT fbSoEReset.Busy THEN
		fbSoEReset(Axis := axisRef, Execute := FALSE);
		bSoEReset := FALSE;
		bReset := TRUE;
	END_IF
END_IF

HandleEvents();
]]></ST>
    </Implementation>
    <Method Name="_StartHoming" Id="{b0a48ed9-6cc9-4f17-be6a-c5242c1c697a}">
      <Declaration><![CDATA[// The focus has no reference switch (#22): MC_ForceCalibration declares the current position to be the stored last
// known position (fLastPosition, PERSISTENT in FB_AxisControl, written while calibrated; decision #20). Before the first
// calibration there is none (-1): the target is used, which is telescopeConfig.focusHome after power-on, and a
// warning is logged because that is a guess.
METHOD _StartHoming : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fLastPosition >= 0.0 THEN
	fbAxis.Home(fReference := fLastPosition);
ELSE
	fbAxis.Home(fReference := fPosition);
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG,
		'Focus: no stored position, calibrated to the target %s (a guess, see IAG50cm#20)', LREAL_TO_STRING(fPosition));
END_IF
_StartHoming := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="HandleEvents" Id="{375f50c9-e6ea-4fcd-9fab-a26147b70ce8}">
      <Declaration><![CDATA[METHOD PRIVATE HandleEvents : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[axisEvent(	
	Trigger 		:= fbAxis.Error, 
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString	:= 'Focus Axis Error: %S',
	OnMessage 		:= NCError_TO_STRING(ErrorID),
	OffMEssage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	comm 			:= fbComm);

CalibrationEvent(
	Trigger 		:=	bCalibrated,
	Level 			:=	ADSLOG_MSGTYPE_HINT,
	OnMessage 		:= 'Focus Axis is calibrated.',
	comm 			:= fbComm);
]]></ST>
      </Implementation>
    </Method>
