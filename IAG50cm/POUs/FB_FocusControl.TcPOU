<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FocusControl" Id="{758e08ff-7d69-4056-9327-dc96b024961b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_FocusControl EXTENDS FB_AxisControl IMPLEMENTS I_Focus
VAR_INPUT
	fMinPosition		: LREAL := 1.0;			// minimum Position
	fMaxPosition		: LREAL := 17.0;		// maximum Position
	fTolerance			: LREAL := 0.005;
END_VAR
VAR
	mqttTimer 			: TON := (PT:=T#5S);
	fbFollower			: BROTLib.FB_MoveFollower;	// starts, re-targets and holds the move to fPosition (MONETcommon#122)
	bHoldOnStop			: BOOL;		// Stop() was called: the target becomes the position reached at StopDone
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// limit to sane positions
fPosition := LIMIT(fMinPosition, fPosition, fMaxPosition);


IF bEnable AND NOT fbAxis.Calibrated THEN
	THIS^.HomeAxis := TRUE;		// starts _StartHoming on FALSE -> TRUE
END_IF

// a new target during a move restarts it, MoveDone, abort, error and stop end it (MONETcommon#122); the inputs are
// what fbAxis reported in its last call. The enable comes from the telescope, so bNeedEnable is not used.
fbFollower(
	fTarget		:= fPosition,
	fActual		:= fActualPosition,
	fTolerance	:= fTolerance,
	bActive		:= fbAxis.Calibrated,
	bReady		:= fbAxis.Ready AND NOT fbAxis.MoveDone,
	bMoveDone	:= fbAxis.MoveDone,
	bAborted	:= fbAxis.CommandAborted,
	bError		:= bError,
	bStopDone	:= fbAxis.StopDone);

// Stop(): hold the position reached when the stop is done
IF bHoldOnStop AND (fbAxis.StopDone OR fbAxis.StandStill) THEN
	bHoldOnStop := FALSE;
	IF fbAxis.Calibrated THEN
		fPosition := fActualPosition;
	END_IF
END_IF

// after an error a reset must not resume the old move by itself
IF bError AND fbAxis.Calibrated THEN
	fPosition := fActualPosition;
END_IF

IF fbAxis.Calibrated THEN
	bHomeAxis := FALSE;
	bCalibrated := fbAxis.Calibrated;
	// MoveTo() starts the move, and again when the target changed during the move
	IF fbFollower.bStartMove THEN
		fbAxis.MoveTo();
	END_IF
	bMoveAxis := fbFollower.bMoving;
END_IF



fbAxis(
	enable 			:= bEnable,
	Reset 			:= bReset,
	HomingMode 		:= MC_ForceCalibration,
	Position 		:= fPosition, 
	Velocity 		:= fVelocity,
	Enable_Positive := TRUE,//NOT axisRef.Status.SoftLimitMaxExceeded,
	Enable_Negative := TRUE,// NOT axisRef.Status.SoftLimitMinExceeded,
	Jog_Forward 	:= bMovePos,
	Jog_Backwards 	:= bMoveNeg,
	isModuloAxis 	:= FALSE,
	ActualPosition 	=> fActualPosition,
	Error 			=> bError,
	ErrorID 		=> nErrorID,
	AxisRef 		:= axisRef);
	
IF bReset OR bError THEN
	bMoveAxis := FALSE;
END_IF

IF fbAxis.HomeDone OR bReset OR bError THEN
	bHomeAxis := FALSE;
END_IF
	
IF fbAxis.ResetDone THEN
	bReset := FALSE;
END_IF

IF fbAxis.StopDone THEN
	bStopAxis := FALSE;
END_IF


bReady := fbAxis.Ready;

fbreadParameter(	
	Axis 			:= axisRef, 
	Enable 			:= fbAxis.InMotion, 
	ParameterNumber := MC_AxisParameter.AxisRemainingTimeToGo, 
	ReadMode 		:= E_ReadMode.READMODE_CYCLIC);
				
IF fbreadParameter.Valid THEN
	fSlewtime := fbreadParameter.Value;
END_IF

IF bSoEReset THEN
	fbSoEReset(
		Axis 	:= axisRef,
		Execute := TRUE,
		Timeout := DEFAULT_ADS_TIMEOUT);
 	IF NOT fbSoEReset.Busy THEN
		fbSoEReset(Axis := axisRef, Execute := FALSE);
		bSoEReset := FALSE;
		bReset := TRUE;
	END_IF
END_IF

HandleEvents();
]]></ST>
    </Implementation>
    <Method Name="_StartHoming" Id="{b0a48ed9-6cc9-4f17-be6a-c5242c1c697a}">
      <Declaration><![CDATA[// The focus has no reference switch (#22) and needs none: its encoder is absolute (the NC axis has
// ReferenceSystem ABSOLUTE and an Offset in the tsproj, the drive reports a multi-turn position), so the position
// survives an activation (test T16, 2026-10-13). Homing only sets the calibrated flag: MC_ForceCalibration ignores
// the reference position it is given and never changes the axis position. The zero point of the focus is the NC
// encoder Offset in the tsproj, not anything in the PLC. The stored position of #20 (fLastPosition) was passed
// here but never applied; #44.
METHOD _StartHoming : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbAxis.Home(fReference := fActualPosition);		// ignored by MC_ForceCalibration
_StartHoming := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{98d93a6c-4403-4356-bbdb-b56033b51151}">
      <Declaration><![CDATA[// Stop a running focus move (MC_Stop) and hold the position reached: the target becomes the actual position at
// StopDone, so the automatic positioning does not restart the move. A new Position afterwards moves again.
// Returns TRUE when an MC_Stop was requested. MONETcommon#122.
METHOD Stop : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbFollower.Stop();
fbAxis.CancelMove();
IF fbAxis.Ready AND NOT fbAxis.StandStill THEN
	Stop := fbAxis.Stop();
	bHoldOnStop := TRUE;
ELSIF fbAxis.Calibrated THEN
	fPosition := fActualPosition;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="MinPosition" Id="{a790c09f-bba1-4982-bf5e-4717bf5dcf3c}">
      <Declaration><![CDATA[PROPERTY PUBLIC MinPosition : LREAL]]></Declaration>
      <Get Name="Get" Id="{80125d84-4e21-4ed8-90ce-1bee30ba5628}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MinPosition := fMinPosition;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MaxPosition" Id="{b7ca1d71-8a33-4200-a4eb-b6f18035b9ea}">
      <Declaration><![CDATA[PROPERTY PUBLIC MaxPosition : LREAL]]></Declaration>
      <Get Name="Get" Id="{a3a5dd9b-f8be-48ed-b6a6-23a99c594e54}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MaxPosition := fMaxPosition;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="HandleEvents" Id="{375f50c9-e6ea-4fcd-9fab-a26147b70ce8}">
      <Declaration><![CDATA[METHOD PRIVATE HandleEvents : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[axisEvent(	
	Trigger 		:= fbAxis.Error, 
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString	:= 'Focus Axis Error: %S',
	OnMessage 		:= NCError_TO_STRING(ErrorID),
	OffMEssage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	comm 			:= fbComm);

CalibrationEvent(
	Trigger 		:=	bCalibrated,
	Level 			:=	ADSLOG_MSGTYPE_HINT,
	OnMessage 		:= 'Focus Axis is calibrated.',
	comm 			:= fbComm);
]]></ST>
      </Implementation>
    </Method>
