<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_MirrorCoverControl" Id="{0e8290b7-d995-422f-a963-5aa8fa3bd4c0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PUBLIC FB_MirrorCoverControl IMPLEMENTS I_MirrorCovers
VAR_INPUT
	delta_t		: TIME := T#5s;	// Time difference between both covers opening (and closing)
END_VAR
VAR_OUTPUT
END_VAR
VAR
	bEmergency				: BOOL := FALSE; // TRUE when Safty is triggered
	// commands for automatic MirrorCover controls
	bOpenCover				: BOOL;
	bCloseCover				: BOOL;
	bStopCover				: BOOL;
	bResetCover				: BOOL;
	//state handeling
	coverState				: E_MirrorCoverState := E_MirrorCoverState.closed;	// State of the Cover, initialize it with closed (Assumption)
	newState				: E_MirrorCoverState;								// State which gets compared to the state one cyle ago to detect change
	endStateTimer			: TON := (PT:=T#15S+delta_t);						// Timer for 'closed' and 'open' state (due to no limit switches) one motor needs 15s
	// Comm
	fbComm					: I_Comm;
	mqttTimer 				: TON := (PT:=T#5S);
	// CoverMotors
	coverMotors				: ARRAY[1..2] OF FB_MirrorCoverMotor();	// Function  blocks for both motors
	// Delta_t timer
	deltaTimer				: Ton := (PT:=delta_t);
	// Bool wether a move command just got started or if the movement is ungoing 
	bInitialCommand			: BOOL := TRUE;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// update cover motors
coverMotors[1]();
coverMotors[2]();
// update timers
deltaTimer();
endStateTimer();
// safty triggered? -> STOP
IF bEmergency THEN
	bStopCover := TRUE;
END_IF

IF bResetCover AND NOT bEmergency THEN
	// if reset (and safty is not triggered still): remove stop commands and close covers
	coverMotors[1].Reset();
	coverMotors[2].Reset();
	// close the cover in the next cycle
	bStopCover := FALSE;
	bResetCover := FALSE;
	bCloseCover := TRUE;
	bOpenCover := FALSE;

ELSIF bStopCover THEN
	// if stop: stop
	coverMotors[1].Stop();
	coverMotors[2].Stop();
	bCloseCover := FALSE;
	bOpenCover := FALSE;

ELSIF bCloseCover THEN
	// close the covers
	// close has precedence over open -> Eg. for bad weather
	bOpenCover := FALSE;
	// First: initiate close of motor 2
	coverMotors[2].Close();
	// Then: Soft stop motor 1 which has to wait so its not moving
	IF bInitialCommand THEN
		coverMotors[1].SoftStop();
		// reset (if opening is interuped) and start delay timer in next cycle
		IF deltaTimer.IN THEN
			deltaTimer.IN := FALSE;
		ELSE
			deltaTimer.IN := TRUE;
			// remove initial command tag
			bInitialCommand := FALSE;
		END_IF
		
	ELSE
		// when the timer finishes -> set second Motor to closing
		IF deltaTimer.Q THEN
			deltaTimer.IN := FALSE;
			coverMotors[1].Close();
			// remove tags:
			bCloseCover := FALSE;
			bInitialCommand := TRUE;
		END_IF
	END_IF
	
ELSIF bOpenCover THEN
	// open the covers
	// First:  initiate close of motor 1
	coverMotors[1].Open();
	// Then: Soft stop motor 2 which has to wait so its not moving
	IF bInitialCommand THEN
		coverMotors[2].SoftStop();
		// reset then start delay timer
		IF deltaTimer.IN THEN
			deltaTimer.IN := FALSE;
		ELSE
			deltaTimer.IN := TRUE;
			// remove initial command tag
			bInitialCommand := FALSE;
		END_IF
	ELSE
		// when the timer finishes -> set second Motor to opening
		IF deltaTimer.Q THEN
			deltaTimer.IN := FALSE;
			coverMotors[2].Open();
			// remove tags
			bOpenCover := FALSE;
			bInitialCommand := TRUE;
		END_IF
	END_IF
END_IF



// check states and set states
// if both have the same state -> state
// if only one is moving and the other not -> the moving state is the state (this is the time where only one starts moving)

IF coverMotors[1].motor_state = coverMotors[2].motor_state THEN
	newState := coverMotors[1].motor_state;
ELSIF coverMotors[1].motor_state = E_MirrorCoverState.closing OR coverMotors[1].motor_state = E_MirrorCoverState.opening THEN
	newState := coverMotors[1].motor_state;
ELSIF coverMotors[2].motor_state = E_MirrorCoverState.closing OR coverMotors[2].motor_state = E_MirrorCoverState.opening THEN
	newState := coverMotors[2].motor_state;
END_IF

// check the new state against the old state
// if closing/opening goes on for long enough -> closed/open position is assumed to be reached
IF coverState <> newState THEN
	// opening and closing on open and closed doesn't change a thing
	IF coverState = E_MirrorCoverState.closed AND newState = E_MirrorCoverState.closing THEN
		coverState := E_MirrorCoverState.closed;
	ELSIF coverState = E_MirrorCoverState.open AND newState = E_MirrorCoverState.opening THEN
		coverState := E_MirrorCoverState.open;
	// stopped motors
	ELSIF newState = E_MirrorCoverState.stopped THEN
		coverState := newState;
		//reset timer
		endStateTimer.IN := FALSE;
	// initialize Timer till open/closed
	ELSE
		// allready running? -> reset it
		IF endStateTimer.IN THEN
			// reset for next cycle
			endStateTimer.IN := FALSE;
		// start it and set new state
		ELSE
			endStateTimer.IN := TRUE;
			// 
			coverState := newState;
		END_IF
	END_IF
ELSE
	IF endStateTimer.Q THEN
		// reset timer
		endStateTimer.IN := FALSE;
		IF coverState = E_MirrorCoverState.closing THEN
			coverState := E_MirrorCoverState.closed;
		ELSE
			coverState := E_MirrorCoverState.open;
		END_IF
	END_IF
END_IF

SendTelemetry();]]></ST>
    </Implementation>
    <Method Name="Close" Id="{b50cbd73-4616-4660-bdf7-e64554deaa74}">
      <Declaration><![CDATA[METHOD Close : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT (coverState = E_MirrorCoverState.closing OR coverState = E_MirrorCoverState.closed) THEN
	bCloseCover := TRUE;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Property Name="Closed" Id="{329de8e9-115e-47ef-b5b6-c07458be08d4}">
      <Declaration><![CDATA[PROPERTY Closed : BOOL]]></Declaration>
      <Get Name="Get" Id="{b7f9e7c0-3b09-4318-8e41-8eb592a97a59}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF coverState = E_MirrorCoverState.closed THEN
	Closed := TRUE;	
ELSE
	Closed := FALSE;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Error" Id="{a40ee296-83f9-40b0-85c4-f6ab4fae22f5}">
      <Declaration><![CDATA[PROPERTY Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{040380c5-7ada-4b52-a4dc-f0d695f4d3a2}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := FALSE;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Init" Id="{340c7945-d394-455f-9061-0330b21fd120}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains	: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode		: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	comm			: I_Comm;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.fbComm := comm;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Open" Id="{0fe80793-0710-437e-81f7-4ad62db0ec24}">
      <Declaration><![CDATA[METHOD Open : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT (coverState = E_MirrorCoverState.opening OR coverState = E_MirrorCoverState.open) THEN
	bOpenCover := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Opened" Id="{f24f058d-eb52-4225-a2a2-c80fdac08111}">
      <Declaration><![CDATA[PROPERTY Opened : Bool]]></Declaration>
      <Get Name="Get" Id="{13ac801e-b34c-4929-858f-3270c582b765}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF coverState = E_MirrorCoverState.open THEN
	Opened := TRUE;	
ELSE
	Opened := FALSE;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{370a496f-18d5-4d7d-8d76-c088c8d5b24c}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bResetCover := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendTelemetry" Id="{89efe1b2-65b8-4d29-95f8-967546e06fb1}">
      <Declaration><![CDATA[METHOD PRIVATE SendTelemetry : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[mqttTimer(IN:=TRUE);
IF mqttTimer.Q THEN // publish new payload every second
	mqttTimer(IN:=FALSE);
	fbComm.Publish('telescope', 'dome', 'MirrorCover', TO_STRING(coverState));
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{69a6cd3b-e699-468e-986e-e43f61a4875e}">
      <Declaration><![CDATA[METHOD Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bStopCover := TRUE;]]></ST>
      </Implementation>
    </Method>
